{% comment %}
=============================================================
  Infinite Visibility — JSON-LD Schema Snippet
  File: snippets/jsonld-schema.liquid
  Updated: May 2026
  Free worldwide shipping — no minimum — no expiry set.
  %s is NOT used anywhere — broken on Shopify servers.
  All dates use %Y-%m-%d or hardcoded ISO strings.
=============================================================
{% endcomment %}
{%- liquid
  assign shop_url     = 'https://infinitevisibility7.com'
  assign shop_name    = 'Infinite Visibility'
  assign shop_email   = 'infinitevisibility07@gmail.com'
  assign shop_lat     = '27.8306'
  assign shop_lng     = '-82.3232'
  assign logo_url     = settings.logo | image_url: width: 400
  assign default_img  = settings.share_image | image_url: width: 1200
  assign price_valid_year = 'now' | date: '%Y' | plus: 1
  assign price_valid_until = price_valid_year | append: '-12-31'
-%}
{%- comment %} ── 1. ORGANIZATION (sitewide) ── {% endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "{{ shop_url }}/#organization",
  "name": "{{ shop_name }}",
  "url": "{{ shop_url }}",
  "foundingDate": "2022",
  "founder": {
    "@type": "Person",
    "name": "Infinite Visibility Team",
    "jobTitle": "Founder",
    "worksFor": {
      "@id": "{{ shop_url }}/#organization"
    }
  },
  "logo": {
    "@type": "ImageObject",
    "url": "https:{{ logo_url }}",
    "width": 400,
    "height": 120
  },
  "description": "Premium anime merchandise and streetwear fashion including vintage-washed oversized t-shirts, heavyweight hoodies, and collectible action figures for fans of One Piece, Naruto, Demon Slayer, Solo Leveling, and Jujutsu Kaisen. Free worldwide shipping on all orders.",
  "email": "{{ shop_email }}",
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "email": "infinitevisibility07@gmail.com",
      "contactType": "customer service",
      "availableLanguage": "English"
    }
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "9930 Jonas Salk Drive",
    "addressLocality": "Riverview",
    "addressRegion": "FL",
    "postalCode": "33578",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "{{ shop_lat }}",
    "longitude": "{{ shop_lng }}"
  },
  "sameAs": [
    "https://www.facebook.com/infinitevisibility7",
    "https://www.instagram.com/infinitevisibility07",
    "https://www.pinterest.com/infinitevisibility",
    "https://www.youtube.com/@infinitevisibility07",
    "https://x.com/infinitevisi",
    "{{ shop_url }}/pages/llms"
  ]
}
</script>
{%- comment %} ── 2. WEBSITE + SITELINKS SEARCHBOX (sitewide) ── {% endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "{{ shop_url }}/#website",
  "url": "{{ shop_url }}",
  "name": "{{ shop_name }}",
  "description": "The ultimate Online Anime Shop for premium streetwear, figures, phone cases, and home decor. Free worldwide shipping on all orders — no minimum required.",
  "publisher": {
    "@id": "{{ shop_url }}/#organization"
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ shop_url }}/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>
{%- comment %} ── 3. BREADCRUMB (sitewide, not on homepage) ── {% endcomment -%}
{%- if template != 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ shop_url }}"
    }
    {%- if template contains 'collection' and collection -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": "{{ collection.title | escape }}",
      "item": "{{ shop_url }}/collections/{{ collection.handle }}"
    }
    {%- endif -%}
    {%- if template contains 'product' and product -%}
      {%- if collection -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": "{{ collection.title | escape }}",
      "item": "{{ shop_url }}/collections/{{ collection.handle }}"
    }
    ,{
      "@type": "ListItem",
      "position": 3,
      "name": "{{ product.title | escape }}",
      "item": "{{ shop_url }}/products/{{ product.handle }}"
    }
      {%- else -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": "{{ product.title | escape }}",
      "item": "{{ shop_url }}/products/{{ product.handle }}"
    }
      {%- endif -%}
    {%- endif -%}
    {%- if template contains 'article' and article -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": "{{ blog.title | escape }}",
      "item": "{{ shop_url }}/blogs/{{ blog.handle }}"
    }
    ,{
      "@type": "ListItem",
      "position": 3,
      "name": "{{ article.title | escape }}",
      "item": "{{ shop_url }}/blogs/{{ blog.handle }}/{{ article.handle }}"
    }
    {%- endif -%}
    {%- if template contains 'page' and page -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": "{{ page.title | escape }}",
      "item": "{{ shop_url }}/pages/{{ page.handle }}"
    }
    {%- endif -%}
  ]
}
</script>
{%- endif -%}
{%- comment %} ── 4. PRODUCT PAGE SCHEMA ── {% endcomment -%}
{%- if template contains 'product' and product -%}
{%- assign product_url   = shop_url | append: '/products/' | append: product.handle -%}
{%- assign first_variant = product.selected_or_first_available_variant -%}
{%- assign jm_rating     = product.metafields.judgeme.avg_rating | default: '' -%}
{%- assign jm_count      = product.metafields.judgeme.review_count | default: '' -%}
{%- assign native_rating = product.metafields.reviews.rating.value | default: '' -%}
{%- assign native_count  = product.metafields.reviews.rating_count.value | default: '' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "{{ product_url }}",
  "name": "{{ product.title | escape }}",
  "url": "{{ product_url }}",
  "description": "{{ product.description | strip_html | truncatewords: 80 | escape }}",
  "image": [
    {%- for image in product.images limit: 5 -%}
      "https:{{ image | image_url: width: 1200 }}"
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "brand": {
    "@type": "Brand",
    "name": "Infinite Visibility"
  },
  "sku": "{{ first_variant.sku | escape }}"
  {%- if product.metafields.global.barcode != blank -%}
  ,"gtin": "{{ product.metafields.global.barcode }}"
  {%- elsif first_variant.barcode != blank -%}
  ,"gtin": "{{ first_variant.barcode }}"
  {%- endif -%}
  ,"offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      "url": "{{ product_url }}?variant={{ variant.id }}",
      "priceCurrency": "{{ cart.currency.iso_code }}",
      "price": "{{ variant.price | money_without_currency | remove: ',' }}",
      "priceValidUntil": "{{ price_valid_until }}",
      "itemCondition": "https://schema.org/NewCondition",
      "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
      "seller": {
        "@type": "Organization",
        "name": "Infinite Visibility"
      },
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": {
          "@type": "MonetaryAmount",
          "value": "0",
          "currency": "USD"
        },
        "shippingDestination": [
          { "@type": "DefinedRegion", "addressCountry": "US" },
          { "@type": "DefinedRegion", "addressCountry": "CA" },
          { "@type": "DefinedRegion", "addressCountry": "GB" },
          { "@type": "DefinedRegion", "addressCountry": "AU" },
          { "@type": "DefinedRegion", "addressCountry": "DE" },
          { "@type": "DefinedRegion", "addressCountry": "FR" },
          { "@type": "DefinedRegion", "addressCountry": "JP" },
          { "@type": "DefinedRegion", "addressCountry": "MX" },
          { "@type": "DefinedRegion", "addressCountry": "BR" },
          { "@type": "DefinedRegion", "addressCountry": "NL" },
          { "@type": "DefinedRegion", "addressCountry": "SE" },
          { "@type": "DefinedRegion", "addressCountry": "SG" },
          { "@type": "DefinedRegion", "addressCountry": "NZ" },
          { "@type": "DefinedRegion", "addressCountry": "PH" }
        ],
        "doesNotShip": false,
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": {
            "@type": "QuantitativeValue",
            "minValue": 1,
            "maxValue": 3,
            "unitCode": "DAY"
          },
          "transitTime": {
            "@type": "QuantitativeValue",
            "minValue": 5,
            "maxValue": 14,
            "unitCode": "DAY"
          }
        }
      },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "US",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 15,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/FreeReturn"
      }
      {%- unless variant.title == 'Default Title' -%}
      ,"name": "{{ variant.title | escape }}"
      {%- endunless -%}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
  {%- if jm_rating != '' and jm_count != '' -%}
  ,"aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ jm_rating }}",
    "reviewCount": "{{ jm_count }}",
    "bestRating": "5",
    "worstRating": "1"
  }
  {%- elsif native_rating != '' and native_count != '' -%}
  ,"aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ native_rating }}",
    "reviewCount": "{{ native_count }}",
    "bestRating": "5",
    "worstRating": "1"
  }
  {%- endif -%}
}
</script>
{%- endif -%}
{%- comment %} ── 5. COLLECTION PAGE SCHEMAS ── {% endcomment -%}
