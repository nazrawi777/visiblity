{%- style -%}
  .iv-home-seo { padding: 60px 20px; background: #ffffff; }
  .iv-home-seo__inner { max-width: 1200px; margin: 0 auto; }
  .iv-home-seo__heading-wrap { text-align: center; margin: 0 0 40px 0; }
  .iv-home-seo__h1 {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 900;
    color: #0a0e2e;
    margin: 0 0 16px 0;
    line-height: 1.2;
  }
  .iv-home-seo__h1 span { color: #31378F; }
  .iv-home-seo__badge {
    display: inline-block;
    background: #31378F;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 3px;
    margin: 0 0 16px 0;
  }
  .iv-home-seo__intro {
    font-size: 16px;
    line-height: 1.8;
    color: #444;
    max-width: 820px;
    margin: 0 auto 40px auto;
    text-align: center;
  }
  .iv-home-seo__trending {
    background: linear-gradient(135deg, #0a0e2e, #1a1f5e);
    border-radius: 8px;
    padding: 20px 24px;
    margin: 0 0 30px 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .iv-home-seo__trending-label {
    color: #ffc72f;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }
  .iv-home-seo__trending-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .iv-home-seo__trending-links li a {
    display: inline-block;
    padding: 5px 12px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,199,47,0.4);
    border-radius: 3px;
    color: rgba(255,255,255,0.85);
    font-size: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .iv-home-seo__trending-links li a:hover {
    background: #ffc72f;
    border-color: #ffc72f;
    color: #1a1a1a;
  }
  .iv-home-seo__collections {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin: 0 0 30px 0;
  }
  .iv-home-seo__col-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
    background: linear-gradient(135deg, #0a0e2e, #1a1f5e);
    border-radius: 8px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border: 1px solid rgba(49,55,143,0.3);
  }
  .iv-home-seo__col-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(49,55,143,0.3);
  }
  .iv-home-seo__col-icon { font-size: 28px; margin: 0 0 10px 0; }
  .iv-home-seo__col-name {
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    text-align: center;
    margin: 0 0 6px 0;
  }
  .iv-home-seo__col-sub {
    color: rgba(255,255,255,0.5);
    font-size: 11px;
    text-align: center;
    margin: 0;
  }
  .iv-home-seo__sale {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    background: linear-gradient(135deg, #31378F, #1a1f5e);
    border-radius: 8px;
    padding: 28px 32px;
    text-decoration: none;
    transition: all 0.2s ease;
    flex-wrap: wrap;
    margin: 0 0 30px 0;
  }
  .iv-home-seo__sale:hover { background: linear-gradient(135deg, #252c7a, #0a0e2e); }
  .iv-home-seo__sale-left { display: flex; align-items: center; gap: 16px; }
  .iv-home-seo__sale-icon { font-size: 40px; }
  .iv-home-seo__sale-title { color: #ffc72f; font-size: 20px; font-weight: 900; margin: 0 0 4px 0; }
  .iv-home-seo__sale-sub { color: rgba(255,255,255,0.7); font-size: 14px; margin: 0; }
  .iv-home-seo__sale-btn {
    display: inline-block;
    padding: 12px 28px;
    background: #ffc72f;
    color: #1a1a1a;
    font-weight: 700;
    font-size: 14px;
    border-radius: 4px;
    white-space: nowrap;
    transition: background 0.2s ease;
  }
  .iv-home-seo__sale:hover .iv-home-seo__sale-btn { background: #ffffff; }
  .iv-home-seo__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    margin: 0 0 30px 0;
    padding: 28px;
    background: #f8f9ff;
    border-radius: 8px;
    border: 1px solid #e8eaff;
  }
  .iv-home-seo__trust-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: #333;
    flex: 1;
    min-width: 160px;
  }
  .iv-home-seo__trust-icon { font-size: 24px; flex-shrink: 0; }
  .iv-home-seo__trust-title { font-weight: 700; color: #0a0e2e; font-size: 13px; margin: 0 0 2px 0; }
  .iv-home-seo__trust-sub { color: #666; font-size: 12px; margin: 0; }
  .iv-home-seo__about {
    margin: 0;
    padding: 40px;
    background: linear-gradient(135deg, #0a0e2e, #1a1f5e);
    border-radius: 8px;
    text-align: center;
  }
  .iv-home-seo__about-title {
    color: #ffc72f;
    font-size: 22px;
    font-weight: 800;
    margin: 0 0 16px 0;
  }
  .iv-home-seo__about-text {
    color: rgba(255,255,255,0.8);
    font-size: 15px;
    line-height: 1.8;
    max-width: 760px;
    margin: 0 auto 20px auto;
  }
  .iv-home-seo__about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }
  .iv-home-seo__about-link {
    display: inline-block;
    padding: 8px 18px;
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 4px;
    color: rgba(255,255,255,0.8);
    font-size: 13px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .iv-home-seo__about-link:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.6);
    color: #ffffff;
  }
  @media (max-width: 768px) {
    .iv-home-seo { padding: 40px 16px; }
    .iv-home-seo__sale { padding: 20px; }
    .iv-home-seo__sale-left { flex-wrap: wrap; }
    .iv-home-seo__about { padding: 24px 16px; }
    .iv-home-seo__trust-item { min-width: 130px; }
    .iv-home-seo__trending { flex-direction: column; align-items: flex-start; }
  }
{%- endstyle -%}

