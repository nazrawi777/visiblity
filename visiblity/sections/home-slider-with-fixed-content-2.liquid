  #shopify-section-{{ section.id }}.home-slider-with-fixed-content .dt-sc-swiper-slider.swiper-container .swiper-arrows .swiper-button-next:hover:before,
  #shopify-section-{{ section.id }}.home-slider-with-fixed-content .dt-sc-swiper-slider.swiper-container .swiper-arrows .swiper-button-prev:hover:before{background:{{ section.settings.navigation_button_hover_color }}; }

  #shopify-section-{{ section.id }}.home-slider-with-fixed-content .dt-sc-swiper-slider.swiper-container .swiper-arrows .dt-sc-btn { background: var(--DT_Button_BG_Color); background: {{ section.settings.navigation_button_color }}; }
  #shopify-section-{{ section.id }}.home-slider-with-fixed-content .dt-sc-swiper-slider.swiper-container .swiper-arrows .dt-sc-btn[class*="swiper-button-"]:after { color: var(--DT_Button_Text_Color);
