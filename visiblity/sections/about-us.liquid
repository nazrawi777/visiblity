{%- style -%}

  /* ── BASE ── */
  .iv-about { font-family: inherit; background: #ffffff; }

  /* ── HERO ── */
  .iv-about-hero {
    background: linear-gradient(135deg, #0a0e2e 0%, #1a1f5e 60%, #31378F 100%);
    padding: 70px 20px 60px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .iv-about-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
  .iv-about-hero__inner { position: relative; max-width: 700px; margin: 0 auto; }
  .iv-about-hero__badge {
    display: inline-block;
    background: rgba(255,199,47,0.15);
    border: 1px solid rgba(255,199,47,0.4);
    color: #ffc72f;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 3px;
    margin: 0 0 18px 0;
  }
  .iv-about-hero__title {
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 900;
    color: #ffffff;
    margin: 0 0 16px 0;
    line-height: 1.15;
  }
  .iv-about-hero__title span { color: #ffc72f; }
  .iv-about-hero__sub {
    font-size: 16px;
    color: rgba(255,255,255,0.75);
    line-height: 1.7;
    margin: 0 0 28px 0;
  }
  .iv-about-hero__ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .iv-about-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 28px;
    font-size: 14px;
    font-weight: 700;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .iv-about-hero__cta--primary { background: #ffc72f; color: #1a1a1a; }
  .iv-about-hero__cta--primary:hover { background: #ffffff; }
  .iv-about-hero__cta--secondary { background: rgba(255,255,255,0.1); color: #ffffff; border: 1px solid rgba(255,255,255,0.3); }
  .iv-about-hero__cta--secondary:hover { background: rgba(255,255,255,0.2); }

  /* ── STATS BAR ── */
  .iv-about-stats {
    background: #ffc72f;
    padding: 20px;
  }
  .iv-about-stats__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0;
  }
  .iv-about-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px 32px;
    border-right: 1px solid rgba(0,0,0,0.1);
  }
  .iv-about-stat:last-child { border-right: none; }
  .iv-about-stat__num { font-size: 26px; font-weight: 900; color: #0a0e2e; line-height: 1; }
  .iv-about-stat__label { font-size: 11px; font-weight: 700; color: rgba(0,0,0,0.6); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 4px; }

  /* ── TABS ── */
  .iv-about-tabs {
    display: flex;
    border-bottom: 2px solid #e8eaff;
    background: #ffffff;
    position: sticky;
    top: 0;
    z-index: 10;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    overflow-x: auto;
  }
  .iv-about-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 16px 22px;
    font-size: 14px;
    font-weight: 700;
    color: #888;
    cursor: pointer;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    transition: all 0.2s ease;
    white-space: nowrap;
    background: none;
    border-top: none;
    border-left: none;
    border-right: none;
  }
  .iv-about-tab:hover { color: #ffc72f; }
  .iv-about-tab.active { color: #ffc72f; border-bottom-color: #ffc72f; }
  .iv-about-tab__icon { font-size: 16px; }

  /* ── PANELS ── */
  .iv-about-panels { max-width: 1200px; margin: 0 auto; padding: 48px 20px; }
  .iv-about-panel { display: none; }
  .iv-about-panel.active { display: block; }

  /* ── SECTION TITLE ── */
  .iv-about-section-title {
    font-size: 13px;
    font-weight: 700;
    color: #31378F;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 8px 0;
  }
  .iv-about-h2 {
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 900;
    color: #0a0e2e;
    margin: 0 0 16px 0;
    line-height: 1.2;
  }
  .iv-about-h2 span { color: #31378F; }
  .iv-about-body {
    font-size: 15px;
    line-height: 1.8;
    color: #444;
    max-width: 720px;
    margin: 0 0 32px 0;
  }

  /* ── STORY PANEL ── */
  .iv-about-story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    margin: 0 0 48px 0;
  }
  .iv-about-story-img {
    background: linear-gradient(135deg, #0a0e2e, #31378F);
    border-radius: 12px;
    aspect-ratio: 4/3;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 80px;
    position: relative;
    overflow: hidden;
  }
  .iv-about-story-img__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.6));
    padding: 20px;
  }
  .iv-about-story-img__caption {
    color: #ffc72f;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* ── MISSION CARDS ── */
  .iv-about-mission {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin: 0 0 48px 0;
  }
  .iv-about-mission__card {
    background: linear-gradient(135deg, #0a0e2e, #1a1f5e);
    border-radius: 10px;
    padding: 28px 24px;
    border: 1px solid rgba(49,55,143,0.3);
  }
  .iv-about-mission__icon { font-size: 32px; margin: 0 0 14px 0; display: block; }
  .iv-about-mission__title { color: #ffc72f; font-size: 15px; font-weight: 800; margin: 0 0 8px 0; }
  .iv-about-mission__text { color: rgba(255,255,255,0.7); font-size: 13px; line-height: 1.6; margin: 0; }

  /* ── VALUES PANEL ── */
  .iv-about-values {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin: 0 0 48px 0;
  }
  .iv-about-value {
    display: flex;
    gap: 16px;
    padding: 24px;
    background: #f8f9ff;
    border: 1px solid #e8eaff;
    border-radius: 10px;
    transition: all 0.2s ease;
  }
  .iv-about-value:hover { border-color: #31378F; background: #ffffff; box-shadow: 0 4px 20px rgba(49,55,143,0.1); }
  .iv-about-value__icon {
    font-size: 32px;
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    background: linear-gradient(135deg, #0a0e2e, #31378F);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .iv-about-value__title { font-size: 15px; font-weight: 800; color: #0a0e2e; margin: 0 0 6px 0; }
  .iv-about-value__text { font-size: 13px; color: #666; line-height: 1.6; margin: 0; }

  /* ── PRODUCTS PANEL ── */
  .iv-about-cats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin: 0 0 40px 0;
  }
  .iv-about-cat {
    display: flex;
    flex-direction: column;
    background: linear-gradient(135deg, #0a0e2e, #1a1f5e);
    border-radius: 10px;
    padding: 28px 24px;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 1px solid rgba(49,55,143,0.3);
  }
  .iv-about-cat:hover { transform: translateY(-4px); box-shadow: 0 8px 28px rgba(49,55,143,0.3); }
  .iv-about-cat__icon { font-size: 36px; margin: 0 0 14px 0; }
  .iv-about-cat__name { color: #ffffff; font-size: 16px; font-weight: 800; margin: 0 0 6px 0; }
  .iv-about-cat__sub { color: rgba(255,255,255,0.6); font-size: 13px; margin: 0 0 16px 0; line-height: 1.5; flex: 1; }
  .iv-about-cat__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: #ffc72f;
    color: #1a1a1a;
    font-size: 12px;
    font-weight: 700;
    border-radius: 4px;
    align-self: flex-start;
    transition: all 0.2s ease;
  }
  .iv-about-cat:hover .iv-about-cat__link { background: #ffffff; }

  /* ── SERIES GRID ── */
  .iv-about-series-title {
    font-size: 16px;
    font-weight: 800;
    color: #0a0e2e;
    margin: 0 0 16px 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .iv-about-series-title::after { content: ''; flex: 1; height: 1px; background: #e8eaff; }
  .iv-about-series {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 40px 0;
  }
  .iv-about-series__tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: #f8f9ff;
    border: 1px solid #e8eaff;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    color: #0a0e2e;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .iv-about-series__tag:hover { background: #31378F; color: #ffffff; border-color: #31378F; }

  /* ── TRUST PANEL ── */
  .iv-about-trust {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin: 0 0 40px 0;
  }
  .iv-about-trust__card {
    display: flex;
    gap: 16px;
    padding: 22px;
    background: #ffffff;
    border: 1px solid #e8eaff;
    border-radius: 10px;
  }
  .iv-about-trust__icon {
    font-size: 28px;
    flex-shrink: 0;
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, #ffc72f, #e6b000);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .iv-about-trust__title { font-size: 14px; font-weight: 800; color: #0a0e2e; margin: 0 0 4px 0; }
  .iv-about-trust__text { font-size: 13px; color: #666; line-height: 1.5; margin: 0; }

  /* ── CONTACT CTA ── */
  .iv-about-contact {
    background: linear-gradient(135deg, #0a0e2e, #1a1f5e);
    border-radius: 12px;
    padding: 40px;
    text-align: center;
    margin: 0 0 40px 0;
  }
  .iv-about-contact__title { color: #ffc72f; font-size: 22px; font-weight: 900; margin: 0 0 12px 0; }
  .iv-about-contact__sub { color: rgba(255,255,255,0.7); font-size: 15px; margin: 0 0 24px 0; line-height: 1.6; max-width: 500px; margin-left: auto; margin-right: auto; }
  .iv-about-contact__links { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .iv-about-contact__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 700;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .iv-about-contact__link--primary { background: #ffc72f; color: #1a1a1a; }
  .iv-about-contact__link--primary:hover { background: #ffffff; }
  .iv-about-contact__link--secondary { background: rgba(255,255,255,0.1); color: #ffffff; border: 1px solid rgba(255,255,255,0.25); }
  .iv-about-contact__link--secondary:hover { background: rgba(255,255,255,0.2); }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .iv-about-hero { padding: 48px 16px 40px; }
    .iv-about-story-grid { grid-template-columns: 1fr; gap: 24px; }
    .iv-about-panels { padding: 32px 16px; }
    .iv-about-stat { padding: 10px 18px; }
    .iv-about-stat__num { font-size: 22px; }
    .iv-about-contact { padding: 28px 20px; }
  }
  @media (max-width: 480px) {
    .iv-about-stats__inner { gap: 0; }
    .iv-about-stat { border-right: none; border-bottom: 1px solid rgba(0,0,0,0.1); width: 50%; }
    .iv-about-stat:nth-child(even) { border-right: none; }
  }

{%- endstyle -%}

<div class="iv-about">

  {%- comment -%} ── HERO ── {%- endcomment -%}
  <div class="iv-about-hero">
    <div class="iv-about-hero__inner">
      <div class="iv-about-hero__badge">⭐ US Based — Riverview, Florida</div>
      <h1 class="iv-about-hero__title">About <span>Infinite Visibility</span></h1>
      <p class="iv-about-hero__sub">Your ultimate US-based anime lifestyle destination. Premium streetwear, museum-grade figures, and exclusive digital downloads — curated for fans who refuse to settle for basic gear.</p>
      <div class="iv-about-hero__ctas">
        <a href="/collections/all-products" class="iv-about-hero__cta iv-about-hero__cta--primary">⚔️ Shop Now</a>
        <a href="/pages/contact-infinite-visibility-customer-support-florida-hq" class="iv-about-hero__cta iv-about-hero__cta--secondary">📩 Contact Us</a>
      </div>
    </div>
  </div>

  {%- comment -%} ── STATS BAR ── {%- endcomment -%}
  <div class="iv-about-stats">
    <div class="iv-about-stats__inner">
      <div class="iv-about-stat">
        <span class="iv-about-stat__num">500+</span>
        <span class="iv-about-stat__label">Products</span>
      </div>
      <div class="iv-about-stat">
        <span class="iv-about-stat__num">10+</span>
        <span class="iv-about-stat__label">Anime Series</span>
      </div>
      <div class="iv-about-stat">
        <span class="iv-about-stat__num">US</span>
