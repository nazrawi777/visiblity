{% assign file_extension = 'png' %}
{% unless swatch == blank %}
{%- liquid
assign dt_sc_swatch_exist = false
assign dt_sc_swatch_color = false
assign option_index = 0
for option in product.options
if option == swatch
assign dt_sc_swatch_exist = true
assign option_index = forloop.index0

echo '<style>'
echo  'label[for="product-select-option-{{ option_index }}"] { display: none; }'
echo  '#product-select-option-{{ option_index }} { display: none; }'
echo  '#product-select-option-{{ option_index }} + .custom-style-select-box { display: none !important; }'
echo '</style>'

assign dt_sc_handlized = swatch | downcase
if dt_sc_handlized contains 'color' or dt_sc_handlized contains 'colour'
assign dt_sc_swatch_color = true
endif
endif
endfor
%}

{% if dt_sc_swatch_exist %}
<div class="product-attributes swatch clearfix {% if dt_sc_swatch_color %} color-swatch-block {% endif %} {% unless dt_sc_swatch_color %} not_color-swatch-block {% endunless %}" data-option-index="{{ option_index }}">
  <p class=" product-label  {% if dt_sc_swatch_color %} color-swatch-title {% else %} not_color-swatch-title {% endif %}">{{ swatch }}{% if settings.enable_choosen_variant %}<span class="{{ section.settings.meta-lable-style }}  swatch-note"></span>{% endif %}</p>

  <div class="swatch-group">
    {% assign values = '' %}

    {% for variant in product.variants %}
    {% assign value = variant.options[option_index] %}
    {% unless values contains value %}
    {%- liquid
    assign values = values | join: ','
    assign values = values | append: ',' | append: value
    assign values = values | split: ','
    assign valueHandle = value | handle
  %}

    <div data-value="{{ value | escape }}" class="swatch-element {% if dt_sc_swatch_color %}color {% else %} not_color {% endif %}{{ value | handle }} {% if variant.available %}available{% else %}soldout{% endif %}">
      {% if dt_sc_swatch_color %}
      <div class="tooltip" data-variant-group-id="{{ value }}">{{ value }}</div>
      {% endif %}
      <input id="swatch-{{ section.id }}-{{ product.id }}-{{ option_index }}-{{ value | handle }}-{{ forloop.index }}" type="radio" name="option-{{ option_index }}" value="{{ value | escape }}"{% if forloop.first %} checked{% endif %} {% unless variant.available %}disabled{% endunless %} />
      {% if dt_sc_swatch_color %}
      <label for="swatch-{{ section.id }}-{{ product.id }}-{{ option_index }}-{{ value | handle }}-{{ forloop.index }}" >
        {%- if section.settings.swatch_as == 'color' -%}
        <i style="{% if valueHandle == "white" %} border: 1px solid; {% endif %} background-color: {{ value | split: ' ' | last | handle }};">
        </i>
        {%- else -%}
        <i style="
                  {% if valueHandle == "white" %}
                  border: 1px solid;
                  {% endif %}
                  {% if variant.image != null %}
                  background-image: url('{{ variant.image.src | image_url: width: 460 }}');
                  background-size: contain;
                  {% else %}
                  background-image: url({{ value | handle | append: '.' | append: file_extension | file_img_url: "60x" }});
                  background-size: contain;
                  {% endif %}">
        </i>
        {%- endif -%}
       {%- if section.settings.show_variants_left -%} <sub>{{- variant.inventory_quantity -}}{{ 'products.product.left' | t }}</sub>   {%- endif -%}
       <img class="crossed-out" src="{{ 'soldout.png' | asset_url }}" alt="Crossed Out" width="200" height="50" loading="lazy"/>
      </label>
      {% else %}
      <label for="swatch-{{ section.id }}-{{ product.id }}-{{ option_index }}-{{ value | handle }}-{{ forloop.index }}">
        {{ value }}
        <img class="crossed-out" src="{{ 'soldout.png' | asset_url }}" alt="Crossed Out" width="200" height="50" loading="lazy"/>
      </label>
      {% endif %}
    </div>
    {% endunless %}
    {% endfor %}
  </div>
</div>
{% endif %}
{% endunless %}
