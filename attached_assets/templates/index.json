alse,"nav_arrow_position":"navigation-top-right","center_nav_arrow_alignment":"inside_container","navigation_button_color":"","navigation_button_icon_color":"","navigation_button_hover_color":"","navigation_button_hover_icon_color":"","navigation_dot_color":"","navigation_dot_active_color":"","custom_class_name":""}},"iv_deal_timer_7yUgN9":{"type":"iv-deal-timer","name":"IV Deal Timer","settings":{"heading":"Deal of the Week","discount_code":"INFINITE","discount_amount":20}},"36859370-5d42-4713-ba7e-ee96547a6ab2":{"type":"home-testimonial","blocks":{"template--17156958421297__36859370-5d42-4713-ba7e-ee96547a6ab2-16706410600c8d34f4-0":{"type":"content","settings":{"quote":"<p><em>\"I was skeptical at first — I've been burned by 'premium' anime stores before that sent me faded prints and tissue-thin fabric. But Infinite Visibility is built different. The Solo Leveling hoodie I ordered feels like something Sung Jin-Woo himself would wear into the dungeon. Heavy, structured, and the print hasn't cracked after six washes. This is the real S-Rank gear. I'm already eyeing the Demon Slayer collection next.\"<\/em><\/p>","icon":"shopify:\/\/shop_images\/Aiden_K._Shadow_Monarch_Devotee.jpg","author":"Aiden K., Shadow Monarch Devotee ","job":"","star":"5"}},"3edb9ded-42da-4137-838f-f2821f09a32a":{"type":"content","settings":{"quote":"<p><em>\"I bought the <\/em><em><strong>33cm Soul King Brook statue<\/strong><\/em><em> as a gift for my friend, and his reaction was priceless. The detail on the figure is museum-quality—way better than the photos. It came packaged securely (no crushed boxes!), and you can tell the team cares about collectors. Infinite Visibility isn't just a store; it's a sanctuary for fans who want the best. If you're tired of cheap knock-offs, this is where you need to be.\"<\/em><\/p>","icon":"shopify:\/\/shop_images\/Sandra_M._Proud_Anime_Mom.jpg","author":"Sandra M., Proud Anime Mom","job":"","star":"5"}},"content_cMiJNt":{"type":"content","settings":{"quot