{% comment %}
=============================================================
  Infinite Visibility — main-404.liquid
  Branded 404 page in anime gaming style.
  Keeps lost visitors on the store and turns them into buyers.
=============================================================
{% endcomment %}

{%- style -%}
  .iv-404-wrapper {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    background: linear-gradient(135deg, #0a0e2e 0%, #1a1f5e 50%, #0a0e2e 100%);
    position: relative;
    overflow: hidden;
  }
  .iv-404-wrapper::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 20% 50%, rgba(49, 55, 143, 0.3) 0%, transparent 50%),
                      radial-gradient(circle at 80% 20%, rgba(49, 55, 143, 0.2) 0%, transparent 40%);
    pointer-events: none;
  }
  .iv-404-inner {
    max-width: 700px;
    width: 100%;
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .iv-404-code {
    font-size: clamp(80px, 15vw, 160px);
    font-weight: 900;
    line-height: 1;
    margin: 0 0 10px 0;
    background: linear-gradient(135deg, #31378F, #6b74d4, #31378F);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -5px;
    text-shadow: none;
  }
  .iv-404-system-alert {
    display: inline-block;
    background: #31378F;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 5px 16px;
    border-radius: 3px;
    margin: 0 0 20px 0;
  }
  .iv-404-title {
    font-size: clamp(22px, 4vw, 36px);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 15px 0;
    line-height: 1.2;
  }
  .iv-404-subtitle {
    font-size: 16px;
    color: rgba(255,255,255,0.7);
    margin: 0 0 35px 0;
    line-height: 1.6;
  }
  .iv-404-search {
    display: flex;
    gap: 10px;
    margin: 0 0 40px 0;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }
  .iv-404-search input {
    flex: 1;
    padding: 13px 18px;
    border: 2px solid rgba(49, 55, 143, 0.6);
    border-radius: 4px;
    background: rgba(255,255,255,0.08);
    color: #ffffff;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .iv-404-search input::placeholder { color: rgba(255,255,255,0.4); }
  .iv-404-search input:focus { border-color: #31378F; }
  .iv-404-search button {
    padding: 13px 22px;
    background: #31378F;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease;
    white-space: nowrap;
  }
  .iv-404-search button:hover { background: #252c7a; }
  .iv-404-divider {
    color: rgba(255,255,255,0.3);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 20px 0;
  }
  .iv-404-collections-label {
    color: rgba(255,255,255,0.5);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 16px 0;
  }
  .iv-404-collections {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin: 0 0 30px 0;
  }
  .iv-404-collections a {
    display: inline-block;
    padding: 8px 16px;
    border: 1px solid rgba(49, 55, 143, 0.7);
    border-radius: 4px;
    color: rgba(255,255,255,0.85);
    font-size: 13px;
    text-decoration: none;
    transition: all 0.2s ease;
    background: rgba(49, 55, 143, 0.15);
  }
  .iv-404-collections a:hover {
    background: #31378F;
    border-color: #31378F;
    color: #ffffff;
    transform: translateY(-2px);
  }
  .iv-404-sale-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: linear-gradient(135deg, rgba(49,55,143,0.4), rgba(49,55,143,0.2));
    border: 1px solid rgba(49,55,143,0.6);
    border-radius: 6px;
    padding: 16px 24px;
    margin: 0 0 30px 0;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .iv-404-sale-banner:hover {
    background: linear-gradient(135deg, rgba(49,55,143,0.6), rgba(49,55,143,0.3));
    transform: translateY(-2px);
  }
  .iv-404-sale-banner-icon {
    font-size: 28px;
    line-height: 1;
  }
  .iv-404-sale-banner-text {
    text-align: left;
  }
  .iv-404-sale-banner-title {
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 2px 0;
  }
  .iv-404-sale-banner-sub {
    color: rgba(255,255,255,0.6);
    font-size: 12px;
    margin: 0;
  }
  .iv-404-sale-banner-arrow {
    color: #31378F;
    font-size: 20px;
    margin-left: auto;
    color: rgba(255,255,255,0.5);
  }
  .iv-404-home-btn {
    display: inline-block;
    padding: 14px 32px;
    background: transparent;
    border: 2px solid rgba(255,255,255,0.3);
    border-radius: 4px;
    color: rgba(255,255,255,0.7);
    font-size: 13px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .iv-404-home-btn:hover {
    border-color: rgba(255,255,255,0.6);
    color: #ffffff;
  }
  @media (max-width: 600px) {
    .iv-404-wrapper { padding: 40px 16px; }
    .iv-404-search { flex-direction: column; }
    .iv-404-sale-banner { flex-wrap: wrap; text-align: center; }
    .iv-404-sale-banner-text { text-align: center; }
    .iv-404-sale-banner-arrow { display: none; }
  }
{%- endstyle -%}

<div class="iv-404-wrapper">
  <div class="iv-404-inner">

    {%- comment -%} Error code display {%- endcomment -%}
    <div class="iv-404-code" aria-hidden="true">404</div>
    <div class="iv-404-system-alert">⚠ System Alert — Page Not Found</div>

    {%- comment -%} Main heading {%- endcomment -%}
    <h1 class="iv-404-title">
      This Page Has Been Sent to the Shadow Realm
    </h1>
    <p class="iv-404-subtitle">
      Even the best ninjas take a wrong turn sometimes. The page you are looking for does not exist or has been moved. Let's get you back to the good stuff.
    </p>

    {%- comment -%} Search bar {%- endcomment -%}
    <form action="/search" method="get" class="iv-404-search" role="search">
      <input
        type="search"
        name="q"
        placeholder="Search for anime merch..."
        aria-label="Search our store"
        autocomplete="off">
      <button type="submit">Search</button>
    </form>

    <p class="iv-404-divider">— or explore our collections —</p>

    {%- comment -%} Collection links {%- endcomment -%}
    <p class="iv-404-collections-label">Browse the Inventory</p>
    <div class="iv-404-collections">
      <a href="/collections/mans-anime-merch-streetwear-gear-collectibles">
        Man's Anime Merch
      </a>
      <a href="/collections/womens-anime-merch-cute-trendy-gear-kawaii">
        Women's Anime Merch
      </a>
      <a href="/collections/kids-anime-merch-cool-clothes-toys-gifts">
        Kids Anime Merch
      </a>
      <a href="/collections/anime-accessories-figures-phone-cases-wall-art-decor">
        Anime Accessories
      </a>
      <a href="/collections/premium-anime-merchandise-clothing-collectibles-shop-all">
        Premium Merch
      </a>
    </div>

    {%- comment -%} Big Anime Sale banner {%- endcomment -%}
    <a href="/collections/big-anime-sale-clearance-discounts-merch-collectibles" class="iv-404-sale-banner">
      <span class="iv-404-sale-banner-icon">⚡</span>
      <div class="iv-404-sale-banner-text">
        <p class="iv-404-sale-banner-title">Big Anime Sale — Up to 50% Off</p>
        <p class="iv-404-sale-banner-sub">Limited time deals on hoodies, figures & phone cases</p>
      </div>
      <span class="iv-404-sale-banner-arrow">→</span>
    </a>

    {%- comment -%} Home button {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="iv-404-home-btn">
      ← Return to Home Base
    </a>

  </div>
</div>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}