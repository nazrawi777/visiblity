{%- liquid
  assign margin = section.settings.margin | split: ','
  assign margin_top = margin[0]
  assign margin_bottom = margin[1]
  assign padding = section.settings.padding | split: ','
  assign padding_top = padding[0]
  assign padding_bottom = padding[1]

  if section.settings.style == 'list'
  assign collectionListStyle = "collection-list-style"
  elsif section.settings.style == 'overlay'
  assign collectionListStyle = "collection-overlay-style"
  else
  assign collectionListStyle = "collection-grid-style"
  endif

  case section.settings.grid
  when '1'
  when '2'
  assign column = 'two-column'
  when '3'
  assign column = 'three-column'
  when '4'
  assign column = 'four-column'
  when '5'
  assign column = 'five-column'
  when '6'
  assign column = 'six-column'
  else
  assign column = 'three-column'
  endcase

  case section.settings.list
  when '1'
  assign column_list = 'one-column'
  when '2'
  assign column_list = 'two-column'
  endcase
%}

<div class="{% render 'container-settings' %}" data-section-id="{{ section.id }}" data-section-type="collection-template">
  <div class="row">
    <div class="dt-sc-column {{ collectionListStyle }} {% if section.settings.style == 'list' %} {{ column_list }} {% else %} {{ column }}{% endif %} list-collection-products">
      {%- liquid
      if section.settings.use_custom_list_collection
      for link in linklists[section.settings.list-collections].links
      assign collection = link.object
      unless collection.handle == 'frontpage'
      assign featured = collection.handle
      render 'collection-grid-item', collectionListStyle: collectionListStyle, featured: featured
      endunless
      endfor
      else
      for collection in collections
      unless collection.handle == 'frontpage'
      assign featured = collection.handle
      render 'collection-grid-item', collectionListStyle: collectionListStyle, featured: featured
      endunless
      endfor
      endif
      %}
    </div>
  </div>
</div>

<style>
  .collection-detail .dt-sc-btn{
    display: inline-block;
  }

  @media only screen and (min-width: 1200px) { #shopify-section-{{ section.id }}.main-list-collection .row > div { margin-top:{{ margin_top }}px; margin-bottom:{{ margin_bottom }}px;padding-top:{{ padding_top }}px; padding-bottom:{{ padding_bottom }}px; } }
  @media only screen and (max-width: 1199px) { #shopify-section-{{ section.id }}.main-list-collection .row > div { margin-top:{{ margin_top | divided_by: 2 }}px; margin-bottom:{{ margin_bottom | divided_by: 2 }}px;padding-top:{{ padding_top | divided_by: 2 }}px; padding-bottom:{{ padding_bottom | divided_by: 2 }}px;} }


.collection-list-style .odd{display:flex;flex-direction:row; background:var(--DTTertiaryColor);}
.collection-list-style .even{display:flex;flex-direction:row-reverse; background:var(--DTTertiaryColor)}
.collection-list-style .pickgradient-products.odd .collection-detail,
.collection-list-style .pickgradient-products.even .collection-detail {display: flex;flex-direction: column;align-items: center;padding: 0 5%;}
.list-collection-products sup { padding-left:5px;}

 .dt-sc-column.collection-overlay-style.list-collection-products .pickgradient-products { position: relative; min-height:{{ section.settings.overlay_style_height }}px; display: flex; flex-wrap: wrap; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; min-width: 0; word-wrap: break-word; background-clip: border-box; padding: 0; overflow: hidden;}
 .dt-sc-column.collection-overlay-style.list-collection-products a.pickgradient.grid-link {  position: absolute; height: 100%; width: 100%;}
 .dt-sc-column.collection-overlay-style.list-collection-products .pickgradient-products .collection-detail {  margin-top:0; z-index:1;}
 .dt-sc-column.collection-overlay-style.list-collection-products .pickgradient-products a.pickgradient.grid-link img{height:100%;}
 .dt-sc-column.collection-overlay-style.list-collection-products .pickgradient-products:before{background:{{ section.settings.overlay_color }};  background: var(--DTTertiaryColor);}
 .dt-sc-column.collection-overlay-style.list-collection-products .pickgradient-products:hover:before{opacity:{{ section.settings.overlay_opacity }};}
 .dt-sc-column.collection-overlay-style.list-collection-products .pickgradient-products:before{  content: "";  display: block;  width: 100%;  height: 100%;  opacity: 0;  transition: var(--DTBaseTransition);  position: absolute;  z-index: 1;}


 .dt-sc-column.collection-list-style.list-collection-products a.pickgradient.grid-link{width:50%;  height: 100%;}
 .dt-sc-column.collection-list-style.list-collection-products .pickgradient-products a.pickgradient.grid-link img{height:100%; width:100%;}
 .dt-sc-column.collection-list-style.list-collection-products .pickgradient-products .collection-detail{width:50%;  margin-top:0;  margin: 40px; background: #ebf5fa;  box-shadow: var(--DTboxShadow);}
 @media (max-width: 1540px) {
  .dt-sc-column.collection-overlay-style.list-collection-products .pickgradient-products {  min-height:{{ section.settings.overlay_style_height_laptop }}px;}
 }
 @media (max-width: 767px) {
  .dt-sc-column.collection-overlay-style.list-collection-products .pickgradient-products {  min-height: {{ section.settings.overlay_style_height_mobile }}px;}
 }
</style>
