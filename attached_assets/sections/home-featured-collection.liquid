{%- liquid
  assign margin = section.settings.margin | split: ','
  assign margin_top = margin[0]
  assign margin_bottom = margin[1]
  assign padding = section.settings.padding | split: ','
  assign padding_top = padding[0]
  assign padding_bottom = padding[1]

  assign listWidth = section.settings.content_width | split: '/'
  assign leftColumn = listWidth[0]
  assign rightColumn = listWidth[1]
  assign listWidth = section.settings.lap_content_width | split: '/'
  assign lap_leftColumn = listWidth[0]
  assign lap_rightColumn = listWidth[1]


  case section.settings.grid
  when '1'
  assign column = 'two-column'
  when '2'
   assign column = 'two-column'
  when '3'
   assign column = 'three-column'
  when '4'
   assign column = 'four-column'
  when '5'
   assign column = 'five-column'
  when '6'
   assign column = 'six-column'
  else
   assign column = 'three-column'
  endcase
  if section.settings.block_banner_style == 'grid'
  assign grid_style = 'grid-style'
  elsif section.settings.block_banner_style == 'list'
  assign list_style = 'list-style'
  elsif section.settings.block_banner_style == 'overlay'
  assign overlay_style = 'overlay-style'
  endif
  if section.settings.enable_overlay
  assign section_overlay = 'dt-sc-overlay'
  endif
  if section.settings.show_background_image
  assign lazyScript = "lazyload"
  endif
%}
<div data-section-id="{{ section.id }}"
  data-section-type="featured-collection-section"
   data-item-per-view="{{ section.settings.items_per_view }}"
             data-laptop-screen-items="{{ section.settings.items_laptop_view }}"
             data-tablet-screen-items  ="{{ section.settings.items_tablet_view }}"
             data-small-screen-items="{{ section.settings.items_mobile_view }}"
             data-autoplay="{{ section.settings.slider_autoplay }}"
             data-blocks-limit="{{ section.blocks.size }}"
             data-item-space="{{ section.settings.column_gap }}"
             data-center-mode="{{ section.settings.enable_center_mode }}"
             data-item-row="{{ section.settings.rows }}"
             data-auto-height="{{ section.settings.enable_auto_height }}">
  <div class="dt-sc-section-wrapper  {{ lazyScript }} {{ section_overlay }} {% if section.settings.background_style == 'parallax' %} parallax-initiated{% endif %}" {% if section.settings.background_style == 'parallax' %} data-speed="2" data-style="parallax"{% endif %} style="{% render 'bg-color-image-padding' %} background-size: {{- section.settings.background_size -}}; {% if section.settings.background_style == 'fixed' %}background-attachment: fixed;{% endif %} background-repeat:{% if section.settings.background_size == 'repeat' %}repeat{% else %}no-repeat;{% endif %}" {% render 'bg_image' %}>
    <div class="{% render 'container-settings' %}">
      <div class="row {{ section.settings.custom_class_name }}  wow {% if section.settings.animation_effect == false %} {{ section.settings.animation_effect_section }} {% endif %}">

        {% render 'section-heading', class: section.id %}

 {% if section.settings.enable_additional_section %}  <div class="grouped-content{% if section.settings.reverse_column %} dt-sc-reverse-columns{% endif %} ">{% endif %}
     {% if section.settings.enable_additional_section %}
     {% if section.blocks.size > 0 %}
      <div class="additional-block wow {% if  section.settings.animation_effect == true %} {{ section.settings.animation_effect_additionalblock }} {% endif %}">
        {% for block in section.blocks %}
        {% case  block.type %}
        {% when 'menu' %}
        <div class="dt-sc-menu-section {{ block.type }}-{{ block.id }}">
          {% assign blockMenu = linklists[block.settings.menu] %}
          {% if block.settings.block_title != blank %}
          <h3 class="additional-grid-title">{{ block.settings.block_title }}</h3>
          {% endif %}
          <ul class="menu-links">
            {% for link in blockMenu.links %}
            <li {% if link.current %}class="active"{% endif %}><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
        {% when 'banner' %}
        <div class="dt-sc-grid-banner-section">
          <div class="dt-sc-grid-banner  {{ overlay_style }} {{ block.type }}-{{ block.id }} {% if block.settings.enable_overlay_style %} overlay-style{% endif %}">
            {% if block.settings.show_image %}
            <div class="dt-sc-grid-banner-image {{ block.settings.banner_image_overlay_style }}">
              {% if block.settings.block_image != blank %}
             <img
              srcset="{%- if block.settings.block_image.width >= 375 -%}{{ block.settings.block_image | image_url: width: 375 }} 375w,{%- endif -%}
              {%- if block.settings.block_image.width >= 550 -%}{{ block.settings.block_image | image_url: width: 550 }} 550w,{%- endif -%}
              {%- if block.settings.block_image.width >= 750 -%}{{ block.settings.block_image | image_url: width: 750 }} 750w,{%- endif -%}
              {%- if block.settings.block_image.width >= 1100 -%}{{ block.settings.block_image | image_url: width: 1100 }} 1100w,{%- endif -%}
              {%- if block.settings.block_image.width >= 1500 -%}{{ block.settings.block_image | image_url: width: 1500 }} 1500w,{%- endif -%}
              {%- if block.settings.block_image.width >= 1780 -%}{{ block.settings.block_image | image_url: width: 1780 }} 1780w,{%- endif -%}
              {%- if block.settings.block_image.width >= 2000 -%}{{ block.settings.block_image | image_url: width: 2000 }} 2000w,{%- endif -%}
              {%- if block.settings.block_image.width >= 3000 -%}{{ block.settings.block_image | image_url: width: 3000 }} 3000w,{%- endif -%}
              {%- if block.settings.block_image.width >= 3840 -%}{{ block.settings.block_image | image_url: width: 3840 }} 3840w,{%- endif -%}
              {{ block.settings.block_image | image_url }} {{ block.settings.block_image.width }}w"
              sizes="100vw"
              src="{{ block.settings.block_image | image_url: width: 1500 }}"
              loading="lazy"
              class="dt-sc-brand-image"
              alt="{{ block.settings.block_image.alt | escape }}"
              width="{{ block.settings.block_image.width }}"
              height="{{ block.settings.block_image.width | divided_by: block.settings.block_image.aspect_ratio | round }}"
            >
              {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder_svg' }}
              {% endif %}
            </div>
            {% endif %}
            {% if block.settings.enable_overlay_style %}
            {% if block.settings.block_title != blank or block.settings.block_sub_title != blank or   block.settings.block_description != blank or block.settings.block_button_link != blank %}
            <div class="dt-sc-grid-banner-content {{ block.settings.content_position }}">
              <div class="dt-sc-grid-banner-inner {{ block.settings.block_text_align }}">
                {% if block.settings.block_title != blank %}
                <h4 class="dt-sc-main-title">{{ block.settings.block_title }}</h4>
                {% endif %}
                {% if block.settings.block_sub_title != blank %}
                <h6 class="dt-sc-sub-title">{{ block.settings.block_sub_title }}</h6>
                {% endif %}
                {% if block.settings.block_description != blank %}
                <p class="dt-sc-description">{{ block.settings.block_description }}</p>
                {% endif %}
                {% if block.settings.block_button_link != blank %}
                <a href="{{ block.settings.block_button_link }}" class="dt-sc-btn">{{ block.settings.block_button_text }}</a>
                {% endif %}
              </div>
            </div>
            {% endif %}
            {% else %}
              {% if block.settings.block_title != blank or block.settings.block_sub_title != blank or   block.settings.block_description != blank or block.settings.block_button_link != blank %}
              <div class="dt-sc-grid-banner-content {{ block.settings.block_text_align }}">
              {% if block.settings.block_title != blank %}
              <h4 class="dt-sc-main-title">{{ block.settings.block_title }}</h4>
              {% endif %}
              {% if block.settings.block_sub_title != blank %}
              <h6 class="dt-sc-sub-title">{{ block.settings.block_sub_title }}</h6>
              {% endif %}
              {% if block.settings.block_description != blank %}
              <p class="dt-sc-description">{{ block.settings.block_description }}</p>
              {% endif %}
              {% if block.settings.block_button_link != blank %}
              <a href="{{ block.settings.block_button_link }}" class="dt-sc-btn">{{ block.settings.block_button_text }}</a>
              {% endif %}
            </div>
            {% endif %}
            {% endif %}
          </div>
        </div>
        {% when 'timer' %}
        <div class="dt-sc-grid-banner-section deals-section">
          <div class="dt-sc-grid-banner {{ overlay_style }} {{ block.type }}-{{ block.id }}">
            {% if block.settings.timer_block_image %}
            <div class="dt-sc-grid-banner-image {{ block.settings.banner_image_overlay_style }}">
              {% if block.settings.block_image != blank %}
             <img
              srcset="{%- if block.settings.block_image.width >= 375 -%}{{ block.settings.block_image | image_url: width: 375 }} 375w,{%- endif -%}
              {%- if block.settings.block_image.width >= 550 -%}{{ block.settings.block_image | image_url: width: 550 }} 550w,{%- endif -%}
              {%- if block.settings.block_image.width >= 750 -%}{{ block.settings.block_image | image_url: width: 750 }} 750w,{%- endif -%}
              {%- if block.settings.block_image.width >= 1100 -%}{{ block.settings.block_image | image_url: width: 1100 }} 1100w,{%- endif -%}
              {%- if block.settings.block_image.width >= 1500 -%}{{ block.settings.block_image | image_url: width: 1500 }} 1500w,{%- endif -%}
              {%- if block.settings.block_image.width >= 1780 -%}{{ block.settings.block_image | image_url: width: 1780 }} 1780w,{%- endif -%}
              {%- if block.settings.block_image.width >= 2000 -%}{{ block.settings.block_image | image_url: width: 2000 }} 2000w,{%- endif -%}
              {%- if block.settings.block_image.width >= 3000 -%}{{ block.settings.block_image | image_url: width: 3000 }} 3000w,{%- endif -%}
              {%- if block.settings.block_image.width >= 3840 -%}{{ block.settings.block_image | image_url: width: 3840 }} 3840w,{%- endif -%}
              {{ block.settings.block_image | image_url }} {{ block.settings.block_image.width }}w"
              sizes="100vw"
              src="{{ block.settings.block_image | image_url: width: 1500 }}"
              loading="lazy"
              alt="{{ block.settings.block_image.alt | escape }}"
              width="{{ block.settings.block_image.width }}"
              height="{{ block.settings.block_image.width | divided_by: block.settings.block_image.aspect_ratio | round }}"
            >
              {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder_svg' }}
              {% endif %}
            </div>
            {% endif %}
            {% if block.settings.block_title != blank or block.settings.block_sub_title != blank or   block.settings.deal_end_date != blank or  block.settings.block_description != blank or block.settings.block_button_link != blank %}
            <div class="dt-sc-grid-banner-content {{ block.settings.block_text_align }}">
              {% if block.settings.block_title != blank %}
              <h4 class="dt-sc-main-title">{{ block.settings.block_title }}</h4>
              {% endif %}
              {% if block.settings.block_description != blank %}
              <p class="dt-sc-description">{{ block.settings.block_description }}</p>
              {% endif %}
              <div class="deals-counter">
                {% if block.settings.block_sub_title != blank %}
                <h6 class="dt-sc-sub-title">{{ block.settings.block_sub_title }}</h6>
                {% endif %}
                {% if block.settings.deal_end_date != blank %}
                {% assign endTime = block.settings.deal_end_date | date: "%d %b %Y" %}
                <div class="product-deal-count" data-end-time="{{ endTime }}">
                  <div class="notice"></div>
                  <div class="deal-clock">
                    <ul>
                      <li class="days"></li>
                      <li class="hours"></li>
                      <li class="minutes"></li>
                      <li class="seconds"></li>
                    </ul>
                  </div>
                </div>
                {% endif %}
              </div>
              {% if block.settings.block_button_link != blank %}
              <a href="{{ block.settings.block_button_link }}" class="dt-sc-btn">{{ block.settings.block_button_text }}</a>
              {% endif %}
            </div>
            {% endif %}
          </div>
        </div>

        {% when 'product' %}
        <div class="dT_vDynamicPWrap-{{ section.id }}-block-{{ block.id }} dT_vProdWrap">
          <ul>
            {%- assign product = all_products[block.settings.product] -%}
            {% render 'product-grid-item', product: product, swiperSlideClass: 'carousel-block-item' %}
          </ul>
        </div>
        {% endcase %}
        {% endfor %}

      </div>
      {% endif %}
       {% endif %}
  {% if section.settings.enable_main_content != blank %}
      <div class="main-block wow {% if  section.settings.animation_effect == true %} {{ section.settings.animation_effect_mainblock }} {% endif %}">

        {% if section.settings.enable_slider %} <div class="dt-sc-swiper-slider swiper-container {% if section.settings.dots %} {{ section.settings.carousel_pagination_alignment }} {% endif %} {% if section.settings.arrows %}  {{ section.settings.nav_arrow_position }} {{ section.settings.center_nav_arrow_alignment }} {% endif %}">    {% endif %}

        {% if section.settings.enable_slider %} <div id="swiper-{{ section.id }}-slider"> {% endif %}

        <div class="dt-sc-featured-collection-section {% if section.settings.enable_slider %}swiper-wrapper{% endif %} {% unless section.settings.enable_slider %}dt-sc-column{% endunless %} {% if section.settings.equal_height %}dt-sc-equal-height{% endif %} {% unless section.settings.enable_slider %}{{ column }}{% endunless %}">
          {%- liquid
            for block in section.blocks
            case  block.type
            when 'collection'
            if section.settings.block_banner_style == 'list'
            assign listWidth = section.settings.content_width | split: '/'
            assign leftColumn = listWidth[0]
            assign rightColumn = listWidth[1]
            assign listWidth = section.settings.lap_content_width | split: '/'
            assign lap_leftColumn = listWidth[0]
            assign lap_rightColumn = listWidth[1]
            endif
            if block.settings.overlay_style == 'use_overlay'
            assign overlay_class = 'with-overlay'
            elsif block.settings.overlay_style == 'use_gradient_overlay'
            assign overlay_class = 'with-gradient-overlay'
            endif
            assign featured = block.settings.collection
            render 'collection-block-content', featured: featured, block: block, grid_style: grid_style, list_style: list_style, overlay_style: overlay_style, overlay_class: overlay_class, leftColumn: leftColumn, rightColumn: rightColumn
            endcase
            endfor
            %}
        </div>



        {% if section.settings.enable_slider %}   </div>   {% endif %}

        {% if section.settings.enable_slider %}
        {% if section.settings.arrows %}
        <div class="swiper-{{ section.id }}-arrows swiper-arrows">
          <div id="swiper-{{ section.id }}-next" class="swiper-button-next dt-sc-btn"></div>
          <div id="swiper-{{ section.id }}-prev" class="swiper-button-prev dt-sc-btn"></div>
        </div>
        {% endif %}
        {% if section.settings.dots %}
        <div id="swiper-{{ section.id }}-pagination" class="swiper-pagination"></div>
        {% endif %}
        {% endif %}
        {% if section.settings.enable_slider %} </div>{% endif %}
      </div>
    </div>
      {% if section.settings.enable_additional_section %}</div>{% endif %}
  </div>
    {% endif %}
</div>
</div>


{% style %}
    #shopify-section-{{ section.id }}.home-featured-collection .grouped-content .additional-block .additional-grid-title { margin-top: 0; }
    #shopify-section-{{ section.id }}.home-featured-collection .grouped-content { display: flex; flex-wrap: wrap; justify-content: space-between; }
    #shopify-section-{{ section.id }}.home-featured-collection .grouped-content .additional-block + .main-block .dt-sc-swiper-slider.swiper-container.center-navigation.outside_container {
      margin: auto;
    }
    #shopify-section-{{ section.id }}.home-featured-collection .grouped-content .main-block .dt-sc-swiper-slider.swiper-container { padding-bottom: 30px; }
    #shopify-section-{{ section.id }}.home-featured-collection .grouped-content .product-list-style .deal-clock,
    #shopify-section-{{ section.id }}.home-featured-collection .grouped-content .product-list-style .product_desc { display: none; }
    #shopify-section-{{ section.id }}.home-featured-collection .grouped-content .product-list-style .products .product-detail .dt-sc-btn-group > * { font-size: 0; }
    #shopify-section-{{ section.id }}.home-featured-collection .grouped-content .product-list-style .products .product-detail .dt-sc-btn-group > * svg { margin-right: 0; }
    #shopify-section-{{ section.id }}.home-featured-collection .main-block {
      background: {{ section.settings.main_block_background_color }};
      border-radius: var(--DTRadius); border-radius: {{ section.settings.main_block_border_radius }}px;
        padding: {{ section.settings.main_content_padding }}px;
        {% if section.settings.enable_main_block_box_shadow %} box-shadow: var(--DTboxShadow); {% endif %}
          }
    #shopify-section-{{ section.id }}.home-featured-collection .grouped-content .main-block { background: var(--DTBodyBGColor); background: {{ section.settings.main_block_background_color }}; }
    #shopify-section-{{ section.id }}.home-featured-collection .grouped-content {
      background: {{ section.settings.grouped_content_bg }};
      border-radius: var(--DTRadius); border-radius: {{ section.settings.group_border_radius }}px;
        {% if section.settings.enable_group_box_shadow %} box-shadow: var(--DTboxShadow); {% endif %}
          padding: {{ section.settings.grouped_content_padding }}px;
          }
  {% unless section.settings.enable_slider %}
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-featured-collection-section { grid-gap: {{ section.settings.column_gap }}px; }
  {% endunless %}
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-heading .dt-sc-main-heading { color: var(--DTColor_Heading); color:{{ section.settings.section_heading_color }}; }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-heading .dt-sc-sub-heading { color: var(--DTColor_Heading); color:{{ section.settings.section_sub_heading_color }}; }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-heading .dt-sc-heading-description { color: var(--DTColor_Body); color:{{ section.settings.section_description_color }}; }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-heading .dt-sc-btn {
    background: var(--DT_Button_BG_Color);  background:{{ section.settings.section_button_bg_color }};
      color: var(--DT_Button_Text_Color); color:{{ section.settings.section_button_text_color }}; }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-heading .dt-sc-btn:hover {
    background: var(--DT_Button_BG_Hover_Color); background:{{ section.settings.section_button_hover_bg_color }};
      color: var(--DT_Button_Text_Hover_Color); color:{{ section.settings.section_button_hover_text_color }}; }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-overlay:before  {
    color: var(--DTTertiaryColor);
      color: {{ section.settings.background_color }};
      background: currentcolor;
      opacity: {{ section.settings.overlay_transparency }}; }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-featured-collection-section .dt-sc-collection-banner {
    border-radius: var(--DTRadius); border-radius: {{ section.settings.border_radius }}px;
      {% if section.settings.enable_box_shadow %} box-shadow: var(--DTboxShadow); {% endif %}
        }
  {% for block in section.blocks %}
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-collection-banner.{{ block.type }}-{{ block.id }} {
    background-color: var(--DTTertiaryColor);
      background-color: {{ block.settings.block_banner_bg }}; }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-collection-banner.{{ block.type }}-{{ block.id }}
  .dt-sc-collection-banner-content .dt-sc-collection-banner-inner {
    background-color: var(--DTTertiaryColor);
      background-color: {{ block.settings.block_banner_bg | color_modify: 'alpha', 0.7 }}; border-radius: var(--DTRadius); border-radius: {{ section.settings.border_radius }}px;
        }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-collection-banner.{{ block.type }}-{{ block.id }}.list-style .dt-sc-collection-banner-content
  .dt-sc-collection-banner-inner { background-color: var(--DTTertiaryColor); background-color: {{ block.settings.block_content_box_bg }}; }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-collection-banner.{{ block.type }}-{{ block.id }} .dt-sc-main-title a{
    color: var(--DTColor_Heading); color:{{ block.settings.block_heading_color }}; }
    #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-collection-banner.{{ block.type }}-{{ block.id }} .dt-sc-main-title a:hover{
    color: var(--DTLinkHoverColor);}
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-collection-banner.{{ block.type }}-{{ block.id }} .dt-sc-sub-title {
    color: var(--DTColor_Heading); color: {{ block.settings.block_sub_heading_color }}; }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-collection-banner.{{ block.type }}-{{ block.id }} .dt-sc-description {
    color: var(--DTColor_Body); color:{{ block.settings.block_description_color }}; }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-collection-banner.{{ block.type }}-{{ block.id }} .dt-sc-btn {
    background: var(--DT_Button_BG_Color); background:{{ block.settings.block_button_bg_color }};
      color: var(--DT_Button_Text_Color); color:{{ block.settings.block_button_text_color }}; }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-collection-banner.{{ block.type }}-{{ block.id }} .dt-sc-btn:hover {
    background: var(--DT_Button_BG_Hover_Color); background:{{ block.settings.block_button_hover_bg_color }};
      color: var(--DT_Button_Text_Hover_Color); color:{{ block.settings.block_button_hover_text_color }}; }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-featured-collection-section .dt-sc-collection-banner.{{ block.type }}-{{ block.id }} .with-overlay:before {
    color: var(--DTTertiaryColor);
      color: {{ block.settings.overlay_color }};
      background: currentcolor;  }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-featured-collection-section .dt-sc-collection-banner.{{ block.type }}-{{ block.id }} .with-gradient-overlay:before {
    background-image: linear-gradient({{ block.settings.rotation_degree }}deg, {{ settings.tertiary_color | color_modify: 'alpha', 0 }}, {{ settings.tertiary_color }});
    background-image: linear-gradient({{ block.settings.rotation_degree }}deg, {{ block.settings.overlay_color | color_modify: 'alpha', 0 }}, {{ block.settings.overlay_color }});
  }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-featured-collection-section .dt-sc-collection-banner.{{ block.type }}-{{ block.id }}:hover .with-overlay:before,
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-featured-collection-section .dt-sc-collection-banner.{{ block.type }}-{{ block.id }}:hover .with-gradient-overlay:before {
    opacity: {{ block.settings.overlay_opacity }};
  }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-featured-collection-section .dt-sc-collection-banner.{{ block.type }}-{{ block.id }}.overlay-style,
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-featured-collection-section .dt-sc-collection-banner.{{ block.type }}-{{ block.id }}.overlay-style .dt-sc-collection-banner-content {
    min-height: {{ section.settings.overlay_style_height }}px;
  }
  {% endfor %}
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-swiper-slider.swiper-container .swiper-arrows .dt-sc-btn {
    background: var(--DT_Button_BG_Color);
      background: {{ section.settings.navigation_button_color }};
      }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-swiper-slider.swiper-container .swiper-arrows .dt-sc-btn[class*="swiper-button-"]:after {
    color: var(--DT_Button_Text_Color);
      color: {{ section.settings.navigation_button_icon_color }};
      }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-swiper-slider.swiper-container .swiper-arrows .dt-sc-btn:hover {
    background: var(--DT_Button_BG_Hover_Color);
      background: {{ section.settings.navigation_button_hover_color }};
      }
  #shopify-section-{{ section.id }}.home-featured-collection .dt-sc-swiper-slider.swiper-container .swiper-arrows .dt-sc-btn:hover[class*="swiper-button-"]:after {
    color: var(--DT_Button_Text_Hover_Color);
