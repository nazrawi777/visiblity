{% schema %}
  {
  "name": "Index menu",
  "class": "index-scroll-menu",
  "settings": [
  {
  "type": "header",
  "content": "Index menu settings",
  "info":"Not for Mobile"
  },
  {
  "type": "range",
  "id": "scroll_menu_width",
  "label":"Scroll menu width",
  "min": 0,
  "max": 500,
  "step": 5,
  "unit": "px",
  "default": 350
  },
  {
  "type": "range",
  "id": "spacing_from_top",
  "label":"Index Menu Top Spacing",
  "min": 0,
  "max": 250,
  "step": 5,
  "unit": "px",
  "default": 100
  },
  {
  "type": "color",
  "id": "fullwidth_menu_bg",
  "label": "Fullwidth Menu Background",
  "default": "#fff"
  },
  {
  "type": "image_picker",
  "id": "logo",
  "label": "Logo image"
  },
{
  "type": "range",
  "id": "logo_max_width",
  "label":"Custom logo width",
  "min": 50,
  "max": 100,
  "step": 1,
  "unit": "%",
  "default": 75
  },
  {
  "type": "text",
  "id": "filter_title",
  "label": "Title",
  "default": "Custom Menu"
  },
  {
  "type": "link_list",
  "id": "linklist",
  "label": "Menu"
  },
  {
  "type": "checkbox",
  "id": "hide_indexmenu_mobile",
  "label": "Hide index menu on mobile",
  "default": true
  }
  ]
  }
{% endschema %}
