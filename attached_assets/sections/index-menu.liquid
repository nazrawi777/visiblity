
{%- assign index_menu = section.settings.linklist -%}

<div class="filter-panel-menu">
  {%- if section.settings.logo -%}
  <div class="fullheight-menu-logo">
  <a href="{{ routes.root_url }}" title="{{ shop.name }}" >
    {%- if section.settings.logo != blank -%}
      {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
      {%- assign logo_height = section.settings.logo_max_width | divided_by: section.settings.logo.aspect_ratio -%}
      {{ section.settings.logo | image_url: width: section.settings.logo_max_width | image_tag:
        class: 'header__heading-logo',
        widths: '50, 100, 150, 200, 250, 300, 400, 500',
        height: logo_height,
        width: section.settings.logo_max_width,
        alt: logo_alt
      }}
    {%- else -%}
      <span class="h2">{{ shop.name }}</span>
    {%- endif -%}
  </a>
  </div>
  {%- endif -%}
  {%- if section.settings.filter_title != '' -%}
  <h5 class="sidebar_title">{{ section.settings.filter_title }}</h5>
  {%- endif -%}
{%- if linklists[index_menu].links.size > 0 -%}
  <div class="filter-panel" id="accordian">
    <ul class="filter-panel-inner">
      {% for link in linklists[index_menu].links %}
      {% assign link_handle = link.title | handle %}
      {% if linklists[link_handle] and linklists[link_handle].links.size > 0 %}
      <li class="{% unless forloop.first %}{% if link.active %}active{% endif %}{% endunless %}">
        <a href="{{ link.url }}">{{ link.title }}</a>
        <ul>
          {% for child in linklists[link_handle].links %}
          <li {% if child.active %}class="active"{% endif %}><a href="{{ child.url }}">{{ child.title }}</a></li>
          {% endfor %}
        </ul>
      </li>
      {% else %}
      <li class="{% if link.active %}active{% endif %}"><a href="{{ link.url }}">{{ link.title }}</a></li>
      {% endif %}
      {% endfor %}
    </ul>
    <div class="close-icon"><a><i class="fa fa-angle-left"></i> Back</a></div>
  </div>
{%- endif -%}
</div>


<script>
// Sticky Header
  $(window).scroll(function() {

    if ($(window).scrollTop() > 100) {
      $('.index-scroll-menu').addClass('sticky');
    } else {
      $('.index-scroll-menu').removeClass('sticky');
    }
  });

//   Fullheight Menu

      $(document).ready(function(){
        {% if template contains 'index' %}
        $('.filter-panel .filter-panel-inner li:first-child').addClass('active');
      {% endif %}
    });
  $(document).click(function(event) {
    if (!$(event.target).closest(".filter-panel").length) {
      $("body").find(".filter-panel .filter-panel-inner").removeClass("expanded");
    }
  });

  $(document).on('click', '.filter-panel li', function(){
    $('.filter-panel li').removeClass('active');
    $('.filter-panel .filter-panel-inner').toggleClass('expanded');
    $(this).addClass('active');

  });


  $(document).ready(function(){
    $(".dt-sc-btn.mobileToggleIcon").on("click",function(){
      $(".dt-sc-btn.mobileToggleIcon").toggleClass("open");
      $(".index-scroll-menu").toggleClass("open")
    });
    $(".close-icon").on("click",function(){
     $(".dt-sc-btn.mobileToggleIcon").removeClass("open");
      $(".index-scroll-menu").removeClass("open")
    });
  });


</script>
