{%- assign deal_collection = collections['all-products'] -%}
{%- assign total_products = deal_collection.products.size -%}
{%- comment -%}
  FIX: 'now' | date: '%j' returns 0 in Liquid because 'now' is not
  a timestamp object. Use '%s' to get Unix seconds which Liquid
  does resolve correctly via the date filter on the string 'now'.
  Divide by 259200 (72 hours in seconds) to get the 72h period index.
{%- endcomment -%}
{%- assign unix_now = 'now' | date: '%s' | plus: 0 -%}
{%- assign period_72h = unix_now | divided_by: 259200 -%}
{%- if total_products > 0 -%}
  {%- assign product_index = period_72h | modulo: total_products -%}
  {%- assign deal_product = deal_collection.products[product_index] -%}
{%- endif -%}
{%- assign discount_code = section.settings.discount_code | default: 'INFINITE' -%}
{%- assign discount_amount = section.settings.discount_amount | default: 20 -%}

<style>
  #shopify-section-{{ section.id }} {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    height: auto !important;
    overflow: visible !important;
    position: relative !important;
  }
  .iv-deal-timer-section {
    background: linear-gradient(135deg, #31378F 0%, #1e2460 100%) !important;
    padding: 50px 20px !important;
    margin: 0 !important;
    display: block !important;
    width: 100% !important;
    position: relative !important;
    z-index: 1 !important;
  }
  .iv-deal-inner {
    max-width: 1100px !important;
    margin: 0 auto !important;
    display: flex !important;
    align-items: center !important;
    gap: 50px !important;
    flex-wrap: wrap !important;
  }
  .iv-deal-image-wrap {
    flex: 0 0 380px !important;
    max-width: 380px !important;
    border-radius: 12px !important;
    overflow: hidden !important;
    box-shadow: 0 20px 60px rgba(0,0,0,0.4) !important;
    display: block !important;
    transition: transform 0.3s ease !important;
    text-decoration: none !important;
    height: auto !important;
  }
  .iv-deal-image-wrap:hover { transform: scale(1.02) !important; }
  .iv-deal-img {
    width: 100% !important;
    height: auto !important;
    display: block !important;
    aspect-ratio: 1/1 !important;
    object-fit: cover !important;
  }
  .iv-deal-img-placeholder {
    width: 100% !important;
    aspect-ratio: 1/1 !important;
    background: rgba(255,255,255,0.05) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 80px !important;
  }
  .iv-deal-content {
    flex: 1 !important;
    min-width: 280px !important;
    color: #ffffff !important;
    display: block !important;
  }
  .iv-deal-eyebrow {
    font-size: 13px !important;
    font-weight: 700 !important;
    letter-spacing: 0.1em !important;
    text-transform: uppercase !important;
    color: #FFC72F !important;
    margin: 0 0 10px 0 !important;
    display: block !important;
  }
  .iv-deal-title {
    font-size: 36px !important;
    font-weight: 800 !important;
    color: #ffffff !important;
    margin: 0 0 8px 0 !important;
    line-height: 1.2 !important;
    display: block !important;
  }
  .iv-deal-product-name {
    font-size: 16px !important;
    color: rgba(255,255,255,0.7) !important;
    margin: 0 0 16px 0 !important;
    font-style: italic !important;
    display: block !important;
  }
  .iv-deal-pricing {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    margin-bottom: 8px !important;
    flex-wrap: wrap !important;
  }
  .iv-deal-sale-price {
    font-size: 32px !important;
    font-weight: 800 !important;
    color: #FFC72F !important;
    display: inline !important;
  }
  .iv-deal-original-price {
    font-size: 18px !important;
    color: rgba(255,255,255,0.5) !important;
    display: inline !important;
  }
  .iv-deal-badge {
    background: #FFC72F !important;
    color: #1a1a2e !important;
    font-size: 13px !important;
    font-weight: 800 !important;
    padding: 4px 10px !important;
    border-radius: 4px !important;
    display: inline-block !important;
  }
  .iv-deal-savings {
    font-size: 14px !important;
    color: #7effa0 !important;
    font-weight: 700 !important;
    margin: 0 0 20px 0 !important;
    display: block !important;
  }
  .iv-deal-timer-label {
    font-size: 13px !important;
    color: rgba(255,255,255,0.6) !important;
    margin: 0 0 10px 0 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    display: block !important;
  }
  .iv-deal-clock {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    margin-bottom: 28px !important;
  }
  .iv-clock-block {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    background: rgba(255,255,255,0.08) !important;
    border: 1px solid rgba(255,255,255,0.15) !important;
    border-radius: 8px !important;
    padding: 12px 20px !important;
    min-width: 70px !important;
  }
  .iv-clock-num {
    font-size: 36px !important;
    font-weight: 800 !important;
    color: #FFC72F !important;
    line-height: 1 !important;
    display: block !important;
  }
  .iv-clock-label {
    font-size: 11px !important;
    color: rgba(255,255,255,0.5) !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    margin-top: 4px !important;
    display: block !important;
  }
  .iv-clock-sep {
    font-size: 30px !important;
    font-weight: 800 !important;
    color: #FFC72F !important;
    margin-bottom: 18px !important;
    display: inline-block !important;
  }
  .iv-deal-cta {
    display: block !important;
    background: #FFC72F !important;
    color: #1a1a2e !important;
    font-size: 16px !important;
    font-weight: 800 !important;
    padding: 16px 32px !important;
    border-radius: 8px !important;
    text-decoration: none !important;
    transition: all 0.2s ease !important;
    margin-bottom: 10px !important;
    text-align: center !important;
    box-sizing: border-box !important;
  }
  .iv-deal-cta:hover {
    background: #e6b000 !important;
    transform: translateY(-2px) !important;
    color: #1a1a2e !important;
  }
  .iv-deal-note {
    font-size: 12px !important;
    color: rgba(255,255,255,0.4) !important;
    text-align: center !important;
    margin: 0 !important;
    display: block !important;
  }
  @media (max-width: 767px) {
    .iv-deal-inner { flex-direction: column !important; gap: 30px !important; }
    .iv-deal-image-wrap { flex: 0 0 100% !important; max-width: 100% !important; }
    .iv-deal-title { font-size: 26px !important; }
    .iv-clock-num { font-size: 28px !important; }
    .iv-clock-block { padding: 10px 14px !important; min-width: 55px !important; }
  }
</style>

<div class="iv-deal-timer-section" id="iv-deal-timer-{{ section.id }}">
  <div class="iv-deal-inner">

    <a href="/discount/{{ discount_code }}?redirect={% if deal_product %}{{ deal_product.url }}{% else %}/collections/all-products{% endif %}" class="iv-deal-image-wrap">
      {% if deal_product and deal_product.featured_image %}
        <img
          src="{{ deal_product.featured_image | image_url: width: 600 }}"
          alt="{{ deal_product.featured_image.alt | default: deal_product.title | escape }}"
          width="600"
          height="600"
          loading="lazy"
          class="iv-deal-img">
      {% else %}
        <div class="iv-deal-img-placeholder"><span>⚔️</span></div>
      {% endif %}
    </a>

    <div class="iv-deal-content">
      <p class="iv-deal-eyebrow">⚡ Limited Time Deal</p>
      <h2 class="iv-deal-title">{{ section.settings.heading | default: 'Deal of the Week' }}</h2>

      {% if deal_product %}
        <p class="iv-deal-product-name">{{ deal_product.title }}</p>
        <div class="iv-deal-pricing">
          {%- assign deal_price = deal_product.price | times: discount_amount | divided_by: 100 -%}
          {%- assign final_price = deal_product.price | minus: deal_price -%}
          <span class="iv-deal-sale-price">{{ final_price | money }}</span>
          <span class="iv-deal-original-price"><del>{{ deal_product.price | money }}</del></span>
          <span class="iv-deal-badge">{{ discount_amount }}% OFF</span>
        </div>
        <span class="iv-deal-savings">✅ You save {{ deal_price | money }} — applied automatically at checkout</span>
      {% else %}
        <p class="iv-deal-product-name">New deal loading — check back shortly!</p>
      {% endif %}

      <p class="iv-deal-timer-label">Deal refreshes in:</p>
      <div class="iv-deal-clock">
        <div class="iv-clock-block">
          <span class="iv-clock-num" id="iv-h-{{ section.id }}">00</span>
          <span class="iv-clock-label">Hours</span>
        </div>
        <span class="iv-clock-sep">:</span>
        <div class="iv-clock-block">
          <span class="iv-clock-num" id="iv-m-{{ section.id }}">00</span>
          <span class="iv-clock-label">Mins</span>
        </div>
        <span class="iv-clock-sep">:</span>
        <div class="iv-clock-block">
          <span class="iv-clock-num" id="iv-s-{{ section.id }}">00</span>
          <span class="iv-clock-label">Secs</span>
        </div>
      </div>

      {% if deal_product %}
        <a href="/discount/{{ discount_code }}?redirect={{ deal_product.url }}" class="iv-deal-cta">
          ⚔️ Claim Deal — {{ discount_amount }}% Off
        </a>
      {% else %}
        <a href="/collections/all-products" class="iv-deal-cta">⚔️ Shop All Deals</a>
      {% endif %}

      <p class="iv-deal-note">Discount code applied automatically — no code needed at checkout</p>
    </div>

  </div>
</div>

<script>
(function() {
  var cycleSeconds = 72 * 3600;
  var nowSeconds = Math.floor(Date.now() / 1000);
  var secondsRemaining = cycleSeconds - (nowSeconds % cycleSeconds);
  function pad(n) { return n < 10 ? '0' + n : '' + n; }
  function updateClock() {
    if (secondsRemaining <= 0) {
      secondsRemaining = cycleSeconds;
    }
    var h = Math.floor(secondsRemaining / 3600);
    var m = Math.floor((secondsRemaining % 3600) / 60);
    var s = secondsRemaining % 60;
    var hEl = document.getElementById('iv-h-{{ section.id }}');
    var mEl = document.getElementById('iv-m-{{ section.id }}');
    var sEl = document.getElementById('iv-s-{{ section.id }}');
    if (hEl) hEl.textContent = pad(h);
    if (mEl) mEl.textContent = pad(m);
    if (sEl) sEl.textContent = pad(s);
    secondsRemaining--;
  }
  updateClock();
  setInterval(updateClock, 1000);
})();
</script>

{% schema %}
{
  "name": "IV Deal Timer",
  "class": "iv-deal-timer-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Deal Heading", "default": "Deal of the Week" },
    { "type": "text", "id": "discount_code", "label": "Discount Code", "default": "INFINITE", "info": "Never shown to customers — applied silently via redirect" },
    { "type": "range", "id": "discount_amount", "label": "Discount Percentage", "min": 5, "max": 50, "step": 5, "default": 20 }
  ],
  "presets": [{ "name": "IV Deal Timer" }]
}
{% endschema %}