{%- endstyle -%}



{% javascript %}
$("#init-toggle").click(function(){
    $(this).toggleClass('open');
    $(".vertical-mega-menu").toggleClass('open');
  });

  jQuery(document).ready(function($) {
   "use strict";

       if($(window).width() <= 991) {

      $("nav.vertical-mega-menu").each(function() {

        var vdata = $(this).data('vmenu'),
            ulData = $(this).find('ul[data-vmenu="' + vdata + '"]').clone().removeClass('dt-vnav'),
            vmobileData = $('body').find('.mobile-vmenu[data-vmenu="' + vdata + '"]');

        console.log(ulData);
        // To Remove animation classes
        $('[data-animation]', ulData).each(function(ix, ele) {
          var $classes = $(ele).attr("class"),
              $animation = $(ele).attr("data-animation");
          $classes = $classes.replace($animation, '');
          $(ele).attr("class", $classes);
        });
        ulData.prependTo(vmobileData);
      });

      VmobileTrigger();

      // Closing Mobile Nav
      $('li.v-close-nav').on('click', function(event) {
        VcloseMobNav();
      });

      $('body .vertical-mobile-menu-overlay').on('click', function(event) {
        VcloseMobNav();
      });

      // Sub Menu in Mobile Menu
      $('.v-mega-has-children > a').on('click', function(event) {

        if ($('body').hasClass('vnav-is-visible')) {
          event.preventDefault();
          var a = $(this).clone();
          $(this).next('.v-menu-sub').find('.see-all').html(a);
        }

        var selected = $(this);
        if (selected.next('div.v-menu-sub').hasClass('is-v-hidden')) {
          selected.addClass('selected').next('div.v-menu-sub').removeClass('is-v-hidden');
        } else {
          selected.removeClass('selected').next('div.v-menu-sub').addClass('is-v-hidden');
        }
      });

      // Go Back in Mobile Menu
      $('.go-back').on('click', function() {
        $(this).closest('div.v-menu-sub').addClass('is-v-hidden');
      });
    }


   function VmobileTrigger(){
      $('.vmenu-trigger').on('click', function(event) {
        $('body').find('.mobile-vmenu').addClass('vnav-is-visible');
        $('body').find('.mobile-menu-overlay').addClass('is-showit');
        $('body').addClass('vnav-is-visible');
      });
    }

    function VcloseMobNav() {
      $('body').removeClass('vnav-is-visible');
      $('.vertical-mobile-menu-overlay').removeClass('is-showit');
      $('.mobile-vmenu').removeClass('vnav-is-visible');
      $('.v-mega-has-children a').removeClass('selected');
      $('.v-mega-has-children div.v-menu-sub').addClass('is-v-hidden');
    }

    $(window).on('resize',function() {
      VmobileTrigger();
      VcloseMobNav();
    });

    $(window).on('load',function() {
      VmobileTrigger();
      VcloseMobNav();
    });

/* Tabs on Vertical navigation  */

 $(function() {
      if($(window).width() >= 992) {
         $('.from-vertical .tabs-nav a').click(function() {
         $(this).removeClass('active');
        $(this).parent().addClass('active');
        let currentTab = $(this).attr('href');
        $('.v-menu-sub .tabs-content li.dt-sc-menu-tabs').hide();
       console.log(currentTab);
        $(currentTab).show();
        return false;
      });
    }
      if($(window).width() < 992 ) {
      $('.from-vertical .mobileTabs .tabs  li').each(function(){
        $(this).click(function(){
          $(this).next('div').slideToggle(0);
        });
      })
    }
    });
});




  $('.level-has-child li.leavel-has-dropdown').click(function () {
          $('li.leavel-has-dropdown').not(this).find('ul').hide();
          $(this).find('ul').toggle();
