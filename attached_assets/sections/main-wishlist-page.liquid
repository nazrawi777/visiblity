{%- style -%}
  .iv-wish-page { font-family: inherit; background: #ffffff; }
  .iv-wish-hero {
    background: linear-gradient(135deg, #0a0e2e 0%, #1a1f5e 60%, #31378F 100%);
    padding: 60px 20px 50px;
    text-align: center;
  }
  .iv-wish-hero__badge {
    display: inline-block;
    background: rgba(255,199,47,0.15);
    border: 1px solid rgba(255,199,47,0.4);
    color: #ffc72f;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 3px;
    margin: 0 0 16px 0;
  }
  .iv-wish-hero__title {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 900;
    color: #ffffff;
    margin: 0 0 14px 0;
    line-height: 1.2;
  }
  .iv-wish-hero__title span { color: #ffc72f; }
  .iv-wish-hero__sub {
    font-size: 16px;
    color: rgba(255,255,255,0.75);
    max-width: 600px;
    margin: 0 auto 24px;
    line-height: 1.7;
  }
  .iv-wish-hero__msg {
    display: inline-block;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,199,47,0.25);
    border-radius: 8px;
    padding: 16px 24px;
    max-width: 640px;
    font-size: 14px;
    color: rgba(255,255,255,0.8);
    line-height: 1.7;
    font-style: italic;
    margin: 0 auto;
  }
  .iv-wish-hero__msg strong { color: #ffc72f; font-style: normal; }
  .iv-wish-tabs {
    display: flex;
    border-bottom: 2px solid #e8eaff;
    background: #ffffff;
    position: sticky;
    top: 0;
    z-index: 10;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .iv-wish-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 16px 24px;
    font-size: 14px;
    font-weight: 700;
    color: #888;
    cursor: pointer;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    transition: all 0.2s ease;
    white-space: nowrap;
    background: none;
    border-top: none;
    border-left: none;
    border-right: none;
  }
  .iv-wish-tab:hover { color: #ffc72f; }
  .iv-wish-tab.active { color: #ffc72f; border-bottom-color: #ffc72f; }
  .iv-wish-tab__icon { font-size: 18px; }
  .iv-wish-tab__count {
    background: #31378F;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 10px;
    min-width: 20px;
    text-align: center;
  }
  .iv-wish-panels { max-width: 1200px; margin: 0 auto; padding: 40px 20px; }
  .iv-wish-panel { display: none; }
  .iv-wish-panel.active { display: block; }
  .iv-wish-how {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin: 0 0 40px 0;
  }
  .iv-wish-how__step {
    background: linear-gradient(135deg, #0a0e2e, #1a1f5e);
    border-radius: 8px;
    padding: 24px 20px;
    text-align: center;
  }
  .iv-wish-how__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: #ffc72f;
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 900;
    border-radius: 50%;
    margin: 0 auto 12px;
  }
  .iv-wish-how__icon { font-size: 28px; margin: 0 0 10px 0; display: block; }
  .iv-wish-how__title { color: #ffffff; font-size: 14px; font-weight: 700; margin: 0 0 6px 0; }
  .iv-wish-how__sub { color: rgba(255,255,255,0.6); font-size: 12px; margin: 0; line-height: 1.5; }
  .iv-wish-table-wrap { overflow-x: auto; border-radius: 8px; border: 1px solid #e8eaff; }
  .iv-wish-table { width: 100%; border-collapse: collapse; }
  .iv-wish-table thead tr { background: linear-gradient(135deg, #0a0e2e, #1a1f5e); }
  .iv-wish-table thead th {
    padding: 14px 16px;
    font-size: 11px;
    font-weight: 700;
    color: rgba(255,255,255,0.7);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-align: left;
    white-space: nowrap;
  }
  .iv-wish-table thead th:last-child { text-align: center; }
  .iv-wish-table tbody tr { border-bottom: 1px solid #e8eaff; transition: background 0.15s ease; }
  .iv-wish-table tbody tr:hover { background: #f8f9ff; }
  .iv-wish-table tbody tr:last-child { border-bottom: none; }
  .iv-wish-table td { padding: 16px; vertical-align: middle; }
  .iv-wish-table td.iv-wish-td-img { width: 90px; }
  .iv-wish-table td.iv-wish-td-img img {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 6px;
    display: block;
  }
  .iv-wish-table td.iv-wish-td-name a {
    font-size: 14px;
    font-weight: 700;
    color: #0a0e2e;
    text-decoration: none;
  }
  .iv-wish-table td.iv-wish-td-name a:hover { color: #ffc72f; }
  .iv-wish-table td.iv-wish-td-price { font-size: 15px; font-weight: 700; color: #31378F; white-space: nowrap; }
  .iv-wish-table td.iv-wish-td-action { white-space: nowrap; }
  .iv-wish-table td.iv-wish-td-remove { text-align: center; }
  .iv-wish-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    background: #ffc72f;
    color: #1a1a1a;
    font-size: 13px;
    font-weight: 700;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .iv-wish-btn:hover { background: #31378F; color: #ffffff; }
  .iv-wish-remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: #fff0f0;
    border: 1px solid #ffcccc;
    border-radius: 4px;
    color: #c0392b;
    font-size: 14px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .iv-wish-remove:hover { background: #c0392b; color: #ffffff; border-color: #c0392b; }
  .iv-wish-empty { text-align: center; padding: 60px 20px; }
  .iv-wish-empty__icon { font-size: 64px; margin: 0 0 16px 0; display: block; }
  .iv-wish-empty__title { font-size: 22px; font-weight: 800; color: #0a0e2e; margin: 0 0 10px 0; }
  .iv-wish-empty__sub { font-size: 15px; color: #666; margin: 0 0 24px 0; }
  .iv-wish-empty__links { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .iv-wish-empty__link {
    display: inline-block;
    padding: 10px 20px;
    background: linear-gradient(135deg, #31378F, #1a1f5e);
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .iv-wish-empty__link:hover { background: linear-gradient(135deg, #ffc72f, #e6b000); color: #1a1a1a; }
  .iv-wish-dl-hero {
    background: linear-gradient(135deg, #0a0e2e, #1a1f5e);
    border-radius: 8px;
    padding: 28px 32px;
    margin: 0 0 32px 0;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .iv-wish-dl-hero__icon { font-size: 48px; flex-shrink: 0; }
  .iv-wish-dl-hero__title { color: #ffc72f; font-size: 20px; font-weight: 800; margin: 0 0 6px 0; }
  .iv-wish-dl-hero__sub { color: rgba(255,255,255,0.7); font-size: 14px; margin: 0; line-height: 1.6; }
  .iv-wish-dl-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 24px;
    background: #ffc72f;
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 700;
    border-radius: 4px;
    text-decoration: none;
    white-space: nowrap;
    margin-left: auto;
    transition: all 0.2s ease;
  }
  .iv-wish-dl-hero__btn:hover { background: #ffffff; }
  .iv-wish-dl-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 28px 0;
  }
  .iv-wish-dl-cat {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: #f8f9ff;
    border: 1px solid #e8eaff;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
    flex: 1;
    min-width: 160px;
  }
  .iv-wish-dl-cat:hover { background: #31378F; border-color: #31378F; }
  .iv-wish-dl-cat:hover .iv-wish-dl-cat__name { color: #ffffff; }
  .iv-wish-dl-cat:hover .iv-wish-dl-cat__sub { color: rgba(255,255,255,0.7); }
  .iv-wish-dl-cat__icon { font-size: 24px; flex-shrink: 0; }
  .iv-wish-dl-cat__name { font-size: 13px; font-weight: 700; color: #0a0e2e; margin: 0 0 2px 0; }
  .iv-wish-dl-cat__sub { font-size: 11px; color: #888; margin: 0; }
  .iv-wish-dl-section-title {
    font-size: 16px;
    font-weight: 800;
    color: #0a0e2e;
    margin: 0 0 16px 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .iv-wish-dl-section-title::after { content: ''; flex: 1; height: 1px; background: #e8eaff; }
  .iv-wish-dl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
    margin: 0 0 40px 0;
  }
  .iv-wish-dl-card {
    background: #ffffff;
    border: 1px solid #e8eaff;
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.2s ease;
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }
  .iv-wish-dl-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(49,55,143,0.12); border-color: #ffc72f; }
  .iv-wish-dl-card__img {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    display: block;
    background: #f8f9ff;
  }
  .iv-wish-dl-card__body { padding: 14px; flex: 1; display: flex; flex-direction: column; }
  .iv-wish-dl-card__tag {
    display: inline-block;
    background: rgba(49,55,143,0.08);
    color: #31378F;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 3px;
    margin: 0 0 8px 0;
  }
  .iv-wish-dl-card__title { font-size: 13px; font-weight: 700; color: #0a0e2e; margin: 0 0 4px 0; line-height: 1.4; }
  .iv-wish-dl-card__sub { font-size: 11px; color: #888; margin: 0 0 12px 0; flex: 1; }
  .iv-wish-dl-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 10px;
    border-top: 1px solid #f0f0f0;
  }
  .iv-wish-dl-card__price { font-size: 14px; font-weight: 800; color: #31378F; }
  .iv-wish-dl-card__price.free { color: #1a7a4a; }
  .iv-wish-dl-card__btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    background: #ffc72f;
    color: #1a1a1a;
    font-size: 11px;
    font-weight: 700;
    border-radius: 3px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .iv-wish-dl-card__btn:hover { background: #31378F; color: #ffffff; }
  .iv-wish-dl-free-banner {
    background: linear-gradient(135deg, #1a7a4a, #0f5c38);
    border-radius: 8px;
    padding: 20px 24px;
    margin: 0 0 28px 0;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .iv-wish-dl-free-banner__icon { font-size: 32px; flex-shrink: 0; }
  .iv-wish-dl-free-banner__title { color: #ffffff; font-size: 16px; font-weight: 800; margin: 0 0 4px 0; }
  .iv-wish-dl-free-banner__sub { color: rgba(255,255,255,0.75); font-size: 13px; margin: 0; }
  .iv-wish-dl-free-banner__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    background: #ffffff;
    color: #1a7a4a;
    font-size: 13px;
    font-weight: 700;
    border-radius: 4px;
    text-decoration: none;
    margin-left: auto;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .iv-wish-dl-free-banner__btn:hover { background: #ffc72f; color: #1a1a1a; }
  @media (max-width: 768px) {
    .iv-wish-hero { padding: 40px 16px 36px; }
    .iv-wish-tabs { overflow-x: auto; padding: 0 16px; gap: 0; }
    .iv-wish-tab { padding: 14px 16px; font-size: 13px; }
    .iv-wish-panels { padding: 24px 16px; }
    .iv-wish-dl-hero { padding: 20px; }
    .iv-wish-dl-hero__btn { margin-left: 0; width: 100%; justify-content: center; }
    .iv-wish-table td.iv-wish-td-img { width: 70px; }
    .iv-wish-table td.iv-wish-td-img img { width: 60px; height: 60px; }
  }
  @media (max-width: 576px) {
    .iv-wish-table thead { display: none; }
    .iv-wish-table tbody tr { display: block; padding: 16px; }
    .iv-wish-table td { display: block; padding: 4px 0; border: none; width: 100%; }
    .iv-wish-table td.iv-wish-td-img { margin-bottom: 8px; }
    .iv-wish-dl-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; }
  }
{%- endstyle -%}

<div class="iv-wish-page">

  <div class="iv-wish-hero">
    <div class="iv-wish-hero__badge">🔐 Your Personal Vault</div>
    <h1 class="iv-wish-hero__title">Your Anime <span>Wishlist</span> & Downloads Vault</h1>
    <p class="iv-wish-hero__sub">Save your favorite S-Rank gear for later. Access exclusive printable coloring books. Plan your haul. Color your world.</p>
    <div class="iv-wish-hero__msg">
      "Welcome to your personal Vault. 🔐✨ This is the safehouse where your S-Rank desires live until you are ready to strike. True collectors plan their raids carefully — save your must-haves, track your haul, and enjoy exclusive free coloring downloads while you prep. <strong>Plan your loot. Color your world. 🎨⚔️</strong>"
    </div>
  </div>

  <div class="iv-wish-tabs">
    <button class="iv-wish-tab active" data-tab="wishlist">
      <span class="iv-wish-tab__icon">⚔️</span>
      My Wishlist
    </button>
    <button class="iv-wish-tab" data-tab="downloads">
      <span class="iv-wish-tab__icon">🎨</span>
      Coloring Downloads
    </button>
  </div>

  <div class="iv-wish-panels">

    <div class="iv-wish-panel active" id="iv-panel-wishlist">
      <div class="iv-wish-how">
        <div class="iv-wish-how__step">
          <span class="iv-wish-how__num">1</span>
          <span class="iv-wish-how__icon">🛍️</span>
          <p class="iv-wish-how__title">Browse & Save</p>
          <p class="iv-wish-how__sub">Click the heart icon on any product to add it to your vault</p>
        </div>
        <div class="iv-wish-how__step">
          <span class="iv-wish-how__num">2</span>
          <span class="iv-wish-how__icon">📋</span>
          <p class="iv-wish-how__title">Plan Your Haul</p>
          <p class="iv-wish-how__sub">Review your saved gear and prioritize what to grab first</p>
        </div>
        <div class="iv-wish-how__step">
          <span class="iv-wish-how__num">3</span>
          <span class="iv-wish-how__icon">🎁</span>
          <p class="iv-wish-how__title">Share the List</p>
          <p class="iv-wish-how__sub">Send your wishlist to friends and family for gifts and holidays</p>
        </div>
        <div class="iv-wish-how__step">
          <span class="iv-wish-how__num">4</span>
          <span class="iv-wish-how__icon">⚡</span>
          <p class="iv-wish-how__title">Strike Fast</p>
          <p class="iv-wish-how__sub">Limited drops sell out fast — add to cart before they are gone</p>
        </div>
      </div>

      <div class="cart-main-area">
        <form action="#">
          <div class="iv-wish-table-wrap dT_WishListGrid" id="dT_WishListGrid">
            <div class="iv-wish-empty" v-if="isNoRecords">
              <span class="iv-wish-empty__icon">🗡️</span>
              <h3 class="iv-wish-empty__title">Your Vault is Empty, Warrior</h3>
              <p class="iv-wish-empty__sub">No loot saved yet. Start browsing and hit the heart icon on anything you want to save for later.</p>
              <div class="iv-wish-empty__links">
                <a href="/collections/mans-anime-merch-streetwear-gear-collectibles" class="iv-wish-empty__link">⚔️ Man's Merch</a>
                <a href="/collections/womens-anime-merch-cute-trendy-gear-kawaii" class="iv-wish-empty__link">🌸 Women's Merch</a>
                <a href="/collections/kids-anime-merch-cool-clothes-toys-gifts" class="iv-wish-empty__link">🎮 Kids Merch</a>
                <a href="/collections/anime-accessories-figures-phone-cases-wall-art-decor" class="iv-wish-empty__link">📱 Accessories</a>
                <a href="/collections/big-anime-sale-clearance-discounts-merch-collectibles" class="iv-wish-empty__link">⚡ Big Sale</a>
              </div>
            </div>
            <div v-else>
              <table class="iv-wish-table">
                <thead>
                  <tr>
                    <th>Item</th>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Action</th>
                    <th>Remove</th>
                  </tr>
                </thead>
                <tbody>
                  <template v-for="(item, i) in wishList">
                    <template v-if="item.product_handle">
                      <tr :id="'row_'+item.product_handle">
                        <td class="iv-wish-td-img">
                          <a :href="item.product_url">
                            <img :src="item.product_image" :alt="item.product_title" loading="lazy">
                          </a>
                        </td>
                        <td class="iv-wish-td-name">
                          <a :href="item.product_url">${ item.product_title }</a>
                        </td>
                        <td class="iv-wish-td-price">
                          <span v-html="item.money_price">${ item.money_price }</span>
                        </td>
                        <td class="iv-wish-td-action">
                          <a :href="item.product_url" class="iv-wish-btn" :data-product-varient-id="item.variant_id">
                            🛒 {{ 'products.product.select_options' | t }}
                          </a>
                        </td>
                        <td class="iv-wish-td-remove">
                          <a href="javascript:void(0);" class="iv-wish-remove" :data-product_handle="item.product_handle" v-on:click="remove(item.product_handle)" title="Remove from wishlist">
                            <i class="fa fa-trash"></i>
                          </a>
                        </td>
                      </tr>
                    </template>
                    <template v-else>
                      <tr>
                        <td colspan="5" style="text-align:center; padding:20px; color:#888; font-size:14px;">{{ 'products.wishlist.no_records' | t }}</td>
                      </tr>
                    </template>
                  </template>
                </tbody>
              </table>
            </div>
          </div>
        </form>
      </div>
    </div>

    <div class="iv-wish-panel" id="iv-panel-downloads">
      <div class="iv-wish-dl-hero">
        <span class="iv-wish-dl-hero__icon">🎨</span>
        <div>
          <p class="iv-wish-dl-hero__title">Exclusive Anime Coloring Books & Pages</p>
          <p class="iv-wish-dl-hero__sub">High-resolution line art featuring your favorite heroes. Download instantly, print at home, and bring them to life with your own colors.</p>
        </div>
        <a href="/collections/coloring-books-for-all-ages-infinite-visibility" class="iv-wish-dl-hero__btn">Browse All →</a>
      </div>

      <div class="iv-wish-dl-free-banner">
        <span class="iv-wish-dl-free-banner__icon">🎁</span>
        <div>
          <p class="iv-wish-dl-free-banner__title">Free Coloring Pages — No Purchase Needed</p>
          <p class="iv-wish-dl-free-banner__sub">Grab free printable anime coloring pages as a thank you from the Infinite Visibility guild.</p>
        </div>
        <a href="/collections/free-coloring-pages-for-all-ages" class="iv-wish-dl-free-banner__btn">🎁 Get Free Pages</a>
      </div>

      <p class="iv-wish-dl-section-title">Browse by Category</p>
      <div class="iv-wish-dl-categories">
        <a href="/collections/anime-and-manga-characters-coloring-book" class="iv-wish-dl-cat">
          <span class="iv-wish-dl-cat__icon">⚔️</span>
          <div>
            <p class="iv-wish-dl-cat__name">Anime Characters</p>
            <p class="iv-wish-dl-cat__sub">One Piece, Naruto, JJK & more</p>
          </div>
        </a>
        <a href="/collections/enchanted-anime-waifu-girls-coloring-book-downloads" class="iv-wish-dl-cat">
          <span class="iv-wish-dl-cat__icon">🌸</span>
          <div>
            <p class="iv-wish-dl-cat__name">Anime Girls</p>
            <p class="iv-wish-dl-cat__sub">Waifu & girl character books</p>
          </div>
        </a>
        <a href="/collections/kids-coloring-books-amazing-printable-adventures" class="iv-wish-dl-cat">
          <span class="iv-wish-dl-cat__icon">🎮</span>
          <div>
            <p class="iv-wish-dl-cat__name">Kids Coloring Books</p>
