{%- liquid
  assign margin = section.settings.margin | split: ','
  assign margin_top = margin[0]
  assign margin_bottom = margin[1]
  assign padding = section.settings.padding | split: ','
  assign padding_top = padding[0]
  assign padding_bottom = padding[1]
  
  if section.settings.enable_overlay
  assign overlay_class = 'dt-sc-overlay'
  endif

  if section.settings.block_banner_style == 'grid'
  assign grid_style = 'grid-style'
  elsif section.settings.block_banner_style == 'list'
  assign list_style = 'list-style'
  elsif section.settings.block_banner_style == 'overlay'
  assign overlay_style = 'overlay-style'
  endif
  
  case section.settings.grid
  when '1'
  assign column = 'one-column'
  when '2'
  assign column = 'two-column'
  when '3'
  assign column = 'three-column'              
  assign column = 'four-column'           
   when '5'
  assign column = 'five-column'  
  when '6'
  assign column = 'six-column'  
  else
  assign column = 'five-column'              
  endcase %}
{% if section.settings.show_background_image %}
  {% assign lazyScript = "lazyload" %}
{% endif %}
{% if section.settings.enable_slider %}
  <div
    data-section-id="{{ section.id }}"
    data-section-type="home-grid-slider"
    data-item-per-view="{{ section.settings.items_per_view }}"
    data-laptop-screen-items="{{ section.settings.items_laptop_view }}"
    data-tablet-screen-items="{{ section.settings.items_tablet_view }}"
    data-small-screen-items="{{ section.settings.items_mobile_view }}"
    data-autoplay="{{ section.settings.slider_autoplay }}"
    data-blocks-limit="{{ section.blocks.size }}"
    data-item-space="{{ section.settings.column_gap }}"
    data-center-mode="{{ section.settings.enable_center_mode }}"
    data-auto-height="{{ section.settings.enable_auto_height }}">
  <!-- data-center-mode="{{ block.settings.enable_center_mode }}"  -->
  {% endif %}
  <div
    class="dt-sc-section-wrapper  {{ lazyScript }} {{ overlay_class }} {% if section.settings.background_style == 'parallax' %} parallax-initiated{% endif %}"
    {% if section.settings.background_style == 'parallax' %}
    data-speed="2"
    data-style="parallax"
    {% endif %}
    style="{% render 'bg-color-image-padding' %} background-size: {{ section.settings.background_size }}; {% if section.settings.background_style == 'fixed' %}background-attachment: fixed;{% endif %} background-repeat:{% if section.settings.background_size == 'repeat' %}repeat{% else %}no-repeat;{% endif %}"
    {% render 'bg_image' %}>
    <div class="{% render 'container-settings' %}">
      <div class="row {{ section.settings.custom_class_name }}">
        {% render 'section-heading', class: section.id %}
        <div class="inline-block">
          <div class="dt-sc-featured-collection-section dt-sc-column ">
            {%- liquid
            assign featured = section.settings.collection
          
if collections[featured].image
assign collection_image = collections[featured].image
else
assign collection_image = collections[featured].products.first.featured_image
endif
%}

            {% capture collection_title %}
              {{ collections[featured].title | escape }}{% endcapture %}
            {% capture collection_link %}
              {{ collections[featured].url | escape }}{% endcapture %}
            {% capture collection_desc %}
              {{ collections[featured].description | strip_html | truncate: 100 }}{% endcapture %}
            {% capture collection_count %}
              {{ collections[featured].all_products_count | escape }}{% endcapture %}

            <div class="dt-sc-collection-banner {% if section.settings.enable_box_shadow %}dt-sc-box-shadow{% endif %} {% if section.settings.enable_slider %}swiper-slide{% endif %}  {{ block.type }}-{{ block.id }} {% if block.settings.reverse_column %}dt-sc-reverse-columns{% endif %}">
              {% if featured != blank %}
                {% if collections[featured].image or collections[featured].products.first.featured_image %}
                  <div class="dt-sc-collection-banner-image">
                    <a href="{{ collection_link }}" class="{{ overlay_class }}">
                      <img
                        srcset="{%- if collection_image.width >= 375 -%}
                        {{ collection_image | image_url: width: 375 }} 375w,{%- endif -%}
                      {%- if collection_image.width >= 550 -%}
                        {{ collection_image | image_url: width: 550 }} 550w,{%- endif -%}
                      {%- if collection_image.width >= 750 -%}
                        {{ collection_image | image_url: width: 750 }} 750w,{%- endif -%}
                      {%- if collection_image.width >= 1100 -%}
                        {{ collection_image | image_url: width: 1100 }} 1100w,{%- endif -%}
                      {%- if collection_image.width >= 1500 -%}
                        {{ collection_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                      {%- if collection_image.width >= 1780 -%}
                        {{ collection_image | image_url: width: 1780 }} 1780w,{%- endif -%}
                      {%- if collection_image.width >= 2000 -%}
                        {{ collection_image | image_url: width: 2000 }} 2000w,{%- endif -%}
                      {%- if collection_image.width >= 3000 -%}
                        {{ collection_image | image_url: width: 3000 }} 3000w,{%- endif -%}
                      {%- if collection_image.width >= 3840 -%}
                        {{ collection_image | image_url: width: 3840 }} 3840w,{%- endif -%}
                      {{ collection_image | image_url }} {{ collection_image.width }}w"
                      sizes="100vw"
                      src="{{ collection_image | image_url: width: 1500 }}"
                      loading="lazy"
                      alt="{{ collection_image.alt | escape }}"
                      width="{{ collection_image.width }}"
                      height="{{ collection_image.width | divided_by: collection_image.aspect_ratio | round }}">
                    </a>
                  </div>
                {% endif %}
              {% endif %}
              {% if collection_title != blank or collection_count != blank or collection_desc != blank %}
                <div
                  class='dt-sc-collection-banner-content
                  {% unless section.settings.block_banner_style == 'grid' %}
                    {{ block.settings.content_position }}{% endunless %}
                  {% if section.settings.block_banner_style == 'grid' %}
                    {{ block.settings.block_text_align }}{% endif %}'>
                  {% unless section.settings.block_banner_style == 'grid' %}
                    <div class="dt-sc-collection-banner-inner {{ block.settings.block_text_align }}">
                    {% endunless %}
                    {% if collection_title != blank %}

                      <h4 class="dt-sc-main-title">
                        <a href="{{ collection_link }}">{{ collection_title }}</a>
                      </h4>

                    {% endif %}

                    {% if collection_desc != blank %}
                      <p class="dt-sc-description">{{ collection_desc }}</p>
                    {% endif %}
                    {% if collection_link != blank %}
                      <a href="{{ collection_link }}" class="dt-sc-btn">{{ section.settings.block_button_text }}</a>
                    {% endif %}
                    {% unless section.settings.block_banner_style == 'grid' %}
                    </div>
                  {% endunless %}
                </div>
              {% endif %}
            </div>

          </div>
          <div class="image-bar__section">
            {%- if section.blocks.size > 0 -%}
              {% if section.settings.enable_slider %}
                <div class="dt-sc-swiper-slider swiper-container {% if section.settings.dots %} {{ section.settings.carousel_pagination_alignment }} {% endif %} {% if section.settings.arrows %}  {{ section.settings.nav_arrow_position }} {{ section.settings.center_nav_arrow_alignment }} {% endif %}">
                {% endif %}
                {% if section.settings.enable_slider %}
                  <div id="swiper-{{ section.id }}-slider" class="{{ section.settings.block_style }}">
                  {% endif %}
                  <ul class="image-bar__section-inner {% if section.settings.enable_slider %}swiper-wrapper{% endif %}  {% unless section.settings.enable_slider %} dt-sc-column {{ column }} {% endunless %}">
                    {%- for block in section.blocks -%}
                      <li class="image-bar__item {% if section.settings.enable_slider %}swiper-slide{% endif %}" {{ block.shopify_attributes }}>

                        {%- if block.settings.image != blank -%}
                          <img
                            srcset="{%- if block.settings.image.width >= 375 -%}
                            {{ block.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
                          {%- if block.settings.image.width >= 550 -%}
                            {{ block.settings.image | image_url: width: 550 }} 550w,{%- endif -%}
                          {%- if block.settings.image.width >= 750 -%}
                            {{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                          {%- if block.settings.image.width >= 1100 -%}
                            {{ block.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
                          {%- if block.settings.image.width >= 1500 -%}
                            {{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                          {%- if block.settings.image.width >= 1780 -%}
                            {{ block.settings.image | image_url: width: 1780 }} 1780w,{%- endif -%}
                          {%- if block.settings.image.width >= 2000 -%}
                            {{ block.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
                          {%- if block.settings.image.width >= 3000 -%}
                            {{ block.settings.image | image_url: width: 3000 }} 3000w,{%- endif -%}
                          {%- if block.settings.image.width >= 3840 -%}
                            {{ block.settings.image | image_url: width: 3840 }} 3840w,{%- endif -%}
                          {{ block.settings.image | image_url: width: 1500 }} {{ block.settings.image.width }}w"
                          sizes="100vw"
                          src="{{ block.settings.image | image_url: width: 1500 }}"
                          loading="lazy"
                          alt="{{ block.settings.image.alt | escape }}"
                          width="{{ block.settings.image.width }}"
                          height="{{ block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round }}">

                        {%- else -%}
                          {{ 'image' | placeholder_svg_tag }}
                        {%- endif -%}

                        {% if section.settings.enable_content %}
                          <div class="image-gallery-Content">


                            {%- if block.settings.overlay_sub_title != blank -%}
                              <h6 class="image-overlay-sub-title">{{ block.settings.overlay_sub_title }}</h6>
                            {%- endif -%}
                            {%- if block.settings.overlay_title != blank -%}
                              <h2 class="image-overlay-title">{{ block.settings.overlay_title }}</h2>
                            {%- endif -%}
                            {% if block.settings.link != blank and block.settings.link_text != blank %}
                              <a href="{{ section.settings.section_button_link }}" class="dt-sc-btn ">{{ block.settings.link_text }}</a>
                            {% endif %}

                          </div>
                        {% endif %}


                      </li>
                    {%- endfor -%}
                  </ul>
                  {% if section.settings.enable_slider %}
                  </div>
                {% endif %}
                {% if section.settings.enable_slider %}
                  <div class="swiper-scrollbar"></div>
                  {% if section.settings.arrows %}
                    <div class="swiper-{{ section.id }}-arrows swiper-arrows">
                      <div id="swiper-{{ section.id }}-next" class="swiper-button-next dt-sc-btn"></div>
                      <div id="swiper-{{ section.id }}-prev" class="swiper-button-prev dt-sc-btn"></div>
                    </div>
                  {% endif %}
                  {% if section.settings.dots %}
                    <div id="swiper-{{ section.id }}-pagination" class="swiper-pagination"></div>
                  {% endif %}
                {% endif %}
                {% if section.settings.enable_slider %}
                </div>
              {% endif %}
            {%- endif -%}
          </div>
          <div class="dt-sc-featured-collection-section dt-sc-column ">
            {%- liquid
            assign featured = section.settings.collection_2
           
if collections[featured].image
assign collection_image = collections[featured].image
else
assign collection_image = collections[featured].products.first.featured_image
endif
%}

            {% capture collection_title %}
              {{ collections[featured].title | escape }}{% endcapture %}
            {% capture collection_link %}
              {{ collections[featured].url | escape }}{% endcapture %}
            {% capture collection_desc %}
              {{ collections[featured].description | strip_html | truncate: 100 }}{% endcapture %}
            {% capture collection_count %}
              {{ collections[featured].all_products_count | escape }}{% endcapture %}

            <div class="dt-sc-collection-banner dt-sc-collection-banner-2 {% if section.settings.enable_box_shadow %}dt-sc-box-shadow{% endif %} {% if section.settings.enable_slider %}swiper-slide{% endif %} {{ grid_style }} {{ list_style }} {{ overlay_style }} {{ block.type }}-{{ block.id }} {% if block.settings.reverse_column %}dt-sc-reverse-columns{% endif %}">
              {% if featured != blank %}
                {% if collections[featured].image or collections[featured].products.first.featured_image %}
                  <div class="dt-sc-collection-banner-image">
                    <a href="{{ collection_link }}" class="{{ overlay_class }}">
                      <img
                        srcset="{%- if collection_image.width >= 375 -%}
                        {{ collection_image | image_url: width: 375 }} 375w,{%- endif -%}
                      {%- if collection_image.width >= 550 -%}
                        {{ collection_image | image_url: width: 550 }} 550w,{%- endif -%}
                      {%- if collection_image.width >= 750 -%}
                        {{ collection_image | image_url: width: 750 }} 750w,{%- endif -%}
                      {%- if collection_image.width >= 1100 -%}
                        {{ collection_image | image_url: width: 1100 }} 1100w,{%- endif -%}
                      {%- if collection_image.width >= 1500 -%}
                        {{ collection_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                      {%- if collection_image.width >= 1780 -%}
                        {{ collection_image | image_url: width: 1780 }} 1780w,{%- endif -%}
                      {%- if collection_image.width >= 2000 -%}
                        {{ collection_image | image_url: width: 2000 }} 2000w,{%- endif -%}
                      {%- if collection_image.width >= 3000 -%}
                        {{ collection_image | image_url: width: 3000 }} 3000w,{%- endif -%}
                      {%- if collection_image.width >= 3840 -%}
                        {{ collection_image | image_url: width: 3840 }} 3840w,{%- endif -%}
                      {{ collection_image | image_url }} {{ collection_image.width }}w"
                      sizes="100vw"
                      src="{{ collection_image | image_url: width: 1500 }}"
                      loading="lazy"
                      alt="{{ collection_image.alt | escape }}"
                      width="{{ collection_image.width }}"
                      height="{{ collection_image.width | divided_by: collection_image.aspect_ratio | round }}">
                    </a>
                  </div>
                {% endif %}
              {% endif %}
              {% if collection_title != blank or collection_count != blank or collection_desc != blank %}
                <div
                  class='dt-sc-collection-banner-content
                  {% unless section.settings.block_banner_style == 'grid' %}
                    {{ block.settings.content_position }}{% endunless %}
                  {% if section.settings.block_banner_style == 'grid' %}
                    {{ block.settings.block_text_align }}{% endif %}'>
                  {% unless section.settings.block_banner_style == 'grid' %}
                    <div class="dt-sc-collection-banner-inner {{ block.settings.block_text_align }}">
                    {% endunless %}
                    {% if collection_title != blank %}

                      <h4 class="dt-sc-main-title">
                        <a href="{{ collection_link }}">{{ collection_title }}</a>
                      </h4>

                    {% endif %}
                    {% if collection_desc != blank %}
                      <p class="dt-sc-description">{{ collection_desc }}</p>
                    {% endif %}
                    {% if collection_link != blank %}
                      <a href="{{ collection_link }}" class="dt-sc-btn">{{ section.settings.block_button_text_2 }}</a>
                    {% endif %}
                    {% unless section.settings.block_banner_style == 'grid' %}
                    </div>
                  {% endunless %}
                </div>
              {% endif %}
            </div>

          </div>
        </div>

      </div>
    </div>
    {% if section.settings.enable_slider %}
    </div>
  {% endif %}
</div>
<style>
  #shopify-section-{{ section.id }}.home-grid-slider .dt-sc-heading .dt-sc-main-heading {
    color: var(--DTColor_Heading);
    color: {{ section.settings.section_heading_color }}
    ;
  }
  #shopify-section-{{ section.id }}.home-grid-slider .dt-sc-heading .dt-sc-sub-heading {
    color: var(--DTColor_Heading);
    color: {{ section.settings.section_sub_heading_color }}
    ;
  }
  #shopify-section-{{ section.id }}.home-grid-slider .dt-sc-heading .dt-sc-heading-description {
    color: var(--DTColor_Body);
    color: {{ section.settings.section_description_color }}
    ;
  }
  #shopify-section-{{ section.id }}.home-grid-slider .dt-sc-heading .dt-sc-btn {
    background: var(--DT_Button_BG_Color);
    background: {{ section.settings.section_button_bg_color }}
    ;
    color: var(--DT_Button_Text_Color);
    color: {{ section.settings.section_button_text_color }}
    ;
  }
  #shopify-section-{{ section.id }}.home-grid-slider .dt-sc-heading .dt-sc-btn:hover {
    background: var(--DT_Button_BG_Hover_Color);
    background: {{ section.settings.section_button_hover_bg_color }}
    ;
    color: var(--DT_Button_Text_Hover_Color);
    color: {{ section.settings.section_button_hover_text_color }}
    ;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .dt-sc-overlay:before {
    color: var(--DTTertiaryColor);
    color: {{ section.settings.background_color }}
    ;
    background: currentcolor;
    opacity: {{ section.settings.overlay_transparency }}
    ;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item {
    /* margin-right: 50px; */
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    text-align: center;
    height: {{ section.settings.item_height }}px;
    position: relative;
    width: 100% !important;


  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item .image-gallery-content {
    position: absolute;
    height: 100%;
    width: 100%;
    display: grid;
    align-content: center;
    justify-content: center;
    top: 0;
    left: 0;
    /* background: {{ settings.primary_color | color_modify: 'alpha', 0.5 }}; */
    flex-direction: column;
    gap: 15px;
    /* background: {{ section.settings.image_overlay_color | color_modify: 'alpha', 0.5 }};*/
    opacity: 0;
    transition: var(--DTBaseTransition);
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item:hover .image-gallery-content {
    opacity: 1;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item .image-gallery-content > * {
    color: var(--DT_Button_Text_Color);
    color: {{ section.settings.image_overlay_icon_color }};
    font-size: var(--DTFontSizeBase);
    font-size: {{ section.settings.icon_size }}px;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item .image-gallery-content > * {
    margin: 0;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item .image-gallery-content .image-overlay-title {
    position: relative;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item .image-gallery-content .image-overlay-title:before,
  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item .image-gallery-content .image-overlay-title:after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    background-color: currentcolor;
    height: 2px;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item .image-gallery-content .image-overlay-title:before {
    width: 0;
    transition: width ease 0.4s;
    -webkit-transition: width ease 0.4s;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item .image-gallery-content .image-overlay-title:after {
    width: 100%;
    transition: all ease 0.6s;
    -webkit-transition: all ease 0.6s;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item .image-gallery-content .image-overlay-title:hover::before {
    width: 100%;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item .image-gallery-content .image-overlay-title:hover::after {
    left: 100%;
    width: 0;
    transition: all ease 0.2s;
    -webkit-transition: all ease 0.2s;
  }


  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item a, #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item a {
    border-radius: 0;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item svg {
    min-width: 150px;
    height: auto;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__section {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__section .image-bar__section-inner {
    margin: 0;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__section .dt-sc-image-list-btn {
    position: absolute;
    padding: 20px 80px;
    border-radius: var(--DTRadius);
    z-index: 1;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__section .dt-sc-image-list-btn {
    /*     background: var(--DT_Button_BG_Color); background-color: {{ section.settings.image_link_bg_color }}; */
    color: var(--DT_Button_Text_Color);
    color: {{ section.settings.image_link_text_color }}
    ;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__section .dt-sc-image-list-btn:hover {
    /*     background: var(--DT_Button_BG_Hover_Color);
    background-color: {{ section.settings.image_link_hover_bg_color }}; */
    color: var(--DT_Button_Text_Hover_Color);
    color: {{ section.settings.image_link_hover_text_color }}
    ;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__section-inner {
    gap: var(--DTGutter_Width);
    gap: {{ section.settings.column_gap }}
    px;
  }


  /*  Carousel Styles */

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__section .swiper-container {
    width: 100%;
    height:100%;
  }
  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__section .swiper-container [class*="swiper-container"] {
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__section .swiper-container [class*="swiper-container"] .image-bar__section-inner {
    gap: 0;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__section .swiper-container .swiper-arrows > .dt-sc-btn[class*="swiper-button-"] {
    background: var(--DT_Button_BG_Color);
    background: {{ section.settings.navigation_button_color | color_modify: 'alpha', 0.8 }}
    ;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__section .swiper-container .swiper-arrows > .dt-sc-btn[class*="swiper-button-"]:after {
    color: var(--DT_Button_Text_Color);
    color: {{ section.settings.navigation_button_icon_color }}
    ;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__section .swiper-container .swiper-arrows > .dt-sc-btn:hover {
    background: var(--DT_Button_BG_Hover_Color);
    background: {{ section.settings.navigation_button_hover_color | color_modify: 'alpha', 0.8 }}
    ;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__section .swiper-container .swiper-arrows > .dt-sc-btn:hover[class*="swiper-button-"]:after {
    color: var(--DT_Button_Text_Hover_Color);
    color: {{ section.settings.navigation_button_hover_icon_color }}
    ;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__section .swiper-container .swiper-pagination-bullet {
    background: var(--DTSecondaryColor);
    background: {{ section.settings.navigation_dot_color }}
    ;
  }

  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__section .swiper-container .swiper-pagination-bullet.swiper-pagination-bullet-active {
    background: var(--DTPrimaryColor);
    background: {{ section.settings.navigation_dot_active_color }}
    ;
  }



  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item .image-gallery-Content {
    top: 5rem;
    position: absolute;
    opacity: 1;
    padding: 0 20px;
    transition: var(--DTBaseTransition);
    left: 50px;
    text-align: left;
  }
  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item.swiper-slide-active .image-gallery-Content, /*   #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item:hover .image-gallery-Content{opacity:1;bottom:40px;} */


  #shopify-section-{{ section.id }}.home-grid-slider .image-bar__item .image-gallery-Content .image-overlay-sub-title {
    margin: 0;
