{% if section.settings.enable_slider %}
  <script type="text/javascript">
    function homeGridSlider(){
    var dataSectionType = $('[data-section-type="home-grid-slider"]');
                                                    var id = dataSectionType.attr('data-section-id');   
                                                        
                                                    var ItemsPerView = +dataSectionType.attr('data-item-per-view');
                                                    var ItemsSpace = +dataSectionType.attr('data-item-space');
                                                    var autoHeight = +dataSectionType.attr('data-auto-height') || false;
                                                    var ItemsLimit = +dataSectionType.attr('data-blocks-limit');
                                                    var ItemMode = +dataSectionType.attr('data-center-mode');
                                                    var Autoplay = +dataSectionType.attr('data-autoplay') * 1000;
                                                    var mobileSlides = +dataSectionType.attr('data-small-screen-items') || 1;
                                                    var initAutoplay = Autoplay ? {    delay: Autoplay  } : false;    
                                                    
                                                    console.log(dataSectionType);
                                                    
                                                    var swiper = new Swiper('#swiper-' + id + '-slider', {  
                                                      pagination: {
                                                        el: '#swiper-' + id + '-pagination',
                                                        clickable: true
                                                      },
                                                      navigation: {
                                                        nextEl: '#swiper-' + id + '-next',
                                                        prevEl: '#swiper-' + id + '-prev'
                                                      },
                                                      loop: true,          
                                                      autoHeight: autoHeight,    
                                                      simulateTouch: true,
                                                      centeredSlides: false,
                                                      autoplay: initAutoplay,
                                                      breakpoints: {
                                                        320: {
                                                          slidesPerView: 1,
                                                          spaceBetween: 0,
                                                        },
                                                        768: {
                                                         slidesPerView: 1,
                                                          spaceBetween: 0,
                                                        },
                                                        1024: {
                                                          slidesPerView: 1,
                                                          spaceBetween: 0,
                                                        },
                                                        1540: {
                                                          slidesPerView: 1,
                                                          spaceBetween: 0,
                                                        },
                                                      },
                                                    });
                                                  }
                                                  $(document).ready(function(){    
                                                    homeGridSlider();
                                                  })
                                                  $(document)
                                                  .on('shopify:section:load', homeGridSlider)
                                                  .on('shopify:section:unload', homeGridSlider)</script>
{% endif %}
