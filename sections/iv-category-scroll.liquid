<div class="iv-category-scroll-wrapper" data-section-id="{{ section.id }}">
  <div class="{% render 'container-settings' %}">
    {% render 'section-heading', class: section.id %}
    <div class="iv-category-scroll">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="iv-category-card glass-chip">
          <div class="iv-category-image">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 400 }}"
                   alt="{{ block.settings.title | escape }}"
                   loading="lazy"
                   width="400"
                   height="400">
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <div class="iv-category-info">
            <h3 class="iv-category-title">{{ block.settings.title }}</h3>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% style %}
  .iv-category-scroll-wrapper {
    padding: 60px 0;
    overflow: hidden;
  }
  .iv-category-scroll {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 20px;
    padding: 20px 0;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none;  /* IE and Edge */
  }
  .iv-category-scroll::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
  }
  .iv-category-card {
    flex: 0 0 280px;
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
    transition: transform var(--duration-ui) var(--ease-enter),
                box-shadow var(--duration-ui) var(--ease-enter);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 15px;
  }
  .iv-category-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(255, 199, 47, 0.35);
  }
  .iv-category-image {
    width: 100%;
    aspect-ratio: 1/1;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 15px;
  }
  .iv-category-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .iv-category-card:hover .iv-category-image img {
    transform: scale(1.05);
  }
  .iv-category-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-white);
  }

  @media (max-width: 767px) {
    .iv-category-card {
      flex: 0 0 220px;
    }
    .iv-category-scroll-wrapper {
        padding: 40px 0;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "IV Category Scroll",
  "settings": [
    { "type": "text", "id": "section_heading", "label": "Heading", "default": "Shop by Category" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Category" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "IV Category Scroll",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
