{%- liquid
  assign margin = section.settings.margin | split: ','
  assign margin_top = margin[0]
  assign margin_bottom = margin[1]
  assign padding = section.settings.padding | split: ','
  assign padding_top = padding[0]
  assign padding_bottom = padding[1]
  case section.settings.grid
    when '2'
      assign grid_item_width = 'two-column'
      assign imageSize = '767x767'
    when '3'
      assign grid_item_width = 'three-column'
      assign imageSize = '767x767'
    when '4'
      assign grid_item_width = 'four-column'
      assign imageSize = '767x767'
    when '5'
      assign grid_item_width = 'five-column'
      assign imageSize = '767x767'
    when '6'
      assign grid_item_width = 'six-column'
      assign imageSize = '767x767'
  endcase
-%}

{%- liquid
  assign collection_alt = collection.title
  assign collection_welcome = ''
  assign collection_meta_desc = collection.description | strip_html | truncatewords: 25
  if collection.handle contains 'mans-anime-merch'
    assign collection_alt = "A showcase of Man's Anime Merch including vintage washed t-shirts, hoodies, and action figures from Solo Leveling and Demon Slayer"
    assign collection_welcome = "Yo, King! Welcome to the ultimate armory at Infinite Visibility. Whether you're training to be the next Hokage, sailing for the One Piece, or just grinding dungeons in the real world, you need gear that keeps up. Stop wearing basic loot. It's time to upgrade your inventory with the hardest anime drops on the web. Let's get you suited up for greatness! Level up your lifestyle."
    assign collection_meta_desc = "Upgrade your inventory with premium Man's Anime Merch! Shop trending streetwear, figures, and tech gear from Naruto, One Piece & more. Free worldwide shipping. Explore now!"
  elsif collection.handle contains 'womens-anime-merch'
    assign collection_alt = "A collection of Women's Anime Merch featuring cute Anya Forger t-shirts, oversized Demon Slayer hoodies, and kawaii phone cases"
    assign collection_welcome = "Konnichiwa, Queen! Welcome to Infinite Visibility, your personal boutique for the cutest and fiercest looks in the anime world. Whether you're channeling your inner Magical Girl or suiting up like a Hashira, we believe your style should be as legendary as you are. Get ready to sparkle and slay! Unleash your inner Senpai!"
    assign collection_meta_desc = "Level up your aesthetic with our Women's Anime Merch! Shop cute tees, cozy hoodies, and kawaii accessories. Free worldwide shipping. Find your style now!"
  elsif collection.handle contains 'kids-anime-merch'
    assign collection_alt = "A colorful collection of Kids Anime Merch featuring One Piece hoodies for boys, K-Pop girl group tops, and cute Pokemon figures"
    assign collection_welcome = "Hey there, Little Heroes! Welcome to Infinite Visibility, the playground for the next generation of anime fans! Whether you're sending them off to the Ninja Academy (school) or on a Pokémon adventure in the backyard, we believe their gear should be as imaginative as they are. Let's power up their world! Start the adventure!"
    assign collection_meta_desc = "Power up playtime with our Kids Anime Merch! Shop durable hoodies, cute Pokemon toys, and room decor. Free worldwide shipping. The perfect gift for little fans!"
  elsif collection.handle contains 'anime-accessories'
    assign collection_alt = "A curated display of Anime Accessories featuring Solo Leveling phone cases, One Piece Luffy figures, and Demon Slayer wall art scrolls"
    assign collection_welcome = "Welcome to the Secret Item Shop! You've equipped the armor (clothes), now it's time to fill your inventory. At Infinite Visibility, we believe that true fandom lives in the details. From the phone in your hand to the art on your walls, we turn the mundane into the magical. Equip the best gear!"
    assign collection_meta_desc = "Upgrade your world with premium Anime Accessories! Shop shockproof phone cases, detailed figures, posters, and stickers. Free worldwide shipping. Customize your life now!"
  elsif collection.handle contains 'premium-anime-merchandise'
    assign collection_alt = "A vast collection of Premium Anime Merchandise displaying t-shirts, phone cases, and action figures from Naruto, One Piece, and Demon Slayer"
    assign collection_welcome = "Welcome to the Grand Archive! You have reached the source of all power at Infinite Visibility. Whether you are looking for armor (fashion), weapons (tech accessories), or rare treasures (collectibles), you will find it within these walls. Don't get lost in the sauce — use your map (filters) to navigate! The gate is open. Raid the dungeon!"
    assign collection_meta_desc = "Explore our complete collection of Premium Anime Merchandise! Shop trendy streetwear, figures, phone cases, and decor. Free worldwide shipping. The ultimate otaku shop."
  elsif collection.handle contains 'sale' or collection.handle contains 'clearance'
    assign collection_alt = "A promotional banner for the Big Anime Sale displaying discounted Naruto figures, One Piece hoodies, and Demon Slayer accessories"
    assign collection_welcome = "SYSTEM ALERT: Price Drop Detected! Welcome to the Infinite Visibility Treasure Room! You've stumbled upon a rare loot event. We're slashing prices like Zoro slashes enemies. But be warned: these deals are moving faster than a ninja using the Body Flicker Technique. Secure your loot before it vanishes!"
    assign collection_meta_desc = "Shop the Big Anime Sale at Infinite Visibility! Massive discounts on hoodies, figures & phone cases. Free worldwide shipping. Limited time offers. Save big now!"
  endif
-%}

<nav class="collection-breadcrumb" aria-label="breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
  <ol>
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a itemprop="item" href="{{ shop.url }}">
        <span itemprop="name">Home</span>
      </a>
      <meta itemprop="position" content="1">
    </li>
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <span itemprop="name">{{ collection.title }}</span>
      <meta itemprop="position" content="2">
    </li>
  </ol>
</nav>

{% capture collection_meta %}
<div class="collection-hero {{ section.settings.banner_position }}">
  <div class="collection-hero__image">
    <img
      srcset="{%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
        {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
        {%- if collection.image.width >= 535 -%}{{ collection.image | image_url: width: 535 }} 535w,{%- endif -%}
        {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
        {%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
        {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
        {{ collection.image | image_url }} {{ collection.image.width }}w"
      src="{{ collection.image | image_url: width: 750 }}"
      sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
      alt="{{ collection_alt }}"
      loading="eager"
      fetchpriority="high"
      width="{{ collection.image.width }}"
      height="{{ collection.image.height }}"
    >
  </div>
  <div class="hero-header">
    <h1 itemprop="name">{{ collection.title }}</h1>
    {%- if collection_welcome != '' -%}
    <div class="collection-welcome-message">
      <p>{{ collection_welcome }}</p>
    </div>
    {%- endif -%}
    {% if collection.description != blank %}
    <div class="rte collection-description" itemprop="description">
      {{ collection.description }}
    </div>
    {% endif %}
  </div>
</div>
{% endcapture %}

<div class="{% render 'container-settings' %}" data-section-id="{{ section.id }}" data-section-type="collection-template" itemscope itemtype="https://schema.org/CollectionPage">
  <meta itemprop="name" content="{{ collection.title | escape }}">
  <meta itemprop="description" content="{{ collection_meta_desc | escape }}">
  <meta itemprop="url" content="{{ shop.url }}/collections/{{ collection.handle }}">
  <div class="row">
    {% if section.settings.show_collection_image and collection.image and section.settings.banner_position == 'below-navigation' %}
    {{ collection_meta }}
    {% endif %}

    {% if section.settings.show_sub_collection %}
    <div class="show_sub_collection list-collection-products dt-sc-column {{ grid_item_width }}">
      {%- liquid
        assign collection_handle = collection.handle
        for link in linklists[collection_handle].links
          assign sub_collection = link.object
          assign featured = sub_collection.handle
          render 'collection-grid-item', featured: featured
        endfor
      %}
    </div>
    {% endif %}

    {%- liquid
      assign product_per_page = 36
    -%}

    {% paginate collection.products by product_per_page %}

    <div class="iv-filter-drawer" id="CollectionFilterDrawer" aria-hidden="true">
      <div class="iv-filter-drawer__panel" role="dialog" aria-modal="true" aria-label="Collection filters">
        <div class="iv-filter-drawer__header">
          <span>FILTERS</span>
          <button type="button" class="iv-filter-drawer__close" data-iv-filter-close aria-label="Close filters">&times;</button>
        </div>
        <div class="iv-filter-drawer__body">
          {% render 'collection-sidebar' %}
        </div>
      </div>
      <button type="button" class="iv-filter-drawer__overlay" data-iv-filter-close aria-label="Close filters"></button>
    </div>



    <div id="collection-template-query" class="no-sidebar iv-collection-full-width">
      <div class="collection-grid product-grid-height-{{ section.id }}">
        {% if section.settings.show_collection_image and collection.image and section.settings.banner_position == 'with-in-container' %}
        {{ collection_meta }}
        {% endif %}

        <div class="collection-header iv-collection-toolbar">
          <p class="iv-collection-count">Showing {{ collection.products_count }} products</p>
          <div class="iv-collection-toolbar__actions">
            <button type="button" class="iv-filter-toggle dt-sc-btn" data-iv-filter-open>{% render 'icon-filter' %} Filters</button>
            {% if section.settings.collections_sort_enable %}{% render 'collection-sorting' %}{% endif %}
          </div>
        </div>


        {%- assign has_active_filters = false -%}
        {%- for filter in collection.filters -%}
          {%- if filter.active_values.size > 0 -%}{%- assign has_active_filters = true -%}{%- endif -%}
          {%- if filter.type == 'price_range' -%}{%- if filter.min_value.value != nil or filter.max_value.value != nil -%}{%- assign has_active_filters = true -%}{%- endif -%}{%- endif -%}
        {%- endfor -%}
        {%- if has_active_filters -%}
        <div class="iv-active-filter-tags" aria-label="Active filters">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <a class="iv-active-filter-tag js-facet-remove" href="{{ value.url_to_remove }}">
                <span>{{ value.label | escape }}</span>
                {% render 'icon-close-small' %}
              </a>
            {%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                <a class="iv-active-filter-tag js-facet-remove" href="{{ filter.url_to_remove }}">
                  <span>
                    {%- if filter.min_value.value -%}{{ filter.min_value.value | money }}{%- else -%}{{ 0 | money }}{%- endif -%}
                    &ndash;
                    {%- if filter.max_value.value -%}{{ filter.max_value.value | money }}{%- else -%}{{ filter.range_max | money }}{%- endif -%}
                  </span>
                  {% render 'icon-close-small' %}
                </a>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <a class="iv-active-filter-clear js-facet-remove" href="{{ collection.url }}?sort_by={{ collection.sort_by | default: collection.default_sort_by }}">Clear all</a>
        </div>
        {%- endif -%}
        <div class="dT_VProdWrapper" id="dT_collectionGrid" data-infinite-scroll-wrapper data-next-page="{% if paginate.next %}{{ paginate.next.url }}{% endif %}">
          <ul class="grid product-collection dt-sc-column four-column dt-even-columns product-grid-style iv-collection-product-grid" data-infinite-scroll-grid id="AjaxinateContainer">
            {% if collection.products.size > 0 %}
              {% for product in collection.products %}
                {% render 'product-grid-item', product: product, imageSize: imageSize %}
              {% endfor %}
            {% else %}
              <li class="push">
                <p><em>{{ 'home_page.onboarding.no_products_html' | t }}</em></p>
              </li>
            {% endif %}
          </ul>
          <div class="iv-infinite-scroll-loader" data-infinite-scroll-loader aria-hidden="true"><span></span><span></span><span></span></div>
        </div>
      </div>
    </div>

    {% endpaginate %}

    <div class="iv-collection-links">
      <p class="iv-collection-links__heading">Explore More at Infinite Visibility</p>
      <ul class="iv-collection-links__list">
        {%- unless collection.handle contains 'mans-anime-merch' -%}
        <li><a href="/collections/mans-anime-merch-streetwear-gear-collectibles">Man's Anime Merch</a></li>
        {%- endunless -%}
        {%- unless collection.handle contains 'womens-anime-merch' -%}
        <li><a href="/collections/womens-anime-merch-cute-trendy-gear-kawaii">Women's Anime Merch</a></li>
        {%- endunless -%}
        {%- unless collection.handle contains 'kids-anime-merch' -%}
        <li><a href="/collections/kids-anime-merch-cool-clothes-toys-gifts">Kids Anime Merch</a></li>
        {%- endunless -%}
        {%- unless collection.handle contains 'anime-accessories' -%}
        <li><a href="/collections/anime-accessories-figures-phone-cases-wall-art-decor">Anime Accessories</a></li>
        {%- endunless -%}
        {%- unless collection.handle contains 'premium-anime-merchandise' -%}
        <li><a href="/collections/premium-anime-merchandise-clothing-collectibles-shop-all">Premium Anime Merchandise</a></li>
        {%- endunless -%}
        {%- unless collection.handle contains 'sale' or collection.handle contains 'clearance' -%}
        <li><a href="/collections/big-anime-sale-clearance-discounts-merch-collectibles">Big Anime Sale</a></li>
        {%- endunless -%}
      </ul>
    </div>
  </div>
</div>

{%- comment -%} ── DISCOUNT AUTO-APPLY (sale/clearance collections only) ── {%- endcomment -%}
{%- if collection.handle contains 'sale' or collection.handle contains 'clearance' -%}
<script>
(function () {
  var code = 'INFINITE';
  var appliedKey = 'iv_discount_applied';
  if (sessionStorage.getItem(appliedKey)) return;
  fetch('/discount/' + code, { method: 'GET', credentials: 'same-origin' })
    .then(function () {
      sessionStorage.setItem(appliedKey, '1');
      var bar = document.createElement('div');
      bar.id = 'iv-discount-bar';
      bar.innerHTML = '🎉 20% discount <strong>INFINITE</strong> automatically applied to your cart!';
      bar.style.cssText = [
        'position:fixed', 'bottom:20px', 'left:50%',
        'transform:translateX(-50%)',
        'background:#31378F', 'color:#ffc72f',
        'padding:12px 24px', 'border-radius:6px',
        'font-size:14px', 'font-weight:600', 'z-index:9999',
        'box-shadow:0 4px 16px rgba(0,0,0,0.25)',
        'text-align:center', 'max-width:90vw',
        'animation:ivSlideUp 0.4s ease'
      ].join(';');
      document.body.appendChild(bar);
      setTimeout(function () {
        bar.style.opacity = '0';
        bar.style.transition = 'opacity 0.4s ease';
        setTimeout(function () { bar.remove(); }, 400);
      }, 5000);
    });
})();
</script>
{%- else -%}
<script>
(function () {
  var appliedKey = 'iv_discount_applied';
  if (!sessionStorage.getItem(appliedKey)) return;
  fetch('/cart/update.js', {
    method: 'POST',
    credentials: 'same-origin',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ discount: '' })
  }).then(function () {
    sessionStorage.removeItem(appliedKey);
  });
})();
</script>
{%- endif -%}

<style>
  @keyframes ivSlideUp {
    from { opacity: 0; transform: translateX(-50%) translateY(20px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
  }
</style>

{{ 'infinite-scroll.js' | asset_url | script_tag }}

{%- style -%}
  /* ── BREADCRUMB ── */
  .collection-breadcrumb ol {
    display: flex; flex-wrap: wrap; list-style: none;
    padding: 0; margin: 0 0 15px 0; font-size: 13px; gap: 5px;
  }
  .collection-breadcrumb ol li::after { content: "/"; margin-left: 5px; color: #999; }
  .collection-breadcrumb ol li:last-child::after { content: ""; }
  .collection-breadcrumb ol li a { color: #31378F; text-decoration: none; }
  .collection-breadcrumb ol li a:hover { text-decoration: underline; }

  /* ── WELCOME MESSAGE ── */
  .collection-welcome-message {
    background: linear-gradient(135deg, #31378F 0%, #1e2460 100%);
    color: #ffffff;
    padding: 18px 22px;
    border-radius: 6px;
    margin: 15px 0 20px 0;
  }
  .collection-welcome-message p { margin: 0; font-size: 14px; line-height: 1.7; font-style: italic; }

  /* ── COLLECTION DESCRIPTION ── */
  .rte.collection-description {
    background: #f8f9ff;
    border: 1px solid #e8eaff;
    border-left: 4px solid #ffc72f;
    border-radius: 0 6px 6px 0;
    padding: 24px 28px;
    margin: 0 0 28px 0;
    position: relative;
  }
  .rte.collection-description::before {
    content: '⚔️';
    position: absolute;
    top: -14px;
    left: 20px;
    background: #ffc72f;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: block;
    line-height: 28px;
    text-align: center;
    font-size: 13px;
  }
  .rte.collection-description p { font-size: 14px; line-height: 1.8; color: #444; margin: 0 0 12px 0; }
  .rte.collection-description p:last-child { margin: 0; }
  .rte.collection-description strong { color: #31378F; }
  .rte.collection-description a { color: #31378F; text-decoration: underline; }
  .rte.collection-description a:hover { color: #ffc72f; }
  .rte.collection-description::after {
    content: 'US-Based · Free Worldwide Shipping · S-Rank Quality';
    display: block;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid #e8eaff;
    font-size: 11px;
    font-weight: 700;
    color: #31378F;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ── INTERNAL COLLECTION LINKS ── */
  .iv-collection-links { margin: 40px 0 20px 0; padding: 20px; border-top: 2px solid #31378F; }
  .iv-collection-links__heading { font-size: 14px; font-weight: 600; color: #31378F; margin: 0 0 12px 0; text-transform: uppercase; letter-spacing: 0.05em; }
  .iv-collection-links__list { display: flex; flex-wrap: wrap; list-style: none; padding: 0; margin: 0; gap: 10px; }
  .iv-collection-links__list li a {
    display: inline-block; padding: 6px 14px;
    border: 1px solid #31378F; color: #31378F;
    font-size: 13px; border-radius: 3px;
    text-decoration: none; transition: all 0.2s ease;
  }
  .iv-collection-links__list li a:hover { background: #31378F; color: #ffffff; }

  /* ── MISC ── */
  .list-collection-products { grid-gap: var(--DTGutter_Width); }
  .increasedzindexclass { z-index: 2; }

  /* ── DRAWER SIDEBAR ── */
  {% if section.settings.filter_type == 'drawer' %}
  .sidebar_btn { position: fixed; left: 0; top: 0; bottom: 0; display: none; align-items: center; z-index: 9; }
  .sidebar_btn .dt-sc-btn { border-radius: 0 var(--DTRadius) var(--DTRadius) 0; }
  .sidebar .dt-sc-btn.close-icon, .drawer-sidebar .dt-sc-btn.toggleIcon { display: inline-block; margin: 0; }
  .drawer-sidebar.open .sidebar .dt-sc-btn.close-icon { left: {{ settings.sidebar_width }}px; display: inline-block; position: sticky; }
  .drawer-sidebar.open .sidebar .dt-sc-btn.close-icon:not(:hover) { background: transparent; color: currentColor; }
  .dt-sc-btn.toggleIcon { padding: 7px 15px; margin: 0 0 20px; }
  .drawer-sidebar .sidebar {
    position: fixed !important; overflow-y: scroll !important;
    padding: 15px; width: 80%; max-width: {{ settings.sidebar_width }}px;
    top: 0; left: -{{ settings.sidebar_width }}px; height: 100%;
    background: var(--DTBodyBGColor); margin: 0; z-index: 17;
    transition: var(--DTBaseTransition);
  }
  .drawer-sidebar.open .sidebar { left: 0; }
  .drawer-sidebar.open .canvas-overlay {
    position: fixed; top: 0; bottom: 0; left: 0; right: 0;
    background-color: {{ settings.overlay_color | color_modify: 'alpha', 0.7 }};
    width: 100%; height: 100%; z-index: 16;
  }
  {% endif %}

  /* ── RESPONSIVE MARGINS ── */
  @media only screen and (min-width: 1200px) {
    #shopify-section-{{ section.id }}.main-collection-template .row > #collection-template-query {
      margin-top: {{ margin_top }}px; margin-bottom: {{ margin_bottom }}px;
      padding-top: {{ padding_top }}px; padding-bottom: {{ padding_bottom }}px;
    }
  }
  @media only screen and (max-width: 1199px) {
    #shopify-section-{{ section.id }}.main-collection-template .row > #collection-template-query {
      margin-top: {{ margin_top | divided_by: 2 }}px; margin-bottom: {{ margin_bottom | divided_by: 2 }}px;
      padding-top: {{ padding_top | divided_by: 2 }}px; padding-bottom: {{ padding_bottom | divided_by: 2 }}px;
    }
    #shopify-section-{{ section.id }}.main-collection-template .custom-product-grid { display: none; }
  }
  @media only screen and (max-width: 767px) {
    .iv-collection-links__list { gap: 8px; }
    .iv-collection-links__list li a { font-size: 12px; padding: 5px 10px; }
    .collection-welcome-message { padding: 14px 16px; }
    .collection-welcome-message p { font-size: 13px; }
    .rte.collection-description { padding: 20px 18px; }
    .rte.collection-description::before { top: -12px; width: 24px; height: 24px; font-size: 11px; line-height: 24px; }
  }
{%- endstyle -%}

<script type="text/javascript">
  jQuery('[data-view] a').on('click', function(){
    jQuery('[data-view] a.active').removeClass('active');
    jQuery(this).addClass('active');
    var flag = jQuery('[data-view="list"]').hasClass("active");
    if (flag) {
      jQuery(this).parents('#collection-template-query').find('.product-collection').removeClass('{{ grid_item_width }}').removeClass('product-grid-style').addClass('product-list-style');
      jQuery(this).parents('#collection-template-query').find('.custom-product-grid').addClass('panel-disabled');
      thumbGallerySwiper();
    } else {
      jQuery(this).parents('#collection-template-query').find('.product-collection').addClass('{{ grid_item_width }}').addClass('product-grid-style').removeClass('product-list-style');
      jQuery(this).parents('#collection-template-query').find('.custom-product-grid').removeClass('panel-disabled');
      thumbGallerySwiper();
    }
  });

  jQuery(".custom-product-grid li").click(function(){
    jQuery('li').removeClass('active');
    jQuery(this).toggleClass("active");
  });

  if ($('.show_sub_collection').length > 0) {
    $('.show_sub_collection.list-collection-products').not('.slick-initialized').slick({
      slidesToShow: {{- section.settings.items }},
      slidesToScroll: 1,
      adaptiveHeight: true,
      arrows: true,
      dots: false,
      responsive: [
        { breakpoint: 1199, settings: { slidesToShow: 2, slidesToScroll: 2 } },
        { breakpoint: 767, settings: { slidesToShow: 1, slidesToScroll: 1 } }
      ]
    });
  }
  document.addEventListener('DOMContentLoaded', function() {
    var drawer = document.getElementById('CollectionFilterDrawer');
    if (!drawer) return;
    document.querySelectorAll('[data-iv-filter-open]').forEach(function(button) {
      button.addEventListener('click', function() {
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        document.body.classList.add('iv-filter-drawer-open');
      });
    });
    var closeDrawer = function() {
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('iv-filter-drawer-open');
    };
    drawer.querySelectorAll('[data-iv-filter-close]').forEach(function(button) {
      button.addEventListener('click', closeDrawer);
    });

    drawer.querySelectorAll('.js-filter').forEach(function(filterPanel, index) {
      var summary = filterPanel.querySelector('.mobile-facets__summary');
      var body = filterPanel.querySelector('.filter-body');
      if (!summary || !body) return;
      summary.setAttribute('role', 'button');
      summary.setAttribute('tabindex', '0');
      summary.setAttribute('aria-expanded', index === 0 ? 'true' : 'false');
      filterPanel.classList.toggle('is-open', index === 0);
      var togglePanel = function() {
        var isOpen = filterPanel.classList.toggle('is-open');
        summary.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      };
      summary.addEventListener('click', togglePanel);
      summary.addEventListener('keydown', function(event) {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          togglePanel();
        }
      });
    });
  });
</script>

{% for block in section.blocks %}
{% case block.type %}
{% when 'carousel' %}
<script type="text/javascript">
  function collectionSidebarCarousel(){
    var dataSectionType = $('[data-section-type="collection-sidebar-carousel-section"]');
    var id = dataSectionType.attr('data-section-id');
    var ItemsPerView = +dataSectionType.attr('data-item-per-view');
    var ItemsSpace = +dataSectionType.attr('data-item-space');
    var autoHeight = +dataSectionType.attr('data-auto-height') || false;
    var Autoplay = +dataSectionType.attr('data-autoplay') * 1000;
    var initAutoplay = Autoplay ? { delay: Autoplay } : false;
    var swiper = new Swiper('#swiper-' + id + '-slider', {
      pagination: { el: '#swiper-' + id + '-pagination', clickable: true },
      navigation: { nextEl: '#swiper-' + id + '-next', prevEl: '#swiper-' + id + '-prev' },
      loop: false,
      slidesPerView: ItemsPerView,
      spaceBetween: ItemsSpace,
      autoHeight: autoHeight,
      simulateTouch: true,
      autoplay: initAutoplay
    });
  }
  $(document).ready(function(){ collectionSidebarCarousel(); });
  $(document)
    .on('shopify:section:load', collectionSidebarCarousel)
    .on('shopify:section:unload', collectionSidebarCarousel);
</script>
{% endcase %}
{% endfor %}

