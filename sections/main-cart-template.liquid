{% comment %}
=============================================================
  Infinite Visibility — main-cart-template.liquid
  Updated: May 13 2026
  Free worldwide shipping on ALL orders — no minimum.
  Policy checkbox scoped to section ID to prevent duplicate
  ID issues if cart template renders in multiple contexts.
=============================================================
{% endcomment %}

{% if cart.item_count > 0 %}
{% unless settings.shipping_calculator == 'Disabled' %}
<script src="{{ 'dT_shipping-cart.js' | asset_url }}" defer="defer"></script>
{% endunless %}
{% endif %}

{%- style -%}
  .iv-cart-shipping-bar {
    background: linear-gradient(135deg, #1a5c2a, #1e7a35);
    border-radius: 6px;
    padding: 14px 18px;
    margin: 0 0 20px 0;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .iv-cart-shipping-bar__icon { font-size: 24px; flex-shrink: 0; }
  .iv-cart-shipping-bar__text {
    font-size: 14px;
    margin: 0;
    color: #ffffff;
    font-weight: 600;
    line-height: 1.4;
  }
  .iv-cart-shipping-bar__text span {
    display: block;
    font-size: 12px;
    font-weight: 400;
    color: rgba(255,255,255,0.8);
    margin-top: 2px;
  }
  .iv-cart-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 20px 0;
    padding: 14px 16px;
    background: #f8f9ff;
    border: 1px solid #e8eaff;
    border-radius: 6px;
  }
  .iv-cart-trust__item {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: #444;
    flex: 1;
    min-width: 130px;
  }
  .iv-cart-trust__icon { font-size: 18px; flex-shrink: 0; }
  .iv-cart-urgency {
    background: linear-gradient(135deg, #31378F, #252c7a);
    color: #ffffff;
    padding: 10px 16px;
    border-radius: 6px;
    font-size: 13px;
    text-align: center;
    margin: 0 0 20px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .iv-cart-urgency__icon { font-size: 16px; }
  .iv-cart-sale {
    display: flex;
    align-items: center;
    gap: 12px;
    background: linear-gradient(135deg, #0a0e2e, #1a1f5e);
    border: 1px solid rgba(49,55,143,0.4);
    border-radius: 6px;
    padding: 13px 16px;
    margin: 20px 0 0 0;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .iv-cart-sale:hover { background: linear-gradient(135deg, #1a1f5e, #252c7a); }
  .iv-cart-sale__icon { font-size: 22px; }
  .iv-cart-sale__text { flex: 1; }
  .iv-cart-sale__title { color: #ffffff; font-size: 13px; font-weight: 700; margin: 0 0 2px 0; }
  .iv-cart-sale__sub { color: rgba(255,255,255,0.6); font-size: 11px; margin: 0; }
  .iv-cart-sale__arrow { color: rgba(255,255,255,0.4); font-size: 16px; }
  .iv-cart-collections {
    margin: 20px 0 0 0;
    padding: 16px;
    background: #f8f9ff;
    border: 1px solid #e8eaff;
    border-radius: 6px;
  }
  .iv-cart-collections__label {
    font-size: 12px;
    font-weight: 600;
    color: #31378F;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 10px 0;
  }
  .iv-cart-collections__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .iv-cart-collections__links li a {
    display: inline-block;
    padding: 5px 12px;
    border: 1px solid #31378F;
    border-radius: 3px;
    color: #31378F;
    font-size: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .iv-cart-collections__links li a:hover { background: #31378F; color: #ffffff; }
  .iv-empty-cart-collections { margin: 30px 0 0 0; }
  .iv-empty-cart-collections__label {
    font-size: 14px;
    font-weight: 600;
    color: #31378F;
    margin: 0 0 12px 0;
  }
  .iv-empty-cart-collections__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .iv-empty-cart-collections__grid li a {
    display: inline-block;
    padding: 8px 16px;
    border: 1px solid #31378F;
    border-radius: 4px;
    color: #31378F;
    font-size: 13px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .iv-empty-cart-collections__grid li a:hover { background: #31378F; color: #ffffff; }
  .iv-empty-free-shipping {
    background: linear-gradient(135deg, #1a5c2a, #1e7a35);
    color: #ffffff;
    border-radius: 6px;
    padding: 14px 18px;
    margin: 0 0 20px 0;
    text-align: center;
    font-size: 15px;
    font-weight: 700;
  }
  .iv-empty-free-shipping span {
    display: block;
    font-size: 12px;
    font-weight: 400;
    color: rgba(255,255,255,0.85);
    margin-top: 4px;
  }
  @media (max-width: 420px) {
    .cart .cart__row .product-info dl { display: block; }
    .iv-cart-trust { gap: 8px; }
    .iv-cart-trust__item { min-width: 100%; }
    .iv-cart-shipping-bar { flex-direction: column; text-align: center; }
  }
{%- endstyle -%}

<div class="container">
  <div class="row">
    {% if cart.item_count > 0 %}

    <div class="iv-cart-shipping-bar">
      <span class="iv-cart-shipping-bar__icon">🌍</span>
      <p class="iv-cart-shipping-bar__text">
        ✅ FREE Worldwide Shipping on Your Order!
        <span>No minimum required — US, Canada & International all included.</span>
      </p>
    </div>

    <div class="iv-cart-urgency">
      <span class="iv-cart-urgency__icon">🔥</span>
      <span>S-Rank gear moves fast — secure your loot before it sells out!</span>
    </div>

    <div class="cart_table">
      <form action="/cart" method="post" novalidate class="cart dt-sc-column two-third-one-third">
        <div class="cart__items">
          {% if cart.announcements.size > 0 %}
          <ul class="note">
            {% for announcement in cart.announcements %}<li>{{ announcement }}</li>{% endfor %}
          </ul>
          {% endif %}
          {% if cart.errors.size > 0 %}
          <ul class="note errors">
            {% for error in cart.errors %}<li>{{ error }}</li>{% endfor %}
          </ul>
          {% endif %}
          <div class="cart__row cart__header-labels">
            <h4 class="cart_heading">{{ 'cart.label.products' | t }}</h4>
          </div>

          {% for item in cart.items %}
          <div class="cart__row">
            <div class="cart_items">
              <a href="{{ item.url | within: collections.all }}" class="cart__image">
                <img
                  src="{{ item.image | image_url: width: 300 }}"
                  class="cart-item__image"
                  alt="{{ item.image.alt | escape }}"
                  loading="lazy"
                  width="300"
                  height="{{ 300 | divided_by: item.image.aspect_ratio | ceil }}"
                >
              </a>
            </div>
            <div class="product-info">
              <h5 class="cart-title">
                <a href="{{ item.url }}" class="product-name">{{ item.product.title }}</a>
              </h5>
              {% if settings.cart_vendor_enable %}<p>{{ item.vendor }}</p>{% endif %}
              <div class="price">{{ item.price | money }}</div>
              {%- if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != nil -%}
              <dl>
                {%- if item.product.has_only_default_variant == false -%}
                {%- for option in item.options_with_values -%}
                <div class="product-option">
                  <dt>{{ option.name }}: </dt>
                  <dd>{{ option.value }}</dd>
                </div>
                {%- endfor -%}
                {%- endif -%}
                {%- for property in item.properties -%}
                {%- assign property_first_char = property.first | slice: 0 -%}
                {%- if property.last != blank and property_first_char != '_' -%}
                <div class="product-option">
                  <dt>{{ property.first }}: </dt>
                  <dd>
                    {%- if property.last contains '/uploads/' -%}
                    <a href="{{ property.last }}" class="link" target="_blank">{{ property.last | split: '/' | last }}</a>
                    {%- else -%}
                    {{ property.last }}
                    {%- endif -%}
                  </dd>
                </div>
                {%- endif -%}
                {%- endfor -%}
              </dl>
              <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
              {%- endif -%}
              <div class="qty-box-set quantity">
                <button class="qtyminus1 quantity-btn quantity-btn-minus"></button>
                <input type="text" class="quantity-selector cart-number quantity-btn-number" name="updates[]" id="updates_{{ item.id }}" value="{{ item.quantity }}" min="0">
                <button class="qtyplus1 quantity-btn quantity-btn-plus"></button>
              </div>
              <a href="/cart/change?line={{ forloop.index }}&amp;quantity=0" class="cart__remove close_icon">
                {% render 'icon-dustbin' %}
                <span>{{ 'cart.general.remove' | t }}</span>
              </a>
              <div class="price">
                <span class="cart_total">{{ 'cart.general.total' | t }}</span>
                <strong>
                  {{ item.line_price | money }}
                  {% if item.original_line_price != item.line_price %}
                  <del class="cart-item__original-price">{{ item.original_line_price | money }}</del>
                  {% endif %}
                </strong>
              </div>
              {% if item.original_line_price != item.line_price %}
              {% for discount in item.discounts %}
              <p>
                <small class="cart-item__discount">{{ discount.title }} - <strong>{{ discount.amount | money }}</strong></small>
              </p>
              {% endfor %}
              {% endif %}
            </div>
          </div>
          {% endfor %}

          <div class="btn_actions">
            <a class="dt-sc-btn" href="/collections/mans-anime-merch-streetwear-gear-collectibles">
              {{ 'cart.general.continue_shopping' | t }}
            </a>
            <input type="submit" name="update" class="dt-sc-btn update-cart right" value="{{ 'cart.general.update' | t }}">
          </div>

          {% if cart.discounts.size > 0 %}
          <div class="cart-additional-savings text-right cart__row">
            <span class="label cart-additional-savings__label">{{ 'cart.general.additional_savings' | t }}</span>
            <span class="h4 cart-additional-savings__price">{{ cart.discount.total_savings | money }}</span>
            {% for discount in cart.discounts %}
            <small class="cart-additional-savings__savings">{{ discount.title }}</small>
            {% endfor %}
          </div>
          {% endif %}
        </div>

        <div class="shipping-section">
          <div class="order_summary">
            <h4 class="cart_heading">{{ 'cart.general.order_summary' | t }}</h4>
            <p class="cart_total_price">
              <span class="cart__subtotal-title">{{ 'cart.general.subtotal' | t }}</span>
              <span class="cart__subtotal">{{ cart.total_price | money }}</span>
            </p>
            <p>
              {% if cart.total_discounts > 0 %}
              {%- assign savings = cart.total_discounts | money -%}
              <small class="cart-subtotal__savings">{{ 'cart.general.savings_html' | t: price: savings }}</small>
              {% endif %}
            </p>

            <div class="iv-cart-trust">
              <div class="iv-cart-trust__item">
                <span class="iv-cart-trust__icon">🔒</span>
                <span>Secure Checkout</span>
              </div>
              <div class="iv-cart-trust__item">
                <span class="iv-cart-trust__icon">🌍</span>
                <span>Free Worldwide Shipping</span>
              </div>
              <div class="iv-cart-trust__item">
                <span class="iv-cart-trust__icon">↩️</span>
                <span>Easy Returns</span>
              </div>
              <div class="iv-cart-trust__item">
                <span class="iv-cart-trust__icon">⭐</span>
                <span>S-Rank Quality</span>
              </div>
            </div>

            {% if section.settings.enable_cart_note %}
            {%- assign noteSize = cart.note | size -%}
            <button type="button" class="text-link cart__note-add{% if noteSize > 0 %} is-hidden{% endif %}">
              {{ 'cart.label.add_note' | t }}
            </button>
            <div class="cart__note{% if noteSize > 0 %} is-active{% endif %}">
              <label for="CartSpecialInstructions">{{ 'cart.general.note' | t }}</label>
              <textarea name="note" class="input-full" id="CartSpecialInstructions">{{ cart.note }}</textarea>
            </div>
            {% endif %}

            <p class="shopping-checkout">
              <em>🌍 Free worldwide shipping — no minimum order required.</em>
            </p>

            {%- comment -%}
              Policy checkbox IDs are scoped to section.id to prevent
              duplicate ID conflicts if cart renders in multiple contexts
              (page cart + drawer cart on same page load).
            {%- endcomment -%}
            <div class="iv-cart-policy" style="margin: 0 0 14px 0; padding: 14px 16px; background: #f8f9ff; border: 1px solid #e8eaff; border-radius: 6px;">
              <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer; font-size: 13px; color: #333; line-height: 1.5;">
                <input
                  type="checkbox"
                  id="iv-policy-agree-{{ section.id }}"
                  style="margin-top: 3px; flex-shrink: 0; accent-color: #31378F; width: 16px; height: 16px; cursor: pointer;"
                >
                <span>
                  I have read and agree to the
                  <a href="/policies/refund-policy" target="_blank" style="color: #31378F; font-weight: 600; text-decoration: underline;">Return & Refund Policy</a>
                  and
                  <a href="/policies/shipping-policy" target="_blank" style="color: #31378F; font-weight: 600; text-decoration: underline;">Shipping Policy</a>
                  before proceeding to checkout.
                </span>
              </label>
              <p id="iv-policy-error-{{ section.id }}" style="display:none; color:#c0392b; font-size:12px; margin: 8px 0 0 26px; font-weight: 600;">
                ⚠️ Please read and agree to our policies before checking out.
              </p>
            </div>

            <div class="cart_btn">
              <input type="submit" name="checkout" id="iv-checkout-btn-{{ section.id }}" class="dt-sc-btn" style="width:100%" value="{{ 'cart.general.checkout' | t }}">
              {% if additional_checkout_buttons %}
              <div class="cart__additional_checkout">{{ content_for_additional_checkout_buttons }}</div>
              {% endif %}
            </div>

            <script>
              (function() {
                var sid = '{{ section.id }}';
                var checkbox   = document.getElementById('iv-policy-agree-' + sid);
                var checkoutBtn = document.getElementById('iv-checkout-btn-' + sid);
                var errorMsg   = document.getElementById('iv-policy-error-' + sid);
                if (!checkbox || !checkoutBtn) return;
                checkoutBtn.addEventListener('click', function(e) {
                  if (!checkbox.checked) {
                    e.preventDefault();
                    errorMsg.style.display = 'block';
                    checkbox.focus();
                  } else {
                    errorMsg.style.display = 'none';
                  }
                });
                checkbox.addEventListener('change', function() {
                  if (checkbox.checked) errorMsg.style.display = 'none';
                });
              })();
            </script>

            {% render 'shipping-calculator' %}

            <a href="/collections/big-anime-sale-clearance-discounts-merch-collectibles" class="iv-cart-sale">
              <span class="iv-cart-sale__icon">⚡</span>
              <div class="iv-cart-sale__text">
                <p class="iv-cart-sale__title">Big Anime Sale — Up to 50% Off</p>
                <p class="iv-cart-sale__sub">Free shipping already included — add more and save!</p>
              </div>
              <span class="iv-cart-sale__arrow">→</span>
            </a>
          </div>
        </div>
      </form>
    </div>

    <div class="iv-cart-collections">
      <p class="iv-cart-collections__label">Keep Shopping</p>
      <ul class="iv-cart-collections__links">
        <li><a href="/collections/mans-anime-merch-streetwear-gear-collectibles">Man's Anime Merch</a></li>
        <li><a href="/collections/womens-anime-merch-cute-trendy-gear-kawaii">Women's Anime Merch</a></li>
        <li><a href="/collections/kids-anime-merch-cool-clothes-toys-gifts">Kids Anime Merch</a></li>
        <li><a href="/collections/anime-accessories-figures-phone-cases-wall-art-decor">Anime Accessories</a></li>
        <li><a href="/collections/premium-anime-merchandise-clothing-collectibles-shop-all">Premium Merch</a></li>
      </ul>
    </div>

    {% else %}

    <div class="cart_empty_msg">
      <div class="iv-empty-free-shipping">
        🌍 Free Worldwide Shipping on All Orders
        <span>No minimum required — US, Canada & International included</span>
      </div>
      <img
        src="{{ 'empty-cart.png' | asset_url }}"
        alt="{{ 'cart.general.empty' | t }}"
        width="512"
        height="512"
        loading="lazy"
      />
      <h4>{{ 'cart.general.empty' | t }}</h4>
      <p>Your inventory is empty, warrior. Time to gear up!</p>
      <div class="iv-empty-cart-collections">
        <p class="iv-empty-cart-collections__label">Start Your Haul</p>
        <ul class="iv-empty-cart-collections__grid">
          <li><a href="/collections/mans-anime-merch-streetwear-gear-collectibles">Man's Anime Merch</a></li>
          <li><a href="/collections/womens-anime-merch-cute-trendy-gear-kawaii">Women's Anime Merch</a></li>
          <li><a href="/collections/kids-anime-merch-cool-clothes-toys-gifts">Kids Anime Merch</a></li>
          <li><a href="/collections/anime-accessories-figures-phone-cases-wall-art-decor">Anime Accessories</a></li>
          <li><a href="/collections/big-anime-sale-clearance-discounts-merch-collectibles">Big Anime Sale ⚡</a></li>
        </ul>
      </div>
    </div>

    {% endif %}

    <form method="post" action="/cart" class="discount">
      <input type="text" name="discount" placeholder="Enter discount code..." class="discount-code" required="required">
      <button id="apply-coupon" type="button">{{ 'sections.collection_template.apply' | t }}</button>
    </form>
  </div>
</div>

<script>
  $(document).ready(function(){
    $('#apply-coupon').on('click', function(event){
      event.preventDefault();
      var target = '/checkout?discount=';
      var dT_Discount = $('input[name="discount"]').val();
      var dTGo = target + dT_Discount;
      window.location.href = dTGo;
    });
  });
</script>

{% schema %}
{
  "name": "Cart template",
  "tag": "section",
  "class": "main-cart-template",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_cart_note",
      "label": "Enable Cart note",
      "default": false
    }
  ]
}
{% endschema %}