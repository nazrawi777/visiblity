{%- liquid
  if section.blocks.size > 0
  assign ColumnWidth = section.settings.content_width | split: '/'
  assign leftColumn = ColumnWidth[0]
  assign rightColumn = ColumnWidth[1]

  assign listWidth = section.settings.lap_content_width | split: '/'
  assign lap_leftColumn = listWidth[0]
  assign lap_rightColumn = listWidth[1]
  endif

  if section.blocks.size > 0
  case section.settings.grid
  when '1'
  when '2'
  assign column = 'two-column'
  when '3'
  assign column = 'three-column'
  when '4'
  assign column = 'four-column'
  when '5'
  assign column = 'five-column'
  when '6'
  assign column = 'six-column'
  else
  assign column = 'three-column'
  endcase
  endif

  if section.settings.enable_overlay
  assign section_overlay = 'dt-sc-overlay'
  endif

  if section.settings.show_background_image
  assign lazyScript = "lazyload"
  endif
-%}

<div class="dt-sc-section-wrapper  {{ lazyScript }} {{ section_overlay }} {% if section.settings.background_style == 'parallax' %} parallax-initiated{% endif %}" {% if section.settings.background_style == 'parallax' %} data-speed="2" data-style="parallax"{% endif %} style="{% render 'bg-color-image-padding' %} background-size: {{- section.settings.background_size -}}; {% if section.settings.background_style == 'fixed' %}background-attachment: fixed;{% endif %} background-repeat:{% if section.settings.background_size == 'repeat' %}repeat{% else %}no-repeat;{% endif %}" {% render 'bg_image' %}>
  <div class="{% render 'container-settings' %}">
    <div class="row {{ section.settings.custom_class_name }}">
      {% render 'section-heading', class: section.id %}
      {% if section.blocks.size > 0 %} <div class="grouped-content{% if section.settings.reverse_column %} dt-sc-reverse-columns{% endif %} wow {% if section.settings.animation_effect == false %} {{ section.settings.animation_effect_section }} {% endif %} ">{% endif %}
      {% if section.blocks.size > 0 %}
      {% if section.settings.enable_additional_content != blank %}
      <div class="additional-block wow {% if  section.settings.animation_effect == true %} {{ section.settings.animation_effect_additionalblock }} {% endif %} ">
        {%- for block in section.blocks -%}
         {%- liquid
        if block.settings.block_banner_style == 'overlay'
        assign overlay_style = 'overlay-style'
        endif
      %}
         {% case  block.type %}
        {% when 'menu' %}
        <div class="dt-sc-menu-section">
          {% assign blockMenu = linklists[block.settings.menu] %}
          {% if block.settings.block_title != blank %}
          <h3 class="additional-grid-title">{{ block.settings.block_title }}</h3>
          {% endif %}
          <ul class="menu-links">
            {% for link in blockMenu.links %}
            <li {% if link.current %}class="active"{% endif %}><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
        {% when 'banner' %}
        <div class="dt-sc-grid-banner-section">
          <div class="dt-sc-grid-banner {{ overlay_style }} {{ block.type }}-{{ block.id }}">
            {% if block.settings.show_image %}
            <div class="dt-sc-grid-banner-image {{ block.settings.banner_image_overlay_style }}">
              {% if block.settings.block_image != blank %}
                <img srcset="{%- if block.settings.block_image.width >= 275 -%}{{ block.settings.block_image | image_url: width: 275 }} 275w,{%- endif -%}
                {%- if block.settings.block_image.width >= 550 -%}{{ block.settings.block_image | image_url: width: 550 }} 550w,{%- endif -%}
                {%- if block.settings.block_image.width >= 710 -%}{{ block.settings.block_image | image_url: width: 710 }} 710w,{%- endif -%}
                {%- if block.settings.block_image.width >= 1420 -%}{{ block.settings.block_image | image_url: width: 1420 }} 1420w,{%- endif -%}
                {{ block.settings.block_image | image_url }} {{ block.settings.block_image.width }}w"
                src="{{ block.settings.block_image | image_url: width: 1420 }}"
                sizes="(min-width: 990px) 710px, (min-width: 750px) 710px, calc(100vw - 30px)"
                alt="{{ block.settings.block_image.alt }}"
                height="{{ block.settings.block_image.height }}"
                width="{{ block.settings.block_image.width }}"
                loading="lazy">
                {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder_svg' }}
                {% endif %}
             </div>
            {% endif %}
            {% if block.settings.block_banner_style == 'grid' %}
            {% if block.settings.block_title != blank or block.settings.block_sub_title != blank or block.settings.block_description != blank or block.settings.block_button_link != blank %}
            <div class="dt-sc-grid-banner-content {{ block.settings.block_text_align }}">
              {% if block.settings.block_title != blank %}
              <h4 class="dt-sc-main-title">{{ block.settings.block_title }}</h4>
              {% endif %}
              {% if block.settings.block_sub_title != blank %}
              <h6 class="dt-sc-sub-title">{{ block.settings.block_sub_title }}</h6>
              {% endif %}
              {% if block.settings.block_description != blank %}
              <p class="dt-sc-description">{{ block.settings.block_description }}</p>
              {% endif %}
              {% if block.settings.block_button_link != blank %}
              <a href="{{ block.settings.block_button_link }}" class="dt-sc-btn">{{ block.settings.block_button_text }}</a>
              {% endif %}
            </div>
            {% endif %}
            {% endif %}
            {% if block.settings.block_banner_style == 'overlay' %}
            {% if block.settings.block_title != blank or block.settings.block_sub_title != blank or block.settings.block_description != blank or block.settings.block_button_link != blank %}
            <div class="dt-sc-grid-banner-content {{ block.settings.content_position }}">
              <div class="dt-sc-grid-banner-inner {{ block.settings.block_text_align }}">
                {% if block.settings.block_title != blank %}
                <h4 class="dt-sc-main-title">{{ block.settings.block_title }}</h4>
                {% endif %}
                {% if block.settings.block_sub_title != blank %}
                <h6 class="dt-sc-sub-title">{{ block.settings.block_sub_title }}</h6>
                {% endif %}
                {% if block.settings.block_description != blank %}
                <p class="dt-sc-description">{{ block.settings.block_description }}</p>
                {% endif %}
                {% if block.settings.block_button_link != blank %}
                <a href="{{ block.settings.block_button_link }}" class="dt-sc-btn">{{ block.settings.block_button_text }}</a>
                {% endif %}
              </div>
            </div>
            {% endif %}
            {% endif %}
          </div>
        </div>
        {% when 'timer' %}
        <div class="dt-sc-grid-banner-section deals-section">
          <div class="dt-sc-grid-banner {{ overlay_style }} {{ block.type }}-{{ block.id }}">
            {% if block.settings.show_image %}
            <div class="dt-sc-grid-banner-image {{ block.settings.banner_image_overlay_style }}">
              {% if block.settings.block_image != blank %}
                <img srcset="{%- if block.settings.block_image.width >= 275 -%}{{ block.settings.block_image | image_url: width: 275 }} 275w,{%- endif -%}
                {%- if block.settings.block_image.width >= 550 -%}{{ block.settings.block_image | image_url: width: 550 }} 550w,{%- endif -%}
                {%- if block.settings.block_image.width >= 710 -%}{{ block.settings.block_image | image_url: width: 710 }} 710w,{%- endif -%}
                {%- if block.settings.block_image.width >= 1420 -%}{{ block.settings.block_image | image_url: width: 1420 }} 1420w,{%- endif -%}
                {{ block.settings.block_image | image_url }} {{ block.settings.block_image.width }}w"
                src="{{ block.settings.block_image | image_url: width: 1420 }}"
                sizes="(min-width: 990px) 710px, (min-width: 750px) 710px, calc(100vw - 30px)"
                alt="{{ block.settings.block_image.alt }}"
                height="{{ block.settings.block_image.height }}"
                width="{{ block.settings.block_image.width }}"
                loading="lazy">
                {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder_svg' }}
                {% endif %}
            </div>
            {% endif %}
            {% if block.settings.block_title != blank or block.settings.block_sub_title != blank or block.settings.deal_end_date != blank or block.settings.block_description != blank or block.settings.block_button_link != blank %}
            <div class="dt-sc-grid-banner-content {{ block.settings.block_text_align }}">
              {% if block.settings.block_title != blank %}
              <h4 class="dt-sc-main-title">{{ block.settings.block_title }}</h4>
              {% endif %}
              {% if block.settings.block_description != blank %}
              <p class="dt-sc-description">{{ block.settings.block_description }}</p>
              {% endif %}
              <div class="deals-counter">
                {% if block.settings.block_sub_title != blank %}
                <h6 class="dt-sc-sub-title">{{ block.settings.block_sub_title }}</h6>
                {% endif %}
                {% if block.settings.deal_end_date != blank %}
                {% assign endTime = block.settings.deal_end_date | date: "%d %b %Y" %}
                <div class="product-deal-count" data-end-time="{{ endTime }}">
                  <div class="notice"></div>
                  <div class="deal-clock">
                    <ul>
                      <li class="days"></li>
                      <li class="hours"></li>
                      <li class="minutes"></li>
                      <li class="seconds"></li>
                    </ul>
                  </div>
                </div>
                {% endif %}
              </div>
              {% if block.settings.block_button_link != blank %}
              <a href="{{ block.settings.block_button_link }}" class="dt-sc-btn">{{ block.settings.block_button_text }}</a>
              {% endif %}
            </div>
            {% endif %}
          </div>
        </div>
        {% when 'product' %}
        <div class="dT_vDynamicPWrap-{{ section.id }} dT_vProdWrap">
          <ul>
            {%- assign product = all_products[block.settings.product] -%}
            {% render 'product-grid-item', product: product, swiperSlideClass: 'carousel-block-item' %}
          </ul>
        </div>
        {% when 'collection' %}
        {% assign block_collection = collections[block.settings.collection] %}
        {% if block.settings.block_title != blank %}
        <h3 class="additional-grid-title">{{ block.settings.block_title }}</h3>
        {% endif %}
        {% if block.settings.enable_slider %}
        <div data-section-id="blockCarousel" data-section-type="home-blockCarousel-section"
             data-item-per-view="{{ block.settings.items_per_view }}"
             data-laptop-screen-items="{{ block.settings.items_laptop_view }}"
             data-tablet-screen-items="{{ block.settings.items_tablet_view }}"
             data-small-screen-items="{{ block.settings.items_mobile_view }}"
             data-autoplay="{{ block.settings.slider_autoplay }}"
             data-blocks-limit="{{ section.blocks.size }}"
             data-item-space="{{ block.settings.collection_column_gap }}"
             data-item-row="{{ block.settings.rows }}"
             data-center-mode="false"
             data-auto-height="false">
          <div class="dt-sc-swiper-slider swiper-container {% if block.settings.dots %} {{ block.settings.carousel_pagination_alignment }} {% endif %} {% if block.settings.arrows %} {{ block.settings.nav_arrow_position }} {{ block.settings.center_nav_arrow_alignment }} {% endif %}">
            <div id="swiper-blockCarousel-slider" class="dT_vDynamicPWrap-{{ section.id }} dT_vProdWrap">
              <ul class="swiper-wrapper product-list-style">
                {% assign swiperSlideClass = "swiper-slide" %}
                {% for product in block_collection.products limit: 9 %}
                {% render 'product-grid-item', product: product, swiperSlideClass: swiperSlideClass %}
                {% endfor %}
              </ul>
              {% if block.settings.arrows %}
              <div class="swiper-blockCarousel-arrows swiper-arrows">
                <div id="swiper-blockCarousel-next" class="swiper-button-next dt-sc-btn"></div>
                <div id="swiper-blockCarousel-prev" class="swiper-button-prev dt-sc-btn"></div>
              </div>
              {% endif %}
              {% if block.settings.dots %}
              <div id="swiper-blockCarousel-pagination" class="swiper-pagination"></div>
              {% endif %}
            </div>
          </div>
        </div>
        {% else %}
        <div class="dT_vDynamicPWrap-{{ section.id }} dT_vProdWrap" data-section-id="home-tab-sidebar-collection" data-section-type="home-tab-sidebar-collection">
          <ul class="product-list-style">
            {% assign swiperSlideClass = "carousel-block-list" %}
            {% for product in block_collection.products limit: block.settings.limit %}
            {% render 'product-grid-item', product: product, swiperSlideClass: swiperSlideClass %}
            {% endfor %}
          </ul>
        </div>
        {% endif %}
        {% endcase %}
        {%- endfor -%}
      </div>
      {% endif %}
      {% endif %}

      {% if section.settings.enable_main_content != blank %}
      <div class="main-block tabs_wrapper tab-{{ section.id }}-js {{ section.settings.tab_alignment }} {{ section.settings.tab_style }} wow {% if section.settings.animation_effect == true %} {{ section.settings.animation_effect_mainblock }} {% endif %}" {% if section.blocks.size > 0 %} {% endif %}>
        <div class="tabs">
          {% for block in section.blocks %}
          {% case block.type %}
          {% when 'tab' %}
          <div class="dt-sc-btn tablinks" id="dT_tab-{{ forloop.index }}-{{ block.settings.block_title | handle }}">{{ block.settings.block_title }}</div>
          {% endcase %}
          {% endfor %}
        </div>
        <div class="tabs_container">
          {% for block in section.blocks %}
          {% case block.type %}
          {% when 'tab' %}
          {%- assign tab_collection = collections[block.settings.tab] -%}
          {%- assign tab_collection_url = tab_collection.url -%}

          {% if section.settings.enable_slider %}
          <div data-tab="dT_tab-{{ forloop.index }}-{{ block.settings.block_title | handle }}" class="dt-sc-tabs-content" data-section-id="home-tab-grid" data-section-type="home-tab-grid">
            <div class="dt-sc-swiper-slider swiper-container {% if section.settings.dots %} {{ section.settings.carousel_pagination_bottom_alignment }} {{ section.settings.carousel_pagination_alignment }} {% endif %} {% if section.settings.arrows %} {{ section.settings.nav_arrow_position }} {{ section.settings.center_nav_arrow_alignment }} {% endif %}">
              <div id="swiper-{{ block.type }}-{{ forloop.index }}-{{ block.settings.block_title | handle }}-slider" class="dT_vDynamicPWrap-{{ section.id }}-tab-{{ forloop.index }} dT_vProdWrap">
                <ul class="swiper-wrapper {% if section.settings.enable_list_view %}product-list-style{% endif %}">
                  {% for product in collections[block.settings.tab].products %}
                  {% render 'product-grid-item', product: product, swiperSlideClass: 'swiper-slide' %}
                  {% else %}
                  {% for i in (1..4) %}
                  {% render 'empty-row' %}
                  {% endfor %}
                  {% endfor %}
                </ul>
                {% if section.settings.arrows %}
                <div class="swiper-{{ block.type }}-{{ block.settings.block_title | handle }}{{ forloop.index }}-arrows swiper-arrows">
                  <div id="swiper-{{ block.type }}-{{ block.settings.block_title | handle }}{{ forloop.index }}-next" class="swiper-button-next dt-sc-btn"></div>
                  <div id="swiper-{{ block.type }}-{{ block.settings.block_title | handle }}{{ forloop.index }}-prev" class="swiper-button-prev dt-sc-btn"></div>
                </div>
                {% endif %}
                {% if section.settings.dots %}
                <div id="swiper-{{ block.type }}-{{ block.settings.block_title | handle }}{{ forloop.index }}-pagination" class="swiper-pagination"></div>
                {% endif %}
              </div>
            </div>

            <div class="iv-tab-buttons" style="display:flex; gap:12px; justify-content:center; margin-top:30px; flex-wrap:wrap;">
              <button class="dt-sc-btn iv-load-more-btn"
                data-tab-index="{{ forloop.index }}"
                data-section-id="{{ section.id }}"
                data-collection="{{ block.settings.tab }}"
                data-loaded="{{ section.settings.post_limit }}"
                data-per-page="{{ section.settings.post_limit }}">
                Load More
              </button>
              {% if tab_collection_url != blank %}
              <a href="{{ tab_collection_url }}" class="dt-sc-btn iv-explore-btn">
                Explore {{ block.settings.block_title }}
              </a>
              {% endif %}
            </div>

            <script type="text/javascript">
              $(document).ready(function(){
                var swiper = new Swiper("#swiper-{{ block.type }}-{{ forloop.index }}-{{ block.settings.block_title | handle }}-slider", {
                  pagination: { el: '#swiper-{{ block.type }}-{{ block.settings.block_title | handle }}{{ forloop.index }}-pagination', clickable: true },
                  navigation: { nextEl: '#swiper-{{ block.type }}-{{ block.settings.block_title | handle }}{{ forloop.index }}-next', prevEl: '#swiper-{{ block.type }}-{{ block.settings.block_title | handle }}{{ forloop.index }}-prev' },
                  {% if section.settings.enable_center_mode %}centeredSlides: true, loop: true,{% else %}loop: false,{% endif %}
                  slidesPerView: {{ section.settings.items_per_view }},
                  slidesPerColumn: {{ section.settings.rows }},
                  spaceBetween: {{ section.settings.column_gap }},
                  autoHeight: false,
                  simulateTouch: true,
                  {% if section.settings.enable_autoplay %}autoplay: { delay: {{ section.settings.slider_autoplay }}000, disableOnInteraction: false },{% endif %}
                  direction: 'horizontal',
                  slidesPerColumnFill: 'row',
                  breakpoints: {
                    320: { slidesPerView: {{ section.settings.items_mobile_view }}, slidesPerColumn: 1, spaceBetween: 20 },
                    768: { slidesPerView: {{ section.settings.items_tablet_view }}, slidesPerColumn: 1, spaceBetween: 20 },
                    1024: { slidesPerView: {{ section.settings.items_laptop_view }}, slidesPerColumn: 1, spaceBetween: 40 },
                    1920: { slidesPerView: {{ section.settings.items_per_view }}, slidesPerColumn: {{ section.settings.rows }}, spaceBetween: {{ section.settings.column_gap }} }
                  }
                });
                $('.tablinks').each(function(){
                  $(this).on('click', function(){
                    let thisSwiper = document.getElementById('swiper-{{ block.type }}-{{ forloop.index }}-{{ block.settings.block_title | handle }}-slider');
                    thisSwiper.swiper.update();
                  });
                });
              });
            </script>
          </div>

          {% else %}
          <div class="dt-sc-tabs-content dT_vDynamicPWrap-{{ section.id }}-tab-{{ forloop.index }} dT_vProdWrap"
            data-tab="dT_tab-{{ forloop.index }}-{{ block.settings.block_title | handle }}"
            data-section-id="home-tab-grid"
            data-section-type="home-tab-grid"
            data-collection="{{ block.settings.tab }}"
            data-post-limit="{{ section.settings.post_limit }}">

            {%- comment -%}
              ── 72-HOUR ROTATION ──
              day_of_year gives 1-365 and is fully supported in Shopify Liquid.
              Dividing by 3 creates a period that changes every 3 days (72 hours).
              Each tab uses a different seed so tabs never show the same
              products as each other on the same rotation period.
              Two-pass system avoids negative number issues in Liquid.
            {%- endcomment -%}
            {%- assign tab_total = tab_collection.products.size -%}
            {%- assign tab_limit = section.settings.post_limit -%}
            {%- assign day_of_year = 'now' | date: '%j' | plus: 0 -%}
            {%- assign period_72h = day_of_year | divided_by: 3 -%}
            {%- assign tab_seed = period_72h | plus: forloop.index | times: 7 -%}
            {%- if tab_total > 0 -%}
              {%- assign tab_offset = tab_seed | modulo: tab_total -%}
            {%- else -%}
              {%- assign tab_offset = 0 -%}
            {%- endif -%}

            <ul class="grid product-collection dt-sc-column {{ column }} {% if section.settings.enable_list_view %}product-list-style{% endif %}" id="iv-product-grid-{{ section.id }}-{{ forloop.index }}">
              {%- assign tab_count = 0 -%}

              {%- comment -%} Pass 1: from offset to end of collection {%- endcomment -%}
              {%- for product in tab_collection.products -%}
                {%- if forloop.index0 >= tab_offset and tab_count < tab_limit -%}
                  {% render 'product-grid-item', product: product, swiperSlideClass: 'regular-grid' %}
                  {%- assign tab_count = tab_count | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}

              {%- comment -%} Pass 2: wrap from start if still need more {%- endcomment -%}
              {%- if tab_count < tab_limit -%}
                {%- for product in tab_collection.products -%}
                  {%- if forloop.index0 < tab_offset and tab_count < tab_limit -%}
                    {% render 'product-grid-item', product: product, swiperSlideClass: 'regular-grid' %}
                    {%- assign tab_count = tab_count | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}

              {%- if tab_count == 0 -%}
                {% for i in (1..4) %}{% render 'empty-row' %}{% endfor %}
              {%- endif -%}
            </ul>

            <div class="iv-tab-buttons" style="display:flex; gap:12px; justify-content:center; margin-top:30px; flex-wrap:wrap;">
              <button class="dt-sc-btn iv-load-more-btn"
                data-grid-id="iv-product-grid-{{ section.id }}-{{ forloop.index }}"
                data-collection="{{ block.settings.tab }}"
                data-loaded="{{ section.settings.post_limit }}"
                data-per-page="{{ section.settings.post_limit }}"
                data-column="{{ column }}"
                data-list-view="{% if section.settings.enable_list_view %}product-list-style{% endif %}">
                Load More
              </button>
              {% if tab_collection_url != blank %}
              <a href="{{ tab_collection_url }}" class="dt-sc-btn iv-explore-btn">
                Explore {{ block.settings.block_title }}
              </a>
              {% endif %}
            </div>
          </div>
          {% endif %}

          {% endcase %}
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if section.blocks.size > 0 %}</div>{% endif %}
    </div>
  </div>
</div>

<script type="text/javascript">
  $('.tabs_wrapper.tab-{{ section.id }}-js').each(function(){
    $(this).find('.dt-sc-tabs-content:first').addClass('active');
    $(this).find('.tablinks:first').addClass('active');
  });

  $('.tabs_wrapper.tab-{{ section.id }}-js .tablinks').each(function(){
    $(this).on('click', function(){
      var $this = $(this);
      var $theTab = $(this).attr('id');
      if($this.hasClass('active')){
        // do nothing
      } else {
        $this.closest('.tabs_wrapper').find('.tabs .tablinks, .tabs_container .dt-sc-tabs-content').removeClass('active');
        $('.tabs_container .dt-sc-tabs-content[data-tab="'+$theTab+'"], .tabs .tablinks[id="'+$theTab+'"]').addClass('active');
      }
    });
  });

  // ── LOAD MORE ──
  $(document).on('click', '.iv-load-more-btn', function() {
    var $btn = $(this);
    var collection = $btn.data('collection');
    var loaded = parseInt($btn.data('loaded'));
    var perPage = parseInt($btn.data('per-page'));
    var gridId = $btn.data('grid-id');
    var $grid = $('#' + gridId);

    if (!collection || !gridId) return;

    $btn.text('Loading...').prop('disabled', true);

    var nextPage = Math.floor(loaded / perPage) + 2;

    $.ajax({
      url: '/collections/' + collection + '/products.json',
      data: { limit: perPage, page: nextPage },
      success: function(data) {
        var products = data.products;
        if (!products || products.length === 0) {
          $btn.text('No More Products').prop('disabled', true);
          return;
        }

        var html = '';
        $.each(products, function(i, product) {
          var img = product.images.length > 0 ? product.images[0].src : '';
          var rawPrice = product.variants[0].price;
          var rawCompare = product.variants[0].compare_at_price;
          var price = (rawPrice / 100).toFixed(2);
          var comparePrice = rawCompare ? (rawCompare / 100).toFixed(2) : null;
          var saleHtml = comparePrice && rawCompare > rawPrice
            ? '<span class="badge sale-badge">Sale</span>'
            : '';
          var priceHtml = comparePrice && rawCompare > rawPrice
            ? '<span class="money">$' + price + '</span> <del><span class="money">$' + comparePrice + '</span></del>'
            : '<span class="money">$' + price + '</span>';

          html += '<li class="regular-grid product-grid-item">';
          html += '<div class="products">';
          html += '<div class="product-container">';
          html += saleHtml;
          html += '<a href="/products/' + product.handle + '" class="product-image">';
          html += img ? '<img src="' + img + '" alt="' + product.title + '" loading="lazy" width="400" height="400">' : '';
          html += '</a>';
          html += '</div>';
          html += '<div class="product-detail">';
          html += '<div class="grid-link__title"><a href="/products/' + product.handle + '">' + product.title + '</a></div>';
          html += '<div class="grid-link__meta">' + priceHtml + '</div>';
          html += '</div>';
          html += '</div>';
          html += '</li>';
        });

        $grid.append(html);
        $btn.data('loaded', loaded + products.length).text('Load More').prop('disabled', false);

        if (products.length < perPage) {
          $btn.text('No More Products').prop('disabled', true);
        }
      },
      error: function() {
