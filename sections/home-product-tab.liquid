  #shopify-section-{{ section.id }}.home-product-carousel .grouped-content .additional-block .products .product-detail .dt-sc-btn-group,
  #shopify-section-{{ section.id }}.home-product-carousel .grouped-content .additional-block .products .product-detail del { display: none; }
  #shopify-section-{{ section.id }}.home-product-carousel .grouped-content .additional-block .product-list-style:not(.swiper-wrapper) { display: grid; }
  #shopify-section-{{ section.id }}.home-product-carousel .grouped-content .additional-block .product-list-style { margin-bottom: 0; }
  #shopify-section-{{ section.id }}.home-product-carousel .grouped-content .additional-block .products .product-detail .grid-link__title { padding-top: 0; }
  #shopify-section-{{ section.id }}.home-product-carousel .grouped-content .additional-block .products .product-detail .grid-link__title a { font-size: var(--DTFontSize_H6); }
  #shopify-section-{{ section.id }}.home-product-carousel .grouped-content .additional-block .products .product-detail .grid-link__meta { margin-bottom: 0; }
  #shopify-section-{{ section.id }}.home-product-carousel .main-block .tablinks { display: inline-block; margin: 0 0 4px 0; border-radius: var(--DTRadius); border-radius: {{ section.settings.border_radius }}px; }
  #shopify-section-{{ section.id }}.home-product-carousel .main-block .dt-sc-tabs-content { margin-top: 20px; border-radius: var(--DTRadius); }
  #shopify-section-{{ section.id }}.home-product-carousel .main-block.style-1 .dt-sc-tabs-content { background: var(--DTBodyBGColor); background: {{ section.settings.tab_content_bg_color }}; border-color: {{ section.settings.tab_content_border_color }}; }
  #shopify-section-{{ section.id }}.home-product-carousel .main-block.style-2 .dt-sc-tabs-content { padding: 0; border: none; }
  #shopify-section-{{ section.id }}.home-product-carousel .grouped-content .additional-block > *:not(:last-child) { margin-bottom: var(--DTGutter_Width); }
  #shopify-section-{{ section.id }}.home-product-carousel .main-block .tablinks { background: var(--DT_Button_BG_Color); background: {{ section.settings.tab_link_bg_color }}; color: var(--DT_Button_Text_Color); color: {{ section.settings.tab_link_color }}; }
  #shopify-section-{{ section.id }}.home-product-carousel .main-block .tablinks.active,
  #shopify-section-{{ section.id }}.home-product-carousel .main-block .tablinks:hover { background: var(--DT_Button_BG_Hover_Color); background: {{ section.settings.tab_link_bg_hover_color }}; color: var(--DT_Button_Text_Hover_Color); color: var(--DT_product_title_hover_color); }
  .dt-sc-tabs-content.active { display: block; }
  #shopify-section-{{ section.id }}.home-product-carousel .main-block .tablinks { position: relative; padding: 5px 40px !important; z-index: 1; overflow: visible; font-size: 24px; }
  #shopify-section-{{ section.id }}.home-product-carousel .main-block .tablinks.active,
  #shopify-section-{{ section.id }}.home-product-carousel .main-block .tablinks:hover { background: 0; }
  #shopify-section-{{ section.id }}.home-product-carousel .main-block .tablinks:after { content: ""; width: 0; position: absolute; top: 0; height: 100%; left: -5px; background: {{ section.settings.tab_link_bg_hover_color }}; opacity: 0; z-index: -1; pointer-events: none; transition: all .35s ease; }
  #shopify-section-{{ section.id }}.home-product-carousel .tabs { margin-bottom: 50px; }
  #shopify-section-{{ section.id }}.home-product-carousel .main-block .tablinks.active:after,
  #shopify-section-{{ section.id }}.home-product-carousel .main-block .tablinks:hover:after { opacity: 1; width: 122px; }

  /* ── IV Button Styles ── */
  #shopify-section-{{ section.id }}.home-product-carousel .iv-tab-buttons { margin-top: 30px; }
  #shopify-section-{{ section.id }}.home-product-carousel .iv-load-more-btn { background: var(--DT_Button_BG_Color); color: var(--DT_Button_Text_Color); border: 2px solid var(--DT_Button_BG_Color); cursor: pointer; }
  #shopify-section-{{ section.id }}.home-product-carousel .iv-load-more-btn:hover { background: var(--DT_Button_BG_Hover_Color); color: var(--DT_Button_Text_Hover_Color); }
  #shopify-section-{{ section.id }}.home-product-carousel .iv-explore-btn { background: transparent; color: var(--DT_Button_BG_Color); border: 2px solid var(--DT_Button_BG_Color); }
  #shopify-section-{{ section.id }}.home-product-carousel .iv-explore-btn:hover { background: var(--DT_Button_BG_Color); color: var(--DT_Button_Text_Color); }
  #shopify-section-{{ section.id }}.home-product-carousel .iv-load-more-btn:disabled { opacity: 0.5; cursor: not-allowed; }
{%- endstyle -%}

