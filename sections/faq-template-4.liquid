{%- liquid
  assign margin = section.settings.margin | split: ','
  assign margin_top = margin[0]
  assign margin_bottom = margin[1]

  assign padding = section.settings.padding | split: ','
  assign padding_top = padding[0]
  assign padding_bottom = padding[1]

  if section.settings.enable_overlay
  assign section_overlay = "dt-sc-overlay"
  endif

  if section.settings.show_background_image
  assign lazyScript = "lazyload"
  endif
if section.blocks.size > 0
case section.blocks.size
when 1
assign blockSize = 'two-items'
when 2
assign blockSize = 'two-items'
when 3
assign blockSize = 'three-items'
when 4
assign blockSize = 'four-items'
when 5
assign blockSize = 'five-items'
else
assign blockSize = 'three-items'
endcase
endif
%}

<div data-section-id="{{ section.id }}" data-section-type="faq-block-section">
  <div class="dt-sc-section-wrapper  {{ lazyScript }} {{ section_overlay }} {% if section.settings.background_style == 'parallax' %} parallax-initiated{% endif %}" {% if section.settings.background_style == 'parallax' %} data-speed="2" data-style="parallax"{% endif %} style="{% render 'bg-color-image-padding' %} background-size: {{- section.settings.background_size -}}; {% if section.settings.background_style == 'fixed' %}background-attachment: fixed;{% endif %} background-repeat:{% if section.settings.background_size == 'repeat' %}repeat{% else %}no-repeat;{% endif %}" {% render 'bg_image' %}>
    <div class="{% render 'container-settings' %}">
      <div class="row {{ section.settings.custom_class_name }}">
        <div class="dt-sc-faqs">
          {% render 'section-heading', class: section.id %}

          <div class="dt-sc-accordion-container {{ section.settings.text_position }} {{ section.settings.block_style }}
            {% if section.settings.enable_segmented_layout %} segmented-layout {% endif %} {{ blockSize }}  wow {% if section.settings.animation_effect_section != 'none' %} {{ section.settings.animation_effect_section }} {% endif %} ">
            {% if section.blocks.size > 0 %}
            {% for block in section.blocks limit: 4 %}

            <div class="dt-sc-accordion">
            {% if block.settings.title != blank %}
            <div class="dt-sc-accordion-btn">
             {% if section.settings.enable_heading_icons %}
              {% if block.type == 'icon' %} <h5 {% if forloop.first %}class="active"{% endif %}>

              {% if block.settings.icon != blank %}
              {%- capture sizes -%}
              (min-width: 990px) {% if section.blocks.size <= 2 %}710px{% else %}550px{% endif %}, (min-width: 750px) {% if section.blocks.size == 1 %}710px{% else %}550px{% endif %}, calc(100vw - 30px)
              {%- endcapture -%}
                            {{ block.settings.icon | image_url: width: 1420 | image_tag:
                              loading: 'lazy',
                              sizes: sizes,
                              widths: '275, 550, 710, 1420'
                            }}
                  {% endif %}
              {{ block.settings.title }}</h5>
              {% endif %}

              {% if block.type == 'class' %}<h5 {% if forloop.first %}class="active"{% endif %}><i class="{{ block.settings.class }}"></i>{{ block.settings.title }}</h5>{% endif %}
              {% else %}
              <h5 {% if forloop.first %}class="active"{% endif %}>{{ block.settings.title }}</h5>
              {% endif %}
            </div>
            {% endif %}
            {% if block.settings.desc != blank %}
            <div class="dt-sc-accordion-content {% if forloop.first %}open{% endif %}">
              <div class="dt-sc-accordion-content-inner">
                <p>{{ block.settings.desc }}</p>
              </div>
            </div>
            {% endif %}
            </div>
            {% endfor %}
            {% endif %}

          </div>

          <div class="dt-sc-accordion-container {{ section.settings.text_position }} {{ section.settings.block_style }}
            {% if section.settings.enable_segmented_layout %} segmented-layout {% endif %} {{ blockSize }}  wow {% if section.settings.animation_effect_section != 'none' %} {{ section.settings.animation_effect_section }} {% endif %} ">
            {% if section.blocks.size > 0 %}
            {% for block in section.blocks limit: 4 %}

            <div class="dt-sc-accordion">
            {% if block.settings.title != blank %}
            <div class="dt-sc-accordion-btn">
             {% if section.settings.enable_heading_icons %}
              {% if block.type == 'icon' %} <h5 {% if forloop.first %}class="active"{% endif %}>

              {% if block.settings.icon != blank %}
                {%- capture sizes -%}
                (min-width: 990px) {% if section.blocks.size <= 2 %}710px{% else %}550px{% endif %}, (min-width: 750px) {% if section.blocks.size == 1 %}710px{% else %}550px{% endif %}, calc(100vw - 30px)
                {%- endcapture -%}
                  {{ block.settings.icon | image_url: width: 1420 | image_tag: loading: 'lazy', sizes: sizes, widths: '275, 550, 710, 1420' }}
                  {% endif %}
              {{ block.settings.title }}</h5>
              {% endif %}

              {% if block.type == 'class' %}<h5 {% if forloop.first %}class="active"{% endif %}><i class="{{ block.settings.class }}"></i>{{ block.settings.title }}</h5>{% endif %}
              {% else %}
              <h5 {% if forloop.first %}class="active"{% endif %}>{{ block.settings.title }}</h5>
              {% endif %}
            </div>
            {% endif %}
            {% if block.settings.desc != blank %}
            <div class="dt-sc-accordion-content {% if forloop.first %}open{% endif %}">
              <div class="dt-sc-accordion-content-inner">
                <p>{{ block.settings.desc }}</p>
              </div>
            </div>
            {% endif %}
            </div>
            {% endfor %}
            {% endif %}
          </div>


        </div>
      </div>
    </div>
  </div>
</div>

<style>

/* .dt-sc-faqs .dt-sc-accordion-container{ max-width:700px; margin:auto; } */
  .faq-template-4 .dt-sc-faqs{display: grid;grid-template-columns: repeat(2,1fr);grid-gap: 30px;}
  #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-heading .dt-sc-main-heading { color: var(--DTColor_Heading); color:{{ section.settings.section_heading_color }}; }
  #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-heading .dt-sc-sub-heading { color: var(--DTColor_Heading); color:{{ section.settings.section_sub_heading_color }}; }
  #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-heading .dt-sc-heading-description { color: var(--DTColor_Body); color:{{ section.settings.section_description_color }}; }
  #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-heading .dt-sc-btn {
    background: var(--DT_Button_BG_Color);  background:{{ section.settings.section_button_bg_color }};
      color: var(--DT_Button_Text_Color); color:{{ section.settings.section_button_text_color }};
        }
  #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-heading .dt-sc-btn:hover {
    background: var(--DT_Button_BG_Hover_Color); background:{{ section.settings.section_button_hover_bg_color }};
      color: var(--DT_Button_Text_Hover_Color); color:{{ section.settings.section_button_hover_text_color }};
        }

  #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-overlay:before  { color: var(--DTTertiaryColor);
    color: {{ section.settings.background_color }};
    background: currentcolor;
    opacity: {{ section.settings.overlay_transparency }}; }

  .text-center .dt-sc-accordion-btn h5 { justify-content: center; }
  .text-end .dt-sc-accordion-btn h5 { justify-content: flex-end; }

  .dt-sc-accordion-container { width: 100%; margin: 0 auto; overflow: hidden; }

  #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-accordion-container:not(.segmented-layout) {
    border-radius: var(--DTRadius); border-radius: {{ section.settings.border_radius }}px;
      {% if section.settings.enable_box_shadow %} box-shadow: var(--DTboxShadow); {% endif %}
        }

  .dt-sc-accordion-container .dt-sc-accordion-btn { width: 100%; margin: 0 auto; cursor: pointer; padding: 20px 65px 20px 20px;


  .dt-sc-accordion-container.text-center .dt-sc-accordion-btn { padding: 20px 65px 20px 65px;  }
  .dt-sc-accordion-container.text-end .dt-sc-accordion-btn { padding: 20px 20px 20px 65px;  }

  .dt-sc-accordion-container .dt-sc-accordion-btn h5 { margin: 0; position: relative; display: flex; align-items: center; }

  #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-accordion-container .dt-sc-accordion-btn h5 i,
  #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-accordion-container .dt-sc-accordion-btn h5 img {
    font-size: {{ section.settings.faq_icon_size }}px; margin: 0 10px 0 0; text-align: center; width: {{ section.settings.faq_icon_size }}px;

  }


  .dt-sc-accordion-container .dt-sc-accordion-btn h5:after { content: "\f067"; display: block; position: absolute; font-family: FontAwesome; top: 50%; left: -35px;
    right: auto; transition: var(--DTBaseTransition); transform: translateY(-50%);
      }

  #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-accordion-container.text-start .dt-sc-accordion-btn h5::after { right: -35px; left: auto; }


  .dt-sc-accordion-container .dt-sc-accordion-btn h5.active:after { content: "\f068"; }
  .dt-sc-accordion-container .dt-sc-accordion-content { height: 0px; width: 100%; margin: 0 auto; overflow: hidden; }

  .dt-sc-accordion-container.segmented-layout { box-shadow: none; border-radius: 0; overflow: visible; }

  #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-accordion-container.segmented-layout .dt-sc-accordion-btn {
    border-radius: {{ section.settings.border_radius }}px {{ section.settings.border_radius }}px 0 0;

    {% if section.settings.enable_box_shadow %} box-shadow: var(--DTboxShadow); {% endif %}
      }

  #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-accordion-container.segmented-layout .dt-sc-accordion-content {
    border-radius: 0 0 {{ section.settings.border_radius }}px {{ section.settings.border_radius }}px;
    margin-bottom: {{ section.settings.segmented_layout_gap }}px;
    {% if section.settings.enable_box_shadow %} box-shadow: var(--DTboxShadow); {% endif %} z-index: -1; position: relative; }

  .dt-sc-accordion-container .dt-sc-accordion-content-inner { padding: 30px; }
  .dt-sc-accordion-container .dt-sc-accordion-content-inner p:last-child { margin-bottom: 0; }

  .dt-sc-accordion-container .dt-sc-accordion-content.open { height: auto; }

  .dt-sc-accordion-container[class*="style-"] { counter-reset: dt-sc-accordion-counter; }
  .dt-sc-accordion-container[class*="style-"] .dt-sc-accordion-btn { counter-increment: dt-sc-accordion-counter; }
  .dt-sc-accordion-container[class*="style-"] .dt-sc-accordion-btn h5 { display: flex; align-items: center; flex-wrap: wrap; }
  .dt-sc-accordion-container[class*="style-"] .dt-sc-accordion-btn h5:before { display: block !important; position: relative; padding-right: 5px; }

  .dt-sc-accordion-container[class*="style-2"] .dt-sc-accordion-btn h5:before { content: counter(dt-sc-accordion-counter, decimal)'.'; }
  .dt-sc-accordion-container[class*="style-3"] .dt-sc-accordion-btn h5:before { content: 'Q'counter(dt-sc-accordion-counter, decimal)'.'; }
  .dt-sc-accordion-container[class*="style-4"] .dt-sc-accordion-btn h5:before { content: counter(dt-sc-accordion-counter, upper-alpha)'.'; }


  #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-accordion-container .dt-sc-accordion-btn {
    background: var(--DT_Button_BG_Color); background-color: {{ section.settings.faq_heading_bg_color }};
      }
  #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-accordion-container .dt-sc-accordion-btn h5 {
    color: var(--DT_Button_Text_Color); color: {{ section.settings.faq_heading_color }};
      }

  #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-accordion-container .dt-sc-accordion-content {
    background-color: var(--DTTertiaryColor);
      color: var(--DTColor_Body);
        background-color: {{ section.settings.faq_content_bg_color }};
        color: {{ section.settings.faq_content_color }};
        }



  #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-accordion-container .dt-sc-accordion-btn h5 i,
  #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-accordion-container .dt-sc-accordion-btn h5 img {
    font-size: calc(.65 * {{ section.settings.faq_icon_size }}px);
    width: calc(.65 * {{ section.settings.faq_icon_size }}px);
  }
  #shopify-section-faq-template.faq-template-4 .dt-sc-accordion-container .dt-sc-accordion-btn, #shopify-section-faq-template.faq-template-4 .dt-sc-accordion-container.segmented-layout  .dt-sc-accordion-btn{border-radius:var(--DTRadius) !important}




  @media only screen and (min-width: 1200px) {
    #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-section-wrapper { margin-top:{{ margin_top }}px; margin-bottom:{{ margin_bottom }}px;padding-top:{{ padding_top }}px; padding-bottom:{{ padding_bottom }}px; }
  }

  @media only screen and (max-width: 1199px) {
    #shopify-section-{{ section.id }}.faq-template-4 .dt-sc-section-wrapper { margin-top:{{ margin_top | divided_by: 2 }}px; margin-bottom:{{ margin_bottom | divided_by: 2 }}px;padding-top:{{ padding_top | divided_by: 2 }}px; padding-bottom:{{ padding_bottom | divided_by: 2 }}px;}
  }
  @media only screen and (max-width: 767px) {
  .faq-template-4 .dt-sc-faqs {grid-template-columns: repeat(1,1fr);}
  }
</style>

