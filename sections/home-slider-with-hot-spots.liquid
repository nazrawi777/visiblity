{% schema %}
{
"name": "Slider with hotspot",
"class": "index-section home-slideshow-with-hotspot home-slider-with-hot-spots",
"max_blocks": 10,
"settings": [
{
"type": "header",
"content": "Outer Settings"
},
{
"type": "checkbox",
"id": "full",
"label": "Show Full width"
},
{
"type": "checkbox",
"id": "spacing_both_ends",
"label": "Enable Right & Left Spacing (Works only on Fullwidth)",
"default": false
},
{
"type": "text",
"id": "margin",
"label": "Style value (Margin)",
"default":"0,0",
"info":"Top(px),Bottom(px)"
},
{
"type": "header",
"content": "Slide Image Height"
},
{
"type": "range",
"id": "slider_height",
"label": "Desktop",
"min": 400,
"max": 1200,
"step": 10,
"default": 850,
"unit": "px"
},
{
"type": "range",
"id": "slider_height_lap",
"label": "Laptop",
"min": 400,
"max": 1200,
"step": 10,
"default": 700,
"unit": "px"
},
{
"type": "range",
"id": "slider_height_tab",
"label": "Tablet",
"min": 400,
"max": 1200,
"step": 10,
"default": 600,
"unit": "px"
},
{
"type": "range",
"id": "slider_height_mobile",
"label": "Mobile",
"min": 300,
"max": 1200,
"step": 10,
"default": 350,
"unit": "px"
},
{
"type": "text",
"id": "video-aspect-ratio",
"label": "Video/Image Aspect Ratio",
"info":"Default Value: 16/9"
},
{
"type": "header",
"content": "Slide Settings"
},
{
"type": "checkbox",
"id": "content_within_container",
"label": "Content Within Container",
"default": false
},
{
"type": "checkbox",
"id": "enable_box_shadow",
"label": "Enable Box Shadow",
"default": false
},
{
"type": "text",
"id": "border_radius",
"label": "Overall Border Radius(Leave empty for Theme Default Border Radius)",
"default":"0",
"info": "Units not needed"
