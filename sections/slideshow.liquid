{% schema %}
{
  "name": "Slider",
  "class": "index-section home-slideshow-section",
  "max_blocks": 10,
  "settings": [
    {"type": "header","content": "Outer Settings"},
    {"type": "checkbox","id": "full","label": "Show Full width"},
    {"type": "checkbox","id": "spacing_both_ends","label": "Enable Right & Left Spacing (Works only on Fullwidth)","default": false},
    {"type": "text","id": "margin","label": "Style value (Margin)","default":"0,0","info":"Top(px),Bottom(px)"},
    {"type": "header","content": "Slide Image Height"},
    {"type": "range","id": "slider_height","label": "Desktop","min": 400,"max": 1200,"step": 10,"default": 850,"unit": "px"},
    {"type": "range","id": "slider_height_lap","label": "Laptop","min": 400,"max": 1200,"step": 10,"default": 700,"unit": "px"},
    {"type": "range","id": "slider_height_tab","label": "Tablet","min": 400,"max": 1200,"step": 10,"default": 600,"unit": "px"},
    {"type": "range","id": "slider_height_mobile","label": "Mobile","min": 300,"max": 1200,"step": 10,"default": 350,"unit": "px"},
    {"type": "text","id": "video-aspect-ratio","label": "Video/Image Aspect Ratio","info":"Default Value: 16/9"},
    {"type": "header","content": "Slide Settings"},
    {"type": "checkbox","id": "content_within_container","label": "Content Within Container","default": false},
    {"type": "checkbox","id": "enable_box_shadow","label": "Enable Box Shadow","default": false},
    {"type": "text","id": "border_radius","label": "Overall Border Radius","default":"0","info": "Units not needed"},
    {"type": "text","id": "content_border_radius","label": "Content Border Radius","default":"0","info": "Units not needed"},
    {"type": "checkbox","id": "autoplay","label": "Enable Autoplay Slides","default": false},
    {"type": "select","id": "slideshow_speed","label": "Change slides every","options": [{"value": "5000","label": "5 seconds"},{"value": "6000","label": "6 seconds"},{"value": "7000","label": "7 seconds"},{"value": "8000","label": "8 seconds"},{"value": "9000","label": "9 seconds"},{"value": "10000","label": "10 seconds"}],"default": "5000"},
    {"type": "select","id": "slideshow_effect","label": "Slideshow Effect","options": [{"value": "fade","label": "Fade"},{"value": "slide","label": "Slide"},{"value": "flip","label": "Flip"}],"default": "fade"},
    {"type": "checkbox","id": "dots","label": "Enable Pagination Dots","default": true},
    {"type": "select","id": "carousel_pagination_alignment","label": "Pagination Dots Alignment","options": [{"value": "left_pagination","label": "Left Aligned"},{"value": "center_pagination","label": "Center Aligned"},{"value": "right_pagination","label": "Right Aligned"}],"default": "center_pagination"},
    {"type": "select","id": "carousel_pagination_bottom_alignment","label": "Pagination Dots Bottom Alignment","options": [{"value": "inside_element","label": "Inside the Element"},{"value": "outside_element","label": "Outside the Element"}],"default": "inside_element"},
    {"type": "checkbox","id": "arrows","label": "Enable Navigation Arrows","default": true},
    {"type": "select","id": "nav_arrow_position","label": "Navigation Arrows position","options": [{"value": "navigation-top-left","label": "Top Left"},{"value": "navigation-top-center","label": "Top Center"},{"value": "navigation-top-right","label": "Top Right"},{"value": "center-navigation","label": "Center"},{"value": "navigation-bottom-left","label": "Bottom left"},{"value": "navigation-bottom-center","label": "Bottom center"},{"value": "navigation-bottom-right","label": "Bottom right"}],"default": "navigation-bottom-center"},
    {"type": "select","id": "center_nav_arrow_alignment","label": "Navigation Arrows alignment","options": [{"value": "along_with_container","label": "Along with Container"},{"value": "inside_container","label": "Inside Container"},{"value": "outside_container","label": "Outside Container"}],"default": "inside_container"},
    {"type": "header","content": "Navigation Colors"},
    {"type": "color","id": "navigation_button_color","label": "Navigation Arrow Bg Color"},
    {"type": "color","id": "navigation_button_icon_color","label": "Navigation Arrow Icon Color"},
    {"type": "color","id": "navigation_button_hover_color","label": "Navigation Arrow Hover Bg Color"},
    {"type": "color","id": "navigation_button_hover_icon_color","label": "Navigation Arrow Hover Icon Color"},
    {"type": "color","id": "navigation_dot_color","label": "Navigation Dot Color"},
    {"type": "color","id": "navigation_dot_active_color","label": "Navigation Dot Active Color"},
    {"type": "header","content": "Custom class"},
    {"type": "text","id": "custom_class_name","label": "Add your custom class name here"}
  ],
  "blocks": [
    {
      "type": "Slider",
      "name": "Slider",
      "settings": [
        {"type": "text","id": "slide_label","label": "Slide Name (for customizer only)","default": "Slide"},
        {"type": "select","id": "slider_type","label": "Slider type","options": [{"value": "video","label": "Video"},{"value": "image","label": "Image"}],"default": "image"},
        {"type": "image_picker","id": "image","label": "Desktop Slider Image"},
        {"type": "image_picker","id": "mobile_image","label": "Mobile Slider Image","info": "768x900"},
        {"type": "textarea","id": "video_url","label": "Video URL","default": "https://storage.googleapis.com/coverr-main/mp4/Palm_Trees.mp4"},
        {"type": "textarea","id": "iframe_url","label": "Iframe"},
        {"type": "color","id": "mobile_bg_clr","label": "Mobile Bg Color"},
        {"type": "header","content": "Slider Content"},
        {"type": "select","id": "text_alignment","label": "Text Alignment","options": [{"value": "text-start","label": "Left"},{"value": "text-center","label": "Center"},{"value": "text-end","label": "Right"}],"default": "text-center"},
        {"type": "select","id": "content_position","label": "Content position","options": [{"value": "top-left","label": "Top Left"},{"value": "top-center","label": "Top Center"},{"value": "top-right","label": "Top Right"},{"value": "center-left","label": "Center left"},{"value": "dt-sc-flex-center","label": "Center"},{"value": "center-right","label": "Center right"},{"value": "bottom-left","label": "Bottom left"},{"value": "bottom-center","label": "Bottom center"},{"value": "bottom-right","label": "Bottom right"}],"default": "dt-sc-flex-center"},
        {"type": "image_picker","id": "block_image","label": "Slider Content Icon/Image","info": "Size: 1280x820"},
        {"type": "checkbox","id": "show_image","label": "Show image","default": false},
        {"type": "checkbox","id": "show_content","label": "Show content","default": false},
        {"type": "checkbox","id": "enable_block_image_with_content","label": "Enable Image with Content","default": false,"info": "If enabled not work content position"},
