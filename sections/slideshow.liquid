{%- liquid
  assign margin = section.settings.margin | split: ','
  assign top = margin[0]
  assign bottom = margin[1]
-%}

<div class="{% render 'container-settings' %} iv-hero-section" data-iv-hero
  data-section-id="{{ section.id }}"
  data-section-type="slideshow-section"
  data-autoPlay="{{ section.settings.autoplay }}"
  data-animation-speed="{{ section.settings.slideshow_speed }}"
  data-effect="{{ section.settings.slideshow_effect }}"
  >
  <div class="row {{ section.settings.custom_class_name }}">
    <div class="dt-sc-swiper-slider swiper-container {% if section.settings.dots %} {{ section.settings.carousel_pagination_bottom_alignment }} {{ section.settings.carousel_pagination_alignment }} {% endif %} {% if section.settings.arrows %} {{ section.settings.nav_arrow_position }} {{ section.settings.center_nav_arrow_alignment }} {% endif %}" style="margin-top:{{top}}px; margin-bottom:{{bottom}}px;">
      <div id="home-slider-{{ section.id -}}">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
          {%- liquid
            if block.settings.text_alignment == 'text-start'
              assign style = '1'
            elsif block.settings.text_alignment == 'text-end'
              assign style = '2'
            else
              assign style = '3'
            endif
          -%}
          <div class="slider_style_{{ style }} slider-{{ block.id }}-list swiper-slide {% if block.settings.slider_type == 'video' %}video-cover{% endif %}" data-iv-slide-content>
            {% render 'slider-data', block: block, is_first: forloop.first %}

            {%- comment -%}
              ── IV INVISIBLE BUTTON OVERLAYS ──
              Desktop overlays use forloop.index 1-4.
              Mobile overlays use forloop.index 2-4 only.
              Slide 1 (Wear Legends) has no mobile version so no mobile overlay.
              All overlays are transparent clickable links positioned over
              the button artwork baked into each slide image.
            {%- endcomment -%}

            {%- comment -%} ── DESKTOP OVERLAYS ── {%- endcomment -%}

            {%- if forloop.index == 1 -%}
              <a href="https://www.infinitevisibility7.com/collections/online-anime-shop-about-infinite-visibility-premium-store"
                 class="iv-slide-btn-overlay iv-slide1-btn iv-desktop-only"
                 aria-label="Shop The Collection"
                 title="Shop The Collection"></a>
            {%- endif -%}

            {%- if forloop.index == 2 -%}
              <a href="https://www.infinitevisibility7.com/collections/all-products"
                 class="iv-slide-btn-overlay iv-slide2-btn-shop iv-desktop-only"
                 aria-label="Shop Now"
                 title="Shop Now"></a>
              <a href="https://www.infinitevisibility7.com/collections/free-coloring-pages-for-all-ages"
                 class="iv-slide-btn-overlay iv-slide2-btn-free iv-desktop-only"
                 aria-label="Free Downloads"
                 title="Free Downloads"></a>
            {%- endif -%}

            {%- if forloop.index == 3 -%}
              <a href="https://www.infinitevisibility7.com/search?q=One+Piece+&product=product"
                 class="iv-slide-btn-overlay iv-slide3-btn iv-desktop-only"
                 aria-label="Explore The Collection"
                 title="Explore The Collection"></a>
            {%- endif -%}

            {%- if forloop.index == 4 -%}
              <a href="https://www.infinitevisibility7.com/search?type=product&options%5Bprefix%5D=last&options%5Bunavailable_products%5D=last&q=Demon+Slayer+"
                 class="iv-slide-btn-overlay iv-slide4-btn iv-desktop-only"
                 aria-label="Shop Now — Demon Slayer"
                 title="Shop Now"></a>
            {%- endif -%}

            {%- comment -%} ── MOBILE OVERLAYS — slides 2, 3, 4 only ── {%- endcomment -%}

            {%- if forloop.index == 2 -%}
              <a href="https://www.infinitevisibility7.com/collections/all-products"
                 class="iv-slide-btn-overlay iv-mob-slide2-btn-shop iv-mobile-only"
                 aria-label="Shop Now"
                 title="Shop Now"></a>
              <a href="https://www.infinitevisibility7.com/collections/free-coloring-pages-for-all-ages"
                 class="iv-slide-btn-overlay iv-mob-slide2-btn-free iv-mobile-only"
                 aria-label="Free Downloads"
                 title="Free Downloads"></a>
            {%- endif -%}

            {%- if forloop.index == 3 -%}
              <a href="https://www.infinitevisibility7.com/search?q=One+Piece+&product=product"
                 class="iv-slide-btn-overlay iv-mob-slide3-btn iv-mobile-only"
                 aria-label="Explore The Collection"
                 title="Explore The Collection"></a>
            {%- endif -%}

            {%- if forloop.index == 4 -%}
              <a href="https://www.infinitevisibility7.com/search?type=product&options%5Bprefix%5D=last&options%5Bunavailable_products%5D=last&q=Demon+Slayer+"
                 class="iv-slide-btn-overlay iv-mob-slide4-btn iv-mobile-only"
                 aria-label="Shop Now — Demon Slayer"
                 title="Shop Now"></a>
            {%- endif -%}

          </div>
          {% endfor %}
        </div>

        {% if section.settings.arrows %}
        <div class="swiper-{{ section.id }}-arrows swiper-arrows">
          <div class="swiper-button-next dt-sc-btn" id="swiper-button-next-{{ section.id }}"></div>
          <div class="swiper-button-prev dt-sc-btn" id="swiper-button-prev-{{ section.id }}"></div>
        </div>
        {% endif %}

        {%- if section.settings.dots -%}
        <div class="swiper-pagination" id="swiper-pagination-{{ section.id }}"></div>
        {%- endif -%}

      </div>
    </div>
  </div>
</div>

<script>
  $( window ).on("load", function() {
    $( ".btn.play" ).each(function( index ) {
      $(this).on('click', function(){
        $(this).css('display','none');
        $(this).next('.btn.pause').css('display','flex');
        if($(this).parents('.video-cover').hasClass('swiper-slide-active')){
          $(this).parents('.video-cover').find('video').trigger('play');
        }
      });
    });
    $( ".btn.pause" ).each(function( index ) {
      $(this).on('click', function(){
        $(this).css('display','none');
        $(this).prev('.btn.play').css('display','flex');
        if($(this).parents('.video-cover').hasClass('swiper-slide-active')){
          $(this).parents('.video-cover').find('video').trigger('pause');
        }
      });
    });
    $('.swiper-button-next, .swiper-button-prev').on('click', function(){
      $(this).parents('.dt-sc-swiper-slider').find('video').trigger('pause');
      $(this).parents('.dt-sc-swiper-slider').find('.btn.pause').css('display','none');
      $(this).parents('.dt-sc-swiper-slider').find('.btn.play').css('display','flex');
    });
  });
</script>

