.has-sidebar.open .sidebar .dt-sc-btn.close-icon { left: {{ settings.sidebar_width }}px;}
.has-sidebar.open:after { background-color:{{ settings.overlay_color | color_modify: 'alpha', 0.7 }}; }
.has-sidebar.open:after {background-color:{{ settings.overlay_color | color_modify: 'alpha', 0.7 }}; }

