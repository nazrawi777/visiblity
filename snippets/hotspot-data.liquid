{% if block.settings.slider_type == 'image' %}
{% if  block.settings.image != blank %}
  <img
    srcset="{%- if block.settings.image.width >= 165 -%}{{ block.settings.image | image_url: width: 165 }} 165w,{%- endif -%}
    {%- if block.settings.image.width >= 360 -%}{{ block.settings.image | image_url: width: 360 }} 360w,{%- endif -%}
    {%- if block.settings.image.width >= 535 -%}{{ block.settings.image | image_url: width: 535 }} 535w,{%- endif -%}
    {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
    {%- if block.settings.image.width >= 1070 -%}{{ block.settings.image | image_url: width: 1070 }} 1070w,{%- endif -%}
    {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
    {{ block.settings.image | image_url: width: 1920 }} {{ block.settings.image.width }}w"
    src="{{ block.settings.image | image_url: width: 1500 }}"
    sizes="(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
    alt="{{ block.settings.image.alt }}"
    loading="lazy"
    class="slide-img"
    width="{{ block.settings.image.width }}"
    height="{{ block.settings.image.height }}"
    >

{% else %}
{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg slide-img desktop-only' }}
{% endif %}


{% if  block.settings.mobile_image != blank %}
  <img
    srcset="{%- if block.settings.mobile_image.width >= 165 -%}{{ block.settings.mobile_image | image_url: width: 165 }} 165w,{%- endif -%}
    {%- if block.settings.mobile_image.width >= 360 -%}{{ block.settings.mobile_image | image_url: width: 360 }} 360w,{%- endif -%}
    {%- if block.settings.mobile_image.width >= 535 -%}{{ block.settings.mobile_image | image_url: width: 535 }} 535w,{%- endif -%}
    {%- if block.settings.mobile_image.width >= 750 -%}{{ block.settings.mobile_image | image_url: width: 750 }} 750w,{%- endif -%}
    {%- if block.settings.mobile_image.width >= 1070 -%}{{ block.settings.mobile_image | image_url: width: 1070 }} 1070w,{%- endif -%}
    {%- if block.settings.mobile_image.width >= 1500 -%}{{ block.settings.mobile_image | image_url: width: 1500 }} 1500w,{%- endif -%}
    {{ block.settings.mobile_image | image_url: width: 1920 }} {{ block.settings.mobile_image.width }}w"
    src="{{ block.settings.mobile_image | image_url: width: 1500 }}"
    sizes="(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
    alt="{{ block.settings.mobile_image.alt }}"
    loading="lazy"
    class="slide-img mobile-only"
    width="{{ block.settings.mobile_image.width }}"
    height="{{ block.settings.mobile_image.height }}"
    >
{% else %}
<img
  srcset="{%- if block.settings.image.width >= 165 -%}{{ block.settings.image | image_url: width: 165 }} 165w,{%- endif -%}
  {%- if block.settings.image.width >= 360 -%}{{ block.settings.image | image_url: width: 360 }} 360w,{%- endif -%}
  {%- if block.settings.image.width >= 535 -%}{{ block.settings.image | image_url: width: 535 }} 535w,{%- endif -%}
  {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
  {%- if block.settings.image.width >= 1070 -%}{{ block.settings.image | image_url: width: 1070 }} 1070w,{%- endif -%}
  {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
  {{ block.settings.image | image_url: width: 1920 }} {{ block.settings.image.width }}w"
  src="{{ block.settings.image | image_url: width: 1500 }}"
  sizes="(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
  alt="{{ block.settings.image.alt }}"
  loading="lazy"
  class="slide-img mobile-only"
  width="{{ block.settings.image.width }}"
  height="{{ block.settings.image.height }}"
     >
{% endif %}
{% elsif block.settings.slider_type == 'video' %}
{% if block.settings.video_url != blank %}
<video poster="{{ block.settings.image | image_url: width: 1920 }}"
       width="1920" height="740"  muted loop>
  <source src="{{ block.settings.video_url }}" type="video/mp4">
  Your browser does not support the video tag.
</video>
{% else %}
{{ block.settings.iframe_url }}
{% endif %}
{% endif %}

<div class="dt-sc-hotspot-wrapper">
    <div class="dt-sc-hotspot-item dt-sc-hotspot-item{{ block.id }}_a block-type-{{ block.type }}">
      <a class="open-popup-link{{ block.id }}_a dt-sc-hotspot-marker dt-sc-hotspot-marker{{ block.id }}_a" href="#dt-sc-hotspot-marker{{ block.id }}_a"><span class="{{ section.settings.icon }}"></span></a>
      {% if block.settings.spot_1_title != blank or block.settings.spot_1_text != blank or block.settings.spot_1_link_text != blank %}
      <div id="dt-sc-hotspot-marker{{ block.id }}_a" class="dt-sc-hotspot-popup {{ block.settings.spot_1_text_position }}">
        <div class="dt-sc-hotspot-content {{ block.settings.spot_1_content_alignment }}">
          {% if block.settings.spot_1_title != blank %}
          <h4 class="dt-sc-hotspot-content-title"><a href="{{ block.settings.spot_1_link }}" title="{{ block.settings.spot_1_title }}">{{ block.settings.spot_1_title }}</a></h4>
          {% endif %}
          {% if block.settings.spot_1_text != blank %}
          <p>{{ block.settings.spot_1_text }}</p>
          {% endif %}
           {% if block.settings.spot_1_image != blank %}
          {{ block.settings.spot_1_image | image_url: width: 400 | image_tag: sizes: '(min-width:1600px) 960px, (min-width: 750px) calc((100vw - 11.5rem) / 2), calc(100vw - 4rem)' }}
          {% endif %}
          {% if block.settings.spot_1_link_text != blank and block.settings.spot_1_link != blank %}
          <a class="dt-sc-btn" href="{{ block.settings.spot_1_link }}">{{ block.settings.spot_1_link_text }}</a>
          {% endif %}
        </div>
      </div>
      {% endif %}

    </div>

<div class="dt-sc-hotspot-item dt-sc-hotspot-item{{ block.id }}_b block-type-{{ block.type }}">
      <a class="open-popup-link{{ block.id }}_b dt-sc-hotspot-marker dt-sc-hotspot-marker{{ block.id }}_b" href="#dt-sc-hotspot-marker{{ block.id }}_b"><span class="{{ section.settings.icon }}"></span></a>
      {% if block.settings.spot_2_title != blank or block.settings.spot_2_text != blank or block.settings.spot_2_link_text != blank %}
      <div id="dt-sc-hotspot-marker{{ block.id }}_b" class="dt-sc-hotspot-popup {{ block.settings.spot_2_text_position }}">
        <div class="dt-sc-hotspot-content {{ block.settings.spot_2_content_alignment }}">
          {% if block.settings.spot_2_title != blank %}
          <h4 class="dt-sc-hotspot-content-title"><a href="{{ block.settings.spot_2_link }}" title="{{ block.settings.spot_2_title }}">{{ block.settings.spot_2_title }}</a></h4>
          {% endif %}
          {% if block.settings.spot_2_text != blank %}
          <p>{{ block.settings.spot_2_text }}</p>
          {% endif %}
          {% if block.settings.spot_2_image != blank %}
          {{ block.settings.spot_2_image | image_url: width: 400 | image_tag: sizes: '(min-width:1600px) 960px, (min-width: 750px) calc((100vw - 11.5rem) / 2), calc(100vw - 4rem)' }}
          {% endif %}
          {% if block.settings.spot_2_link_text != blank and block.settings.spot_2_link != blank %}
          <a class="dt-sc-btn" href="{{ block.settings.spot_2_link }}">{{ block.settings.spot_2_link_text }}</a>
          {% endif %}
        </div>
      </div>
      {% endif %}

    </div>

<div class="dt-sc-hotspot-item dt-sc-hotspot-item{{ block.id }}_c block-type-{{ block.type }}">
      <a class="open-popup-link{{ block.id }}_c dt-sc-hotspot-marker dt-sc-hotspot-marker{{ block.id }}_c" href="#dt-sc-hotspot-marker{{ block.id }}_c"><span class="{{ section.settings.icon }}"></span></a>
      {% if block.settings.spot_3_title != blank or block.settings.spot_3_text != blank or block.settings.spot_3_link_text != blank %}
      <div id="dt-sc-hotspot-marker{{ block.id }}_c" class="dt-sc-hotspot-popup {{ block.settings.spot_3_text_position }}">
        <div class="dt-sc-hotspot-content {{ block.settings.spot_3_content_alignment }}">
          {% if block.settings.spot_3_title != blank %}
          <h4 class="dt-sc-hotspot-content-title"><a href="{{ block.settings.spot_3_link }}" title="{{ block.settings.spot_3_title }}">{{ block.settings.spot_3_title }}</a></h4>
          {% endif %}
          {% if block.settings.spot_3_text != blank %}
          <p>{{ block.settings.spot_3_text }}</p>
          {% endif %}
          {% if block.settings.spot_3_image != blank %}
          {{ block.settings.spot_3_image | image_url: width: 400 | image_tag: sizes: '(min-width:1600px) 960px, (min-width: 750px) calc((100vw - 11.5rem) / 2), calc(100vw - 4rem)' }}
          {% endif %}
          {% if block.settings.spot_3_link_text != blank and block.settings.spot_3_link != blank %}
          <a class="dt-sc-btn" href="{{ block.settings.spot_3_link }}">{{ block.settings.spot_3_link_text }}</a>
          {% endif %}
        </div>
      </div>
      {% endif %}

    </div>
</div>

{% if block.settings.show_content %}
<div class="slider-content slider-content-bg {{ block.settings.text_alignment }}  {{ block.settings.content_position }}">
  <div class="slide_{{ block.id }}">

    {% if block.settings.show_image %}
    {% if block.settings.block_image != blank %}
      <img
        srcset="{%- if block.settings.block_image.width >= 165 -%}{{ block.settings.block_image | image_url: width: 165 }} 165w,{%- endif -%}
        {%- if block.settings.block_image.width >= 360 -%}{{ block.settings.block_image | image_url: width: 360 }} 360w,{%- endif -%}
        {%- if block.settings.block_image.width >= 535 -%}{{ block.settings.block_image | image_url: width: 535 }} 535w,{%- endif -%}
        {%- if block.settings.block_image.width >= 750 -%}{{ block.settings.block_image | image_url: width: 750 }} 750w,{%- endif -%}
        {%- if block.settings.block_image.width >= 1070 -%}{{ block.settings.block_image | image_url: width: 1070 }} 1070w,{%- endif -%}
        {%- if block.settings.block_image.width >= 1500 -%}{{ block.settings.block_image | image_url: width: 1500 }} 1500w,{%- endif -%}
        {{ block.settings.block_image | image_url: width: 1920 }} {{ block.settings.block_image.width }}w"
        src="{{ block.settings.block_image | image_url: width: 1500 }}"
        sizes="(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
        alt="{{ block.settings.block_image.alt }}"
        loading="lazy"
        class="slide-img mobile-only"
        width="{{ block.settings.block_image.width }}"
        height="{{ block.settings.block_image.height }}"
        >
    {% else %}
    {{ 'image' | placeholder_svg_tag: 'placeholder_svg' }}
    {% endif %}
    {% endif %}



    {% if block.settings.title_2 != blank %}
    <p class="slide-sub-heading-2"
       style="color: {{ settings.body_text_color }}; {% if block.settings.subheading_color != blank %}
              color:{{ block.settings.subheading_color }};
              {% endif %}">
      {{ block.settings.title_2 }}
    </p>
    {% endif %}

    {% if block.settings.title != blank %}
    <h2 class="slide-heading"
        style="color: {{ settings.body_text_color }}; {% if block.settings.heading_color != blank %}
               color:{{ block.settings.heading_color }};
               {% endif %}">
      {{ block.settings.title }}
    </h2>
    {% endif %}

    {% if block.settings.desc != blank %}
    <div class="slide-text"
         style="color: {{ settings.body_text_color }}; {% if block.settings.desc_color != blank %}
                color:{{ block.settings.desc_color }};
                {% endif %}">
      {{ block.settings.desc }}
    </div>
    {% endif %}

    <div class="multiple-buttons">
      {% if block.settings.button != blank %}
      <a href="{{ block.settings.link }}" class="slide-button dt-sc-btn">{{ block.settings.button }}</a>
      {% endif %}
      {% if block.settings.button_2 != blank %}
      <a href="{{ block.settings.link_2 }}" class="slide-button dt-sc-btn secondary">{{ block.settings.button_2 }}</a>
      {% endif %}
    </div>
  </div>
</div>
{% endif %}

{% if block.settings.slider_type == 'video' and block.settings.video_url != blank %}
<div class="play-btn">
  <a  class="slide-button dt-sc-btn btn play">

