<div id="SearchDrawer" class="dT_ProductProactiveSearch">
  <form action="/search" method="get" role="search">

    {%- comment -%} ── SEARCH SCOPE EXPANSION ──
      type=product        — searches products only (most relevant for anime merch store)
      options[prefix]=last — enables partial word matching so "hoodie" finds "hoodies"
      options[unavailable_products]=last — pushes out of stock to end, not hidden
    {%- endcomment -%}
    <input type="hidden" name="type" value="product">
    <input type="hidden" name="options[prefix]" value="last">
    <input type="hidden" name="options[unavailable_products]" value="last">

    <input
      type="search"
      id="SearchInput"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'general.search.placeholder' | t }}"
      aria-label="{{ 'general.search.placeholder' | t }}"
      class="search-bar__input"
      autocomplete="off"
      v-model="search"
      @keyup="inputChanged"
      @keydown.down="onArrow"
      @keydown.up="onArrow">

    <button type="submit" class="dt-sc-btn">{% render 'icon-search' %}</button>

  </form>

  <div class="dT_PredictiveSearchResult_Section" id="dT_PredictiveResults" style="display:none;">
    <div id="dT_PredictiveInner"></div>
  </div>
</div>

<script>
(function() {
  var input = document.getElementById('SearchInput');
  var resultsBox = document.getElementById('dT_PredictiveResults');
  var resultsInner = document.getElementById('dT_PredictiveInner');
  var debounceTimer;

  if (!input) return;

  input.addEventListener('input', function() {
    var query = input.value.trim();
    clearTimeout(debounceTimer);

    if (query.length < 2) {
      resultsBox.style.display = 'none';
      resultsInner.innerHTML = '';
      return;
    }

    debounceTimer = setTimeout(function() {
      fetchPredictive(query);
    }, 250);
  });

  input.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      resultsBox.style.display = 'none';
      resultsInner.innerHTML = '';
    }
  });

  document.addEventListener('click', function(e) {
    if (!e.target.closest('#SearchDrawer')) {
      resultsBox.style.display = 'none';
    }
  });

  function fetchPredictive(query) {
    var url = '/search/suggest.json'
      + '?q=' + encodeURIComponent(query)
      + '&resources[type]=product'
      + '&resources[limit]=10'
      + '&resources[options][fields]=title,product_type,variants.title,variants.sku,tag,body'
      + '&resources[options][prefix]=last'
      + '&resources[options][unavailable_products]=last';

    fetch(url)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var products = data.resources && data.resources.results && data.resources.results.products
          ? data.resources.results.products
          : [];
        renderResults(products, query);
      })
      .catch(function() {
        resultsBox.style.display = 'none';
      });
  }

  function renderResults(products, query) {
    if (products.length === 0) {
      resultsInner.innerHTML = '<p style="padding:12px 16px; color:#888; font-size:14px;">No products found for &ldquo;' + escHtml(query) + '&rdquo;</p>';
      resultsBox.style.display = 'block';
      return;
    }

    var html = '<ul style="list-style:none; margin:0; padding:0;">';
    products.forEach(function(p) {
      var img = p.featured_image && p.featured_image.url
        ? '<img src="' + p.featured_image.url + '&width=80" alt="' + escHtml(p.title) + '" width="60" height="60" style="object-fit:cover; border-radius:6px; flex-shrink:0;">'
        : '<div style="width:60px; height:60px; background:#f0f0f0; border-radius:6px; flex-shrink:0;"></div>';

      var price = p.price
        ? '<span style="font-size:13px; color:#31378F; font-weight:700;">$' + (parseInt(p.price) / 100).toFixed(2) + '</span>'
        : '';

      html += '<li>'
        + '<a href="' + p.url + '" style="display:flex; align-items:center; gap:12px; padding:10px 16px; text-decoration:none; color:inherit; border-bottom:1px solid #f0f0f0;"'
        + ' onmouseover="this.style.background=\'#f8f8f8\'" onmouseout="this.style.background=\'transparent\'">'
        + img
        + '<div style="flex:1; min-width:0;">'
        + '<div style="font-size:14px; font-weight:600; color:#1a1a1a; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">' + escHtml(p.title) + '</div>'
        + (p.product_type ? '<div style="font-size:12px; color:#888; margin-top:2px;">' + escHtml(p.product_type) + '</div>' : '')
        + price
        + '</div>'
        + '</a>'
        + '</li>';
    });

    html += '</ul>'
      + '<div style="padding:10px 16px; border-top:1px solid #f0f0f0;">'
      + '<a href="/search?q=' + encodeURIComponent(query) + '&type=product&options[prefix]=last" '
      + 'style="font-size:13px; color:#31378F; font-weight:600; text-decoration:none;">'
      + 'See all results for &ldquo;' + escHtml(query) + '&rdquo; &rarr;'
      + '</a>'
      + '</div>';

    resultsInner.innerHTML = html;
    resultsBox.style.display = 'block';
  }

  function escHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }
})();
</script>

<style>
  .dT_ProductProactiveSearch { position: relative; }
  #dT_PredictiveResults {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    z-index: 9999;
    max-height: 480px;
    overflow-y: auto;
    margin-top: 4px;
  }
  #dT_PredictiveResults::-webkit-scrollbar { width: 4px; }
  #dT_PredictiveResults::-webkit-scrollbar-track { background: #f8f8f8; }
  #dT_PredictiveResults::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }
</style>